# provider -> interactive launch argv prefix. A thin BUILT-INS view of the
# registry kept for readers/tests; live lookups (which must also see
# custom providers) go through provider_spec().
PROVIDERS: dict[str, list[str]] = {
    name: list(spec["argv"]) for name, spec in PROVIDER_SPECS.items()
}

# names a [providers.custom.*] block may never claim: the built-ins, plus
# words with fixed meanings in teamctl's own surfaces
_RESERVED_PROVIDER_NAMES = frozenset(PROVIDER_SPECS) | {"all", "probes",
                                                        "states", "custom"}

_warned_custom_blocks: set[str] = set()


def _warn_custom_once(name: str, why: str) -> None:
    """One stderr line per (block, reason) per process — a malformed custom
    block must be loud but must never spam or take down built-ins."""
    key = f"{name}: {why}"
    if key in _warned_custom_blocks:
        return
    _warned_custom_blocks.add(key)
    print(f"teamctl: ignoring [providers.custom.{name}]: {why}",
          file=sys.stderr)


def _str_list(v) -> list[str] | None:
    if isinstance(v, list) and all(isinstance(x, str) for x in v):
        return list(v)
    return None


def custom_provider_specs() -> dict[str, dict]:
    """User-defined providers from [providers.custom.*] blocks, validated
    into the same spec schema the built-ins use. Invalid blocks are skipped
    with one honest stderr warning; built-ins are never affected."""
    raw = (load_config().get("providers") or {}).get("custom")
    if not isinstance(raw, dict):
        return {}
    specs: dict[str, dict] = {}
    for name, block in raw.items():
        if not isinstance(block, dict):
            _warn_custom_once(str(name), "not a table")
            continue
        if name in _RESERVED_PROVIDER_NAMES:
            _warn_custom_once(name, "the name shadows a built-in provider "
                                    "(or a reserved word) — pick another")
            continue
        if not _role_ok(name) or "." in name:
            _warn_custom_once(name, "provider names use letters, digits, "
                                    "'_', '-' (start alphanumeric, no dots)")
            continue
        command = block.get("command")
        if not isinstance(command, str) or not command.strip():
            _warn_custom_once(name, "`command` (the CLI to run) is required")
            continue
        command = command.strip()

        headless_args = _str_list(block.get("headless_args", []))
        interactive_args = _str_list(block.get("interactive_args", []))
        resume_args = _str_list(block.get("resume_args", []))
        model_args = _str_list(block.get("model_args", []))
        effort_args = _str_list(block.get("effort_args", []))
        auth_files = _str_list(block.get("auth_files", []))
        if None in (headless_args, interactive_args, resume_args,
                    model_args, effort_args, auth_files):
            _warn_custom_once(name, "*_args and auth_files must be lists "
                                    "of strings")
            continue
        if headless_args and not any("{task}" in t for t in headless_args):
            _warn_custom_once(name, "headless_args must carry a {task} "
                                    "placeholder")
            continue
        if model_args and not any("{model}" in t for t in model_args):
            _warn_custom_once(name, "model_args must carry a {model} "
                                    "placeholder")
            continue
        if effort_args and not any("{effort}" in t for t in effort_args):
            _warn_custom_once(name, "effort_args must carry an {effort} "
                                    "placeholder")
            continue

        # exact-session follow-ups need BOTH a resume shape and a session
        # source; anything less degrades to "no follow-ups", stated once
        sid_key = str(block.get("session_id_key") or "")
        sid_regex = str(block.get("session_id_regex") or "")
        session_source = None
        if sid_key:
            session_source = {"type": "result-json", "key": sid_key}
        elif sid_regex:
            try:
                re.compile(sid_regex)
            except re.error as exc:
                _warn_custom_once(name, f"session_id_regex does not "
                                        f"compile ({exc}) — follow-ups "
                                        "disabled")
                sid_regex = ""
            if sid_regex:
                # a custom text-only CLI may print its id to stdout OR
                # stderr — scan both artifacts (stderr first)
                session_source = {"type": "stderr-regex",
                                  "pattern": sid_regex,
                                  "artifacts": ["error.log",
                                                "result.json"]}
        resume = None
        if resume_args:
            if not any("{session_id}" in t for t in resume_args):
                _warn_custom_once(name, "resume_args must carry a "
                                        "{session_id} placeholder — "
                                        "follow-ups disabled")
            elif session_source is None:
                _warn_custom_once(name, "resume_args set but no "
                                        "session_id_key/session_id_regex — "
                                        "follow-ups disabled")
            else:
                resume = [command] + resume_args

        patterns = _str_list(block.get("waiting_patterns", []))
        if patterns is None:
            _warn_custom_once(name, "waiting_patterns must be a list of "
                                    "strings")
            continue
        good_patterns = []
        for pat in patterns:
            try:
                re.compile(pat)
                good_patterns.append(pat)
            except re.error as exc:
                _warn_custom_once(name, f"waiting_pattern {pat!r} does not "
                                        f"compile ({exc}) — dropped")

        probe_command = str(block.get("probe_command") or "")
        routable = block.get("routable", True)
        if not isinstance(routable, bool):
            routable = str(routable).strip().lower() not in ("false", "0",
                                                             "no", "off")
        specs[name] = {
            "argv": [command] + interactive_args,
            "headless": ([command] + headless_args) if headless_args
            else None,
            "resume": resume,
            "model_args": model_args or None,
            "effort_args": effort_args or None,
            "resume_takes_model": True,
            "session_source": session_source if resume else None,
            "auth_env": str(block.get("auth_env") or "") or None,
            "auth_files": auth_files,
            "login_hint": str(block.get("login_hint") or ""),
            "wake_hint": "",
            "probe": ({"argv": [command], "command": probe_command,
                       "extra_enters": 1} if probe_command else None),
            "waiting_patterns": good_patterns,
            "routable": routable,
            "custom": True,
        }
    return specs


def provider_spec(name: str) -> dict | None:
    """The resolved spec for one provider: built-ins, then custom blocks."""
    if name in PROVIDER_SPECS:
        return PROVIDER_SPECS[name]
    return custom_provider_specs().get(name)


def known_provider_names() -> list[str]:
    """Every spawnable provider name, built-ins first."""
    return list(PROVIDER_SPECS) + sorted(custom_provider_specs())


def routable_providers() -> tuple[str, ...]:
    """Providers that participate in route/usage/providers tables: the
    routable built-ins plus routable custom providers."""
    names = [n for n, s in PROVIDER_SPECS.items() if s.get("routable")]
    names += sorted(n for n, s in custom_provider_specs().items()
                    if s.get("routable"))
    return tuple(names)


def provider_installed(name: str) -> bool:
    """Is the provider's actual CLI binary on PATH? (A custom provider's
    name and its `command` can differ — the command is what must exist.)"""
    spec = provider_spec(name)
    if not spec:
        return False
    return shutil.which(spec["argv"][0]) is not None


def wake_hint(provider: str) -> str:
    """How a quiet provider produces its first usage numbers."""
    return (provider_spec(provider) or {}).get("wake_hint") or "use it once"


def login_hint(provider: str) -> str:
    """The provider CLI's own sign-in command/flow."""
    return ((provider_spec(provider) or {}).get("login_hint")
            or f"{provider} login")


def provider_supports_effort(name: str) -> bool:
    return bool((provider_spec(name) or {}).get("effort_args"))


class TeamctlError(Exception):
    """A user-facing failure; main() renders it to stderr with a clean exit."""


def state_path() -> Path:
    override = os.environ.get("TEAMCTL_STATE")
    if override:
        return Path(override)
    return Path.home() / ".local" / "state" / "agent-team" / "state.json"


def handoff_dir(role: str) -> Path:
    """Per-teammate folder holding task.md, result.json, status, error.log, pid."""
    return state_path().parent / role


# Role names become filesystem paths (the handoff dir) and are embedded in
# the dispatch wrapper's shell script and pane titles — so they are locked
# to a safe shape at every creation point. Rejects path traversal ("../x"),
# shell metacharacters, and anything starting with "." or "-".
ROLE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def _role_ok(role: str) -> bool:
    return bool(ROLE_RE.fullmatch(role)) and ".." not in role


def _reject_bad_role(role: str) -> bool:
    """True (and an explanation on stderr) when a role name is unusable."""
    if _role_ok(role):
        return False
    print("teamctl: role names must start with a letter or digit and use "
          "only letters, digits, '.', '_', '-' (max 64 chars, no '..') — "
          f"got {role!r}.", file=sys.stderr)
    return True


# --------------------------------------------------------------------------
# signed-in detection — reading each CLI's own login artifacts (teamctl
# never touches credentials). Every artifact below was VERIFIED against a
# live signed-in install of all three CLIs (macOS, 2026-07) and the
# signed-out shape was verified against sandboxed empty homes. Probes are
# file reads first (fast, no subprocess), never interactive, and degrade
# to "unknown" instead of guessing when an artifact exists but is
# unreadable.
#
#   claude  ~/.claude/.credentials.json {"claudeAiOauth": {...}} (file
#           storage), or ~/.claude.json "oauthAccount" (account metadata,
#           written on login whatever the credential store), or the macOS
#           Keychain item "Claude Code-credentials" (attribute lookup only
#           — never the secret, which could prompt). Cross-checked against
#           `claude auth status` ({"loggedIn": true|false}).
#   codex   ~/.codex/auth.json with a non-empty "tokens" dict or
#           "OPENAI_API_KEY"; `codex logout` removes the credentials.
#           Cross-checked against `codex login status` (rc 0 / 1).
#   grok    ~/.grok/auth.json holding at least one credential entry
#           (issuer-keyed dicts with refresh_token/key were observed).
#   gemini  ~/.gemini/oauth_creds.json (OAuth token cache — official auth
#           docs); the login flow is in-TUI (/auth), there is no
#           standalone login subcommand.
#
# An exported provider API key (each spec's auth_env/auth_env_extra) also
# counts as signed in: the CLI works with it even when no login artifact
# exists. Custom providers with neither auth_env nor auth_files configured
# are 'unprobed' — teamctl states that it cannot know, instead of guessing
# either way.
# --------------------------------------------------------------------------

_CORRUPT = object()  # a JSON artifact that exists but cannot be read/parsed

# Signs of real grok CLI use, for the last-resort auth fallback. Bare
# ~/.grok existence is NOT a login signal any more: `teamctl lead on`
# creates that directory (AGENTS.md) on machines that never logged in.
GROK_DIR_MARKERS = ("sessions", "config.toml", "agent_id",
                    "active_sessions.json")

GROK_INFERRED_NOTE = ("inferred from ~/.grok CLI data; no auth.json — "
                      "observed heuristic, verify with `grok models`")


def _read_json_artifact(path: Path):
    """None when missing, _CORRUPT when unreadable/unparseable, else data."""
    try:
        if not path.exists():
            return None
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return _CORRUPT


def _keychain_signed_in() -> bool:
    """macOS: does the login keychain hold Claude Code's credentials item?
    Attribute lookup only (`-w` could prompt for the secret; this never
    does), short timeout, and any failure means 'no signal' — never
    'signed out'. TEAMCTL_NO_KEYCHAIN=1 disables it (sandboxed tests)."""
    if os.environ.get("TEAMCTL_NO_KEYCHAIN") == "1":
        return False
    if sys.platform != "darwin" or shutil.which("security") is None:
        return False
    try:
        res = subprocess.run(
            ["security", "find-generic-password",
             "-s", "Claude Code-credentials"],
            capture_output=True, timeout=3)
        return res.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _grok_auth_fallback(auth_path: Path) -> bool:
    """auth.json is the observed login artifact; if a grok CLI update moves
    it, fall back (last resort) to signs of real CLI use in the same dir —
    never to bare directory existence."""
    d = auth_path.parent
    try:
        return d.is_dir() and any((d / m).exists() for m in GROK_DIR_MARKERS)
    except OSError:
        return False


def provider_auth_state(provider: str) -> tuple[str, str]:
    """('signed-in' | 'signed-out' | 'unknown' | 'unprobed', note).

    'unknown' means an auth artifact exists but could not be read — the
    honest answer, reported instead of guessing either way. 'unprobed'
    means teamctl has nothing to consult (a custom provider with no
    auth_env/auth_files configured) — stated, never guessed."""
    home = Path.home()
    spec = provider_spec(provider) or {}
    env_keys = [k for k in [spec.get("auth_env"),
                            *(spec.get("auth_env_extra") or [])] if k]
    if any(os.environ.get(k, "") for k in env_keys):
        return "signed-in", "via exported API key"

    if provider == "claude":
        cred = _read_json_artifact(home / ".claude" / ".credentials.json")
        if isinstance(cred, dict) and cred.get("claudeAiOauth"):
            return "signed-in", ""
        cj = _read_json_artifact(home / ".claude.json")
        if isinstance(cj, dict) and cj.get("oauthAccount"):
            return "signed-in", ""
        if _keychain_signed_in():
            return "signed-in", ""
        if cred is _CORRUPT or cj is _CORRUPT:
            return "unknown", "auth artifacts exist but are unreadable"
        return "signed-out", ""

    if provider == "codex":
        auth = _read_json_artifact(home / ".codex" / "auth.json")
        if isinstance(auth, dict) and (auth.get("tokens")
                                       or auth.get("OPENAI_API_KEY")):
            return "signed-in", ""
        if auth is _CORRUPT:
            return "unknown", "auth artifacts exist but are unreadable"
        return "signed-out", ""  # missing, or logged out (credentials cleared)

    if provider == "grok":
        auth_path = home / ".grok" / "auth.json"
        auth = _read_json_artifact(auth_path)
        if isinstance(auth, dict) and any(bool(v) for v in auth.values()):
            return "signed-in", ""
        if _grok_auth_fallback(auth_path):
            return "signed-in", GROK_INFERRED_NOTE
        if auth is _CORRUPT:
            return "unknown", "auth artifacts exist but are unreadable"
        return "signed-out", ""

    # generic artifact probe (gemini and custom providers) — the same
    # discipline as the built-in branches above: a parseable, non-empty
    # JSON artifact means signed in; exists-but-unreadable means 'unknown';
    # nothing found means signed out. A provider that gave teamctl nothing
    # to consult is 'unprobed' — the honest non-answer.
    files = [Path(os.path.expanduser(p))
             for p in (spec.get("auth_files") or [])]
    if not files:
        # for a CUSTOM provider an env key is a POSITIVE-only signal: its
        # absence proves nothing (the CLI may hold its own login — a
        # keyring, its own token store). Only auth_files can prove
        # signed-out. Stated, never guessed.
        if env_keys and spec.get("custom"):
            return "unprobed", (f"auth not probed ({env_keys[0]} not set; "
                                "the CLI may hold its own login — set "
                                "auth_files to enable detection)")
        if env_keys:
            return "signed-out", ""   # built-in with env-only detection
        note = "auth not probed"
        if spec.get("custom"):
            note += (" (custom provider — set auth_files/auth_env to "
                     "enable detection)")
        return "unprobed", note
    corrupt = False
    for f in files:
        data = _read_json_artifact(f)
        if isinstance(data, dict) and any(bool(v) for v in data.values()):
            return "signed-in", ""
        if data is _CORRUPT:
            corrupt = True
    if corrupt:
        return "unknown", "auth artifacts exist but are unreadable"
    return "signed-out", ""


def provider_authed(provider: str) -> bool:
    """Usable-for-work: signed in, or explicitly configured with nothing
    to probe (an 'unprobed' custom provider is routable by the user's own
    choice — refusing would break the escape hatch)."""
    return provider_auth_state(provider)[0] in ("signed-in", "unprobed")


def config_path() -> Path:
    return Path.home() / ".config" / "agent-team" / "config.toml"


def load_config() -> dict:
    """Preferences written by `teamctl init`; everything works without them."""
    path = config_path()
    if not path.exists() or tomllib is None:
        return {}
    try:
        return tomllib.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def provider_defaults(provider: str) -> tuple[str | None, str | None]:
    prov = (load_config().get("providers") or {}).get(provider) or {}
    return prov.get("model"), prov.get("effort")


def available_providers() -> list[str]:
    """Installed AND logged-in routable providers, in registry order."""
    return [p for p in routable_providers()
            if provider_installed(p) and provider_authed(p)]


def default_provider() -> str | None:
    """Provider used when --provider is omitted. teamctl has no opinion of
    its own: the first entry of the user's [routing] preference wins; with
    no preference configured, the single available provider is used; with
    several (or none), there is NO default — the caller must ask the user."""
    pref = (load_config().get("routing") or {}).get("preference")
    if isinstance(pref, list) and pref:
        return str(pref[0])
    avail = available_providers()
    if len(avail) == 1:
        return avail[0]
    return None


def _provider_or_fail(requested: str) -> str | None:
    """--provider value -> provider, or None after printing why (exit 2).
    Never silently picks among several providers: that choice is the user's."""
    if requested:
        if provider_spec(requested) is None:
            print(f"teamctl: unknown provider '{requested}' (known: "
                  f"{', '.join(known_provider_names())}).", file=sys.stderr)
            return None
        return requested
    prov = default_provider()
    if prov is not None:
        if provider_spec(prov) is None:
            print(f"teamctl: routing.preference starts with unknown provider "
                  f"'{prov}' — fix it with `teamctl config routing.preference "
                  "...`.", file=sys.stderr)
            return None
        return prov
    avail = available_providers()
    print("teamctl: no --provider given and no default is configured "
          f"(detected: {', '.join(avail) if avail else 'none'}). "
          "Pass --provider, or set your order once with: "
          'teamctl config routing.preference "<first>,<second>,..."',
          file=sys.stderr)
    return None


def _expand_tokens(tokens: list[str], task: str = "", model: str = "",
                   effort: str = "", session_id: str = "") -> list[str]:
    """Substitute {task}/{model}/{effort}/{session_id} INSIDE argv tokens.
    Values only ever land in argv slots (shlex-quoted wholesale wherever a
    shell line is built) — no shell interpolation can ever see them."""
    vals = {"{task}": task, "{model}": model, "{effort}": effort,
            "{session_id}": session_id}
    out: list[str] = []
    for tok in tokens:
        for ph, val in vals.items():
            if ph in tok:
                tok = tok.replace(ph, val)
        out.append(tok)
    return out


def _model_effort_args(spec: dict, provider: str, model: str,
                       effort: str) -> list[str]:
    """The optional model/effort flags for one launch. An effort requested
    from a provider with no effort control is DROPPED with a one-line
    stderr note — never silently, never guessed into some other flag."""
    a: list[str] = []
    if model and spec.get("model_args"):
        a += _expand_tokens(spec["model_args"], model=model)
    if effort:
        if spec.get("effort_args"):
            a += _expand_tokens(spec["effort_args"], effort=effort)
        elif not spec.get("quiet_flags"):
            print(f"teamctl: note: {provider} has no effort flag — "
                  "--effort ignored", file=sys.stderr)
    return a


def headless_argv(provider: str, task: str, model: str, effort: str) -> list[str]:
    """Headless (non-interactive) launch argv, expanded from the spec."""
    spec = provider_spec(provider)
    if spec is None or not spec.get("headless"):
        raise TeamctlError(f"no headless adapter for provider '{provider}'")
    return (_expand_tokens(spec["headless"], task=task)
            + _model_effort_args(spec, provider, model, effort))


def resume_argv(provider: str, task: str, model: str, effort: str,
                session_id: str) -> list[str]:
    """Continue a SPECIFIC provider session. Exact-session only — resuming
    'the most recent session' is banned (wrong session under concurrency).
    Flags verified against each CLI's own help: claude `--resume <id>`,
    grok `-r <id>`, codex `exec resume <SESSION_ID> <prompt>`, gemini
    `--resume <uuid>` (UUID form only). Model flags ride along when the
    spec says so (codex's resume takes none); effort is never re-sent on
    a resume."""
    spec = provider_spec(provider)
    if spec is None or not spec.get("resume"):
        raise TeamctlError(f"no resume adapter for provider '{provider}'")
    a = _expand_tokens(spec["resume"], task=task, session_id=session_id)
    if model and spec.get("resume_takes_model") and spec.get("model_args"):
        a += _expand_tokens(spec["model_args"], model=model)
    return a


def classify_output(text: str) -> str:
    """Recognize credit-exhaustion / auth failures in provider output.
    Never provider-keyed, so custom providers get the signals for free.
    "resource_exhausted" is the Gemini API's quota error status; "set an
    auth method" is gemini's headless not-signed-in message (verified live
    against 0.46.0)."""
    low = text.lower()
    if any(s in low for s in ("usage limit", "rate limit", "quota", "out of credits",
                              "insufficient credit", "resource_exhausted")):
        return "exhausted"
    if any(s in low for s in ("unauthorized", "not logged in", "authentication",
                              "please log in", "invalid api key",
                              "set an auth method")):
        return "auth-error"
    return "ok"


def load_state() -> dict:
    p = state_path()
    if not p.exists():
        return {"teammates": {}}
    try:
        data = json.loads(p.read_text())
    except (json.JSONDecodeError, OSError):
        return {"teammates": {}}
    data.setdefault("teammates", {})
    return data


def save_state(state: dict) -> None:
    p = state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    tmp.replace(p)


@contextmanager
def state_lock():
    """Serialize read-modify-write of the state file across processes."""
    p = state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    lock = p.with_suffix(".lock")
    with open(lock, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def tmux(*args: str, check: bool = True, capture: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["tmux", *args],
            check=check,
            capture_output=capture,
            text=True,
        )
    except FileNotFoundError as exc:  # tmux not installed
        raise TeamctlError(
            "tmux not found on PATH; install tmux or start inside a tmux session."
        ) from exc


def in_tmux() -> bool:
    return bool(os.environ.get("TMUX"))


def live_pane_ids() -> set[str]:
    try:
        out = tmux("list-panes", "-a", "-F", "#{pane_id}").stdout
    except subprocess.CalledProcessError:
        return set()
    return {line.strip() for line in out.splitlines() if line.strip()}


# the newest N crash/reboot-lost teammates kept for `teamctl resurrect`
LOST_CAP = 20


def reconcile(state: dict) -> dict:
    """Keep tracked teammates honest against the live tmux panes.

    Interactive (spawn-mode) teammates ARE their pane: pane gone means the
    teammate is gone, so it is dropped.

    Dispatch-mode teammates are different: their pane runs a wrapper that
    legitimately exits (closing the pane) when the task finishes, while the
    completed result/session live on in the handoff dir. A dispatch teammate
    whose pane is gone is therefore FINISHED (or died mid-task), not
    vanished — it stays tracked, with its stale pane id cleared, until an
    explicit `teamctl shutdown <role>` removes it. `result` and `followup`
    keep working from the handoff artifacts indefinitely.

    An interactive teammate whose pane vanished WITHOUT `teamctl shutdown`
    (crash, reboot, user-closed pane — explicit shutdown deletes directly
    and never passes through this path) is moved to state["lost"] instead
    of being silently forgotten: `teamctl resurrect` rebuilds the roster
    from those records (capped at the newest LOST_CAP entries)."""
    live = live_pane_ids()
    survivors: dict[str, dict] = {}
    lost: dict[str, dict] = dict(state.get("lost") or {})
    changed = False
    for role, info in state["teammates"].items():
        pane = info.get("pane_id")
        if pane and pane in live:
            survivors[role] = info
            continue
        if info.get("mode") == "dispatch":
            if pane:
                info = dict(info)
                info["pane_id"] = ""
                changed = True
            survivors[role] = info
            continue
        changed = True  # interactive teammate without a pane: LOST
        lost[role] = {**info,
                      "lost_at": time.strftime("%Y-%m-%dT%H:%M:%S")}
    while len(lost) > LOST_CAP:
        oldest = min(lost, key=lambda r: lost[r].get("lost_at", ""))
        del lost[oldest]
    if changed:
        state["teammates"] = survivors
        if lost:
            state["lost"] = lost
        save_state(state)
    return state


def _mate_state(role: str, info: dict, live: set[str]) -> str:
    """Human-readable lifecycle state for `list`.

    interactive: active (a dead one is dropped by reconcile).
    dispatch:    running / done / failed(rc) / died — derived from the pane
                 and the handoff status file, never stored, so it is always
                 current."""
    if info.get("mode") != "dispatch":
        return "active"
    hd = Path(info.get("handoff") or handoff_dir(role))
    status, rc = _read_status(hd)
    if status == "running":
        if info.get("pane_id") in live or _teammate_alive(info, hd):
            return "running"
        return "died"
    if rc == 0:
        return "done"
    return f"failed({rc if rc is not None else '?'})"


def interactive_flags(provider: str, model: str, effort: str) -> list[str]:
    """Model/effort flags for an interactive launch."""
    spec = provider_spec(provider)
    if spec is None:
        return []
    return _model_effort_args(spec, provider, model, effort)


def build_launch_line(provider: str, prompt: str, cwd: str,
                      model: str = "", effort: str = "") -> str:
    """The shell command a teammate pane runs. All values are shell-quoted."""
    spec = provider_spec(provider)
    if spec is None:
        raise TeamctlError(f"unknown provider '{provider}'")
    launch = list(spec["argv"]) + interactive_flags(provider, model, effort)
    if prompt:
        launch.append(prompt)
    return f"cd {shlex.quote(cwd)} && exec {' '.join(shlex.quote(a) for a in launch)}"


def _pane_size(pane_id: str) -> tuple[int, int]:
    try:
        out = tmux("display-message", "-p", "-t", pane_id,
                   "#{pane_width} #{pane_height}").stdout.split()
        return int(out[0]), int(out[1])
    except (subprocess.CalledProcessError, ValueError, IndexError):
        return 0, 0


def _window_panes(lead: str) -> list[str]:
    """All pane ids in the window containing `lead`."""
    try:
        out = tmux("list-panes", "-t", lead, "-F", "#{pane_id}").stdout
    except subprocess.CalledProcessError:
        return []
    return [line.strip() for line in out.splitlines() if line.strip()]


def _split_candidates(lead: str | None, existing: list[str]) -> list[str]:
    """Panes a new teammate may split: every pane in the lead's window except
    the lead itself — so teammates fold into the right-hand grid even when
    non-teamctl panes (e.g. native agent panes) already occupy it, instead of
    carving slivers off the lead. Falls back to the tracked-teammate list,
    then (empty) to splitting the lead."""
    if lead:
        panes = [p for p in _window_panes(lead) if p != lead]
        if panes:
            return panes
    live = live_pane_ids()
    return [p for p in existing if p in live]


def keep_finished_panes() -> bool:
    """[layout] keep_finished (default true): a finished dispatch teammate's
    pane stays open — visibly done — until `teamctl shutdown <role>`. Set
    false for the old ephemeral behavior (pane self-closes ~2s after the
    task completes; the teammate stays tracked either way)."""
    raw = (load_config().get("layout") or {}).get("keep_finished", True)
    if isinstance(raw, bool):
        return raw
    return str(raw).strip().lower() not in ("false", "0", "no", "off")


def lead_width_percent() -> int:
    """Configured lead-pane width share ([layout] lead_width, % of the
    window), clamped to 20–80. Default 50."""
    raw = (load_config().get("layout") or {}).get("lead_width", 50)
    try:
        pct = int(raw)
    except (TypeError, ValueError):
        pct = 50
    return max(20, min(80, pct))


def _enforce_lead_width() -> None:
    """Re-assert the lead pane's width after layout changes: every spawn and
    shutdown re-tiles the window, and without this the lead pane gradually
    loses (or hoards) columns."""
    lead = os.environ.get("TMUX_PANE")
    if not lead:
        return
    tmux("resize-pane", "-t", lead, "-x", f"{lead_width_percent()}%",
         check=False)


def _open_pane(cmd: str, existing: list[str]) -> str:
    """Open a teammate as a PANE in the lead's window, keeping the lead on the
    left and teammates in a grid of squares to its right.

    The first teammate splits the lead pane horizontally (taking the right
    half). Each later teammate splits the largest other pane in the window
    (teamctl-tracked or not, so foreign panes fold into the same grid),
    choosing the split direction that keeps panes square-looking (a terminal
    cell is ~2x taller than wide, so a pane reads as square when width is
    about twice its height). Four teammates thus form a 2x2 grid beside the
    lead; the lead pane itself is never re-split after the first, and its
    width is re-pinned to the configured [layout] lead_width share."""
    lead = os.environ.get("TMUX_PANE")
    candidates = _split_candidates(lead, existing)

    if not candidates:
        target, flag = lead, "-h"
    else:
        target, best_area, w, h = None, -1, 0, 0
        for p in candidates:
            pw, ph = _pane_size(p)
            if pw * ph > best_area:
                target, best_area, w, h = p, pw * ph, pw, ph
        if target is None:
            target = lead
            flag = "-h"
        else:
            flag = "-h" if w >= 2 * h else "-v"

    # -d: never move focus to the new pane — spawning a teammate must not
    # steal the user's cursor from whatever pane they are working in.
    argv = ["split-window", flag, "-d", "-P", "-F", "#{pane_id}"]
    if target:
        argv += ["-t", target]
    argv.append(cmd)
    pane_id = tmux(*argv).stdout.strip()
    # pin the lead's width back to its configured share of the window
    _enforce_lead_width()
    return pane_id


def _set_pane_title(pane_id: str, role: str, model: str = "") -> None:
    """Tag a teammate pane with its role/model so tmux can show a sticky
    per-pane label. Uses per-pane user options @role/@model (which the
    provider CLI can't clobber, unlike the pane title) — the tmux
    pane-border-format / status bar read these. Also sets the title for the
    benefit of other tools. Not rendered via #() shell commands, which some
    tmux builds do not execute in status formats."""
    title = f"{role} · {model}" if model else role
    for opt, val in (("@role", role), ("@model", model)):
        try:
            tmux("set-option", "-p", "-t", pane_id, opt, val, check=False)
        except subprocess.CalledProcessError:
            pass
    try:
        tmux("select-pane", "-t", pane_id, "-T", title)
    except subprocess.CalledProcessError:
        pass  # pane titles are cosmetic


def cmd_spawn(args: argparse.Namespace) -> int:
    if _reject_bad_role(args.role):
        return 2
    provider = _provider_or_fail(args.provider)
    if provider is None:
        return 2
    args.provider = provider

    cwd = os.path.abspath(os.path.expanduser(args.cwd)) if args.cwd else os.getcwd()
    d_model, d_effort = provider_defaults(args.provider)
    model = args.model or d_model or ""
    effort = args.effort or d_effort or ""
    inner = build_launch_line(args.provider, args.prompt, cwd, model, effort)

    # dry-run is a pure preview: no tmux and no state needed.
    if args.dry_run:
        print(inner)
        return 0

    if not in_tmux():
        print("teamctl: not inside a tmux session; start one first.", file=sys.stderr)
        return 2

    with state_lock():
        state = reconcile(load_state())
        if args.role in state["teammates"]:
            print(
                f"teamctl: teammate '{args.role}' already exists "
                f"(pane {state['teammates'][args.role]['pane_id']}). "
                "Refusing to run two on the same role.",
                file=sys.stderr,
            )
            return 1

        try:
            wt = _maybe_alloc_worktree(args.role, cwd,
                                       getattr(args, "worktree", None))
        except TeamctlError as exc:
            print(f"teamctl: {exc}", file=sys.stderr)
            return 2
        if wt:
            cwd = wt["path"]
            inner = build_launch_line(args.provider, args.prompt, cwd,
                                      model, effort)

        existing = [i.get("pane_id", "") for i in state["teammates"].values()]
        pane_id = _open_pane(inner, existing)
        _set_pane_title(pane_id, args.role, model)

        state["teammates"][args.role] = {
            "provider": args.provider,
            "pane_id": pane_id,
            "cwd": cwd,
            "model": model,
            "effort": effort,
            "prompt": args.prompt or "",
            "mode": "interactive",
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
        if wt:
            state["teammates"][args.role]["worktree"] = wt
        save_state(state)

    print(f"spawned teammate '{args.role}' ({args.provider}"
          f"{'/' + model if model else ''}) in pane {pane_id}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
    mates = state["teammates"]
    live = live_pane_ids()
    if args.json:
        annotated = {role: {**info, "state": _mate_state(role, info, live)}
                     for role, info in mates.items()}
        print(json.dumps(annotated, indent=2, sort_keys=True))
        return 0
    lost = state.get("lost") or {}
    if not mates:
        print("no active teammates")
        if lost:
            print(f"{len(lost)} teammate(s) lost in a crash/reboot "
                  f"({', '.join(sorted(lost))}) — rebuild: teamctl "
                  "resurrect")
        return 0
    width = max(len(r) for r in mates)
    print(f"{'ROLE'.ljust(width)}  PROVIDER  PANE     STATE        CREATED")
    for role in sorted(mates):
        i = mates[role]
        st = _mate_state(role, i, live)
        # fast needs-input flag for interactive mates (single capture, no
        # settle wait — `teamctl status` runs the full busy/idle classifier)
        if st == "active" and (i.get("pane_id") or "") in live:
            hit = _match_waiting(_capture_pane(i["pane_id"]),
                                 _waiting_patterns(i.get("provider", "")))
            if hit:
                st = "input?"
        wt = i.get("worktree") or {}
        marker = f"  ⌂ {wt['branch']}" if wt.get("branch") else ""
        print(
            f"{role.ljust(width)}  {i['provider']:<8}  "
            f"{i.get('pane_id') or '-':<7}  {st:<11}  "
            f"{i.get('created_at', '')}{marker}"
        )
    if lost:
        print(f"\n{len(lost)} teammate(s) lost in a crash/reboot "
              f"({', '.join(sorted(lost))}) — rebuild: teamctl resurrect")
    return 0


# --------------------------------------------------------------------------
# teammate status detection — busy / needs-input / idle, on demand (no
# daemon). Two capture-pane samples ~0.7s apart: changing content = busy;
# stable content matching the provider's waiting_patterns (OBSERVED-ONLY
# TUI approval-dialog text — defensive parsing, same posture as the usage
# probes) = needs-input; anything else = idle. An unrecognized TUI
# degrades to idle — never a wrong strong claim.
# --------------------------------------------------------------------------

def _waiting_patterns(provider: str) -> list[str]:
    return list((provider_spec(provider) or {}).get("waiting_patterns")
                or [])


def _match_waiting(text: str, patterns: list[str]) -> str | None:
    """The first waiting-shape LINE in the tail of pane text; None when
    nothing matches (or a pattern is broken — skipped, never fatal)."""
    tail = [ln for ln in text.rstrip().splitlines()[-15:] if ln.strip()]
    for pat in patterns:
        for ln in tail:
            try:
                if re.search(pat, ln):
                    return ln.strip()
            except re.error:
                break
    return None


def _pane_activity(pane_id: str, provider: str,
                   settle: float = 0.7) -> tuple[str, str]:
    """(state, detail) for a live interactive pane."""
    first = _capture_pane(pane_id)
    time.sleep(settle)
    second = _capture_pane(pane_id)
    if first != second:
        return "busy", ""
    hit = _match_waiting(second, _waiting_patterns(provider))
    if hit:
        return "needs-input", hit[:80]
    return "idle", ""


def _classify_mate(role: str, info: dict, live: set[str],
                   settle: float = 0.7) -> tuple[str, str]:
    """(state, detail) for any teammate: dispatch mates keep their derived
    lifecycle states (running/done/failed/died); interactive mates get the
    pane classifier."""
    if info.get("mode") == "dispatch":
        return _mate_state(role, info, live), ""
    pane = info.get("pane_id") or ""
    if not pane or pane not in live:
        return "gone", ""
    return _pane_activity(pane, info.get("provider", ""), settle)


def _status_cache_path() -> Path:
    return state_path().parent / "status-cache.json"


def _load_status_cache() -> dict:
    try:
        p = _status_cache_path()
        data = json.loads(p.read_text()) if p.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def _save_status_cache(cache: dict) -> None:
    try:
        p = _status_cache_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(cache, indent=2, sort_keys=True))
        tmp.replace(p)
    except OSError:
        pass    # the cache only powers transition detection — best effort


def _notify_argv() -> list[str]:
    """[notify] command, split into argv — NEVER interpolated through a
    shell. Context rides environment variables instead."""
    raw = (load_config().get("notify") or {}).get("command", "")
    try:
        return shlex.split(str(raw)) if raw else []
    except ValueError:
        return []


def _fire_notify(role: str, new_state: str, prev_state: str) -> None:
    """Run the notify hook for one observed transition. Context via env:
    TEAMCTL_ROLE, TEAMCTL_MATE_STATE, TEAMCTL_PREV_STATE. (Deliberately
    NOT 'TEAMCTL_STATE' — that env var already means the state-file
    override, and a hook that calls teamctl back must keep working.)
    Best-effort: a broken hook prints one line, never breaks status."""
    argv = _notify_argv()
    if not argv:
        return
    env = dict(os.environ)
    env["TEAMCTL_ROLE"] = role
    env["TEAMCTL_MATE_STATE"] = new_state
    env["TEAMCTL_PREV_STATE"] = prev_state
    try:
        subprocess.run(argv, env=env, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"teamctl: notify hook failed: {exc}", file=sys.stderr)


def _observe_transitions(states: dict[str, str]) -> None:
    """Compare freshly-observed states against the persisted last-known
    ones; fire the notify hook per change. Honest limitation (documented):
    teamctl has no daemon — transitions are observed only when status/
    list/--watch actually looks."""
    cache = _load_status_cache()
    changed = False
    for role, new_state in states.items():
        prev = cache.get(role, "")
        if prev != new_state:
            if prev:                    # a first sighting is not a transition
                _fire_notify(role, new_state, prev)
            cache[role] = new_state
            changed = True
    for role in [r for r in cache if r not in states]:
        del cache[role]
        changed = True
    if changed:
        _save_status_cache(cache)


def cmd_status(args: argparse.Namespace) -> int:
    """One-shot (or --watch) teammate status: busy / needs-input / idle
    for interactive mates, the derived lifecycle for dispatch mates."""
    def observe() -> dict[str, tuple[str, str]]:
        with state_lock():
            state = reconcile(load_state())
        mates = state["teammates"]
        if args.role:
            if args.role not in mates:
                return {}
            mates = {args.role: mates[args.role]}
        live = live_pane_ids()
        return {role: _classify_mate(role, info, live)
                for role, info in sorted(mates.items())}

    if getattr(args, "watch", False):
        interval = max(1.0, float(getattr(args, "interval", 5.0)))
        print(f"watching teammate status every {interval:.0f}s — Ctrl-C "
              "to stop")
        prev: dict[str, str] = {}
        try:
            while True:
                rows = observe()
                states = {r: s for r, (s, _d) in rows.items()}
                for role, (st, detail) in rows.items():
                    if prev.get(role) != st:
                        stamp = time.strftime("%H:%M:%S")
                        extra = f"  ({detail})" if detail else ""
                        was = prev.get(role, "?")
                        print(f"{stamp}  {role}: {was} -> {st}{extra}")
                for role in [r for r in prev if r not in states]:
                    print(f"{time.strftime('%H:%M:%S')}  {role}: gone")
                _observe_transitions(states)
                prev = states
                time.sleep(interval)
        except KeyboardInterrupt:
            print()
            return 0

    rows = observe()
    if args.role and not rows:
        print(f"teamctl: no teammate '{args.role}'.", file=sys.stderr)
        return 1
    _observe_transitions({r: s for r, (s, _d) in rows.items()})
    if args.json:
        with state_lock():
            state = reconcile(load_state())
        out = {}
        for role, (st, detail) in rows.items():
            info = state["teammates"].get(role, {})
            out[role] = {"provider": info.get("provider"),
                         "mode": info.get("mode"),
                         "state": st, "detail": detail or None}
        print(json.dumps(out, indent=2, sort_keys=True))
        return 0
    if not rows:
        print("no active teammates")
        return 0
    width = max(len(r) for r in rows)
    print(f"{'ROLE'.ljust(width)}  STATE        DETAIL")
    for role, (st, detail) in rows.items():
        print(f"{role.ljust(width)}  {st:<11}  {detail}")
    return 0


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _descendants(pid: int) -> list[int]:
    """All descendant PIDs of pid (portable via pgrep -P)."""
    out, stack = [], [pid]
    while stack:
        parent = stack.pop()
        res = subprocess.run(["pgrep", "-P", str(parent)],
                             capture_output=True, text=True)
        for line in res.stdout.split():
            try:
                child = int(line)
            except ValueError:
                continue
            out.append(child)
            stack.append(child)
    return out


def _kill_tree(pid: int) -> bool:
    """TERM then KILL a process and all descendants; True once all are gone."""
    pids = [pid] + _descendants(pid)
    for p in pids:
        try:
            os.kill(p, 15)
        except (ProcessLookupError, PermissionError):
            pass
    for _ in range(10):
        if not any(_pid_alive(p) for p in pids):
            return True
        time.sleep(0.15)
    # escalate — and give the reap time to settle: a just-KILLed process
    # lingers as a zombie (os.kill(pid, 0) still succeeds) until its
    # parent reaps it, which a loaded machine can take seconds to do.
    # Success returns early; only the true-failure path waits this long.
    for p in pids:
        if _pid_alive(p):
            try:
                os.kill(p, 9)
            except (ProcessLookupError, PermissionError):
                pass
    for _ in range(20):
        if not any(_pid_alive(p) for p in pids):
            return True
        time.sleep(0.15)
    return not any(_pid_alive(p) for p in pids)


def _pane_pid(pane_id: str) -> int | None:
    try:
        out = tmux("display-message", "-p", "-t", pane_id, "#{pane_pid}").stdout.strip()
        return int(out) if out else None
    except (subprocess.CalledProcessError, ValueError):
        return None


def _close_pane(pane_id: str) -> bool:
    """Cleanly end a teammate: kill its whole process tree (not just the pane),
    verify the process is gone, then close the pane. Returns True on success.

    Killing a pane alone can orphan a shell-wrapped provider process, so the
    process tree is terminated and death confirmed before the pane closes."""
    if pane_id not in live_pane_ids():
        return True
    # graceful interrupt first, so the CLI can close its provider session
    tmux("send-keys", "-t", pane_id, "C-c", check=False)
    pid = _pane_pid(pane_id)
    for _ in range(6):
        if pane_id not in live_pane_ids():
            break
        time.sleep(0.15)
    # kill the process tree and verify no survivors
    if pid is not None and _pid_alive(pid):
        if not _kill_tree(pid):
            return False
    # now close the (possibly still-open) pane; the poll is generous for
    # the same zombie-reap reason as _kill_tree — success returns early
    if pane_id in live_pane_ids():
        tmux("kill-pane", "-t", pane_id, check=False)
    for _ in range(20):
        pane_gone = pane_id not in live_pane_ids()
        proc_gone = pid is None or not _pid_alive(pid)
        if pane_gone and proc_gone:
            return True
        time.sleep(0.15)
    return (pane_id not in live_pane_ids()) and (pid is None or not _pid_alive(pid))


def cmd_shutdown(args: argparse.Namespace) -> int:
    if _reject_bad_role(args.role):
        return 2
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
        if not info:
            # an explicit shutdown of a crash-lost role clears its record
            lost = dict(state.get("lost") or {})
            if args.role in lost:
                del lost[args.role]
                state["lost"] = lost
                save_state(state)
                print(f"cleared lost teammate '{args.role}' (it will no "
                      "longer be offered by `teamctl resurrect`)")
                return 0
            print(f"teamctl: no active teammate '{args.role}'.", file=sys.stderr)
            return 1
        pane_id = info.get("pane_id") or ""
        if pane_id and not _close_pane(pane_id):
            print(
                f"teamctl: failed to close pane {pane_id}; leaving '{args.role}' tracked.",
                file=sys.stderr,
            )
            return 1
        del state["teammates"][args.role]
        save_state(state)

    # a dispatch teammate's handoff dir is part of its lifetime: shutdown is
    # the explicit removal point, so clear the artifacts with the state.
    if info.get("mode") == "dispatch":
        hd = Path(info.get("handoff") or handoff_dir(args.role))
        if hd.is_dir() and hd != state_path().parent:
            shutil.rmtree(hd, ignore_errors=True)

    # worktree reconciliation AFTER the process is verifiably dead (never
    # remove a directory from under a live teammate): clean -> removed,
    # anything un-landed -> kept and reported. Stranding is impossible.
    wt = info.get("worktree")
    if wt:
        _shutdown_worktree(args.role, wt)

    _enforce_lead_width()
    if pane_id:
        print(f"shut down teammate '{args.role}' (pane {pane_id})")
    else:
        print(f"cleared finished teammate '{args.role}' (state and handoff)")
    return 0


def cmd_send(args: argparse.Namespace) -> int:
    if _reject_bad_role(args.role):
        return 2
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
        if not info:
            print(f"teamctl: no active teammate '{args.role}'.", file=sys.stderr)
            return 1
        pane_id = info["pane_id"]

    if pane_id not in live_pane_ids():
        print(
            f"teamctl: teammate '{args.role}' pane {pane_id} is gone.",
            file=sys.stderr,
        )
        return 1

    # `-l` sends the text literally (no key-name interpretation, no shell),
    # then a separate C-m presses Enter so the teammate's CLI submits it.
    typed = tmux("send-keys", "-t", pane_id, "-l", "--", args.message, check=False)
    if typed.returncode != 0:
        print(f"teamctl: failed to send to pane {pane_id}.", file=sys.stderr)
        return 1
    if not args.no_enter:
        tmux("send-keys", "-t", pane_id, "C-m", check=False)

    print(f"sent to '{args.role}' (pane {pane_id})")
    return 0


# --------------------------------------------------------------------------
# git-worktree isolation — every teammate gets its own branch in its own
# directory (one shared object store), so parallel writers PHYSICALLY
# cannot collide: the "never two teammates edit the same file" rule,
# mechanically enforced. ON by default in a git repo; spawning elsewhere
# degrades to the plain cwd with one honest note. `teamctl land <role>`
# closes the loop (review → checkpoint → merge → cleanup), and shutdown
# can never strand work: a worktree with anything un-landed is KEPT and
# reported, never silently discarded — with the registry
# (<state>/worktrees.json) as the durable record that outlives the
# teammate's state entry.
#
# Git safety rule, enforced by construction and audited by tests: teamctl
# NEVER passes -D, --force, or --hard to git. `git worktree remove` and
# `git branch -d` refuse on anything unsaved/unmerged — git's own safety
# is the backstop for any logic error in the checks here.
# --------------------------------------------------------------------------

def worktree_settings() -> dict:
    """[worktree]: enabled (default TRUE — v0.5.0 turns isolation on),
    dir ('' → <state>/worktrees), branch_prefix, cleanup (auto | keep)."""
    raw = load_config().get("worktree") or {}
    enabled = raw.get("enabled", True)
    if not isinstance(enabled, bool):
        enabled = str(enabled).strip().lower() not in ("false", "0", "no",
                                                       "off")
    cleanup = str(raw.get("cleanup") or "auto")
    if cleanup not in ("auto", "keep"):
        cleanup = "auto"
    return {"enabled": enabled, "dir": str(raw.get("dir") or ""),
            "branch_prefix": str(raw.get("branch_prefix") or "teamctl/"),
            "cleanup": cleanup}


def _git(repo: str, *args: str,
         timeout: float = 30.0) -> subprocess.CompletedProcess | None:
    """Run git with the same never-prompt/never-hang discipline as the
    update fetches; None when git cannot run at all."""
    env = dict(os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"
    try:
        return subprocess.run(["git", "-C", repo, *args],
                              capture_output=True, text=True,
                              timeout=timeout, env=env)
    except (OSError, subprocess.SubprocessError):
        return None


def _git_ok(repo: str, *args: str) -> str | None:
    """git stdout (stripped) on success, None on any failure."""
    res = _git(repo, *args)
    if res is None or res.returncode != 0:
        return None
    return res.stdout.strip()


def _git_fail_tail(res: subprocess.CompletedProcess | None,
                   fallback: str) -> str:
    if res is None:
        return "git not runnable"
    tail = res.stderr.strip().splitlines()
    return tail[-1] if tail else fallback


def _repo_root(cwd: str) -> str | None:
    return _git_ok(cwd, "rev-parse", "--show-toplevel")


def worktrees_root() -> Path:
    d = worktree_settings()["dir"]
    if d:
        return Path(os.path.expanduser(d))
    return state_path().parent / "worktrees"


def worktree_registry_path() -> Path:
    return state_path().parent / "worktrees.json"


def load_worktree_registry() -> dict:
    """path -> {role, branch, repo, base_sha, created_at}. The durable
    record of every teamctl-created worktree — it outlives the teammate's
    state entry so `land`/`worktree list|prune` keep working after a
    shutdown that preserved un-landed work (and after a reboot)."""
    try:
        p = worktree_registry_path()
        data = json.loads(p.read_text()) if p.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save_worktree_registry(reg: dict) -> None:
    p = worktree_registry_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(reg, indent=2, sort_keys=True))
    tmp.replace(p)


def _alloc_worktree(role: str, cwd: str) -> dict:
    """Create '<role>'s isolated worktree + branch off the current HEAD.
    Refuses honestly (existing branch/path — never guesses a suffix) and
    records the allocation in the registry. Returns
    {path, branch, repo, base_sha}."""
    root = _repo_root(cwd)
    if root is None:
        raise TeamctlError(
            f"{cwd} is not inside a git repository — worktree isolation "
            "needs one (use --no-worktree to opt out)")
    branch = worktree_settings()["branch_prefix"] + role
    if _git_ok(root, "rev-parse", "--verify", "--quiet",
               f"refs/heads/{branch}") is not None:
        raise TeamctlError(
            f"branch {branch} already exists (un-landed work from a "
            f"previous '{role}'?) — land it (`teamctl land {role}`), "
            f"delete it yourself (`git -C {root} branch -D {branch}`), "
            "or spawn under another role")
    import hashlib
    h8 = hashlib.sha256(root.encode()).hexdigest()[:8]
    path = worktrees_root() / f"{Path(root).name}-{h8}" / role
    if path.exists():
        raise TeamctlError(
            f"worktree path {path} already exists — clear it "
            "(`teamctl worktree prune`) or spawn under another role")
    path.parent.mkdir(parents=True, exist_ok=True)
    res = _git(root, "worktree", "add", "-b", branch, str(path), "HEAD")
    if res is None or res.returncode != 0:
        raise TeamctlError(
            f"could not create worktree for '{role}': "
            + _git_fail_tail(res, "git worktree add failed"))
    base = _git_ok(root, "rev-parse", "HEAD") or ""
    dirty = _git_ok(root, "status", "--porcelain")
    if dirty:
        n = len(dirty.splitlines())
        print(f"note: {n} uncommitted change(s) in {root} are not visible "
              f"to '{role}' — commit or stash first if it needs them.",
              file=sys.stderr)
    wt = {"path": str(path), "branch": branch, "repo": root,
          "base_sha": base}
    reg = load_worktree_registry()
    reg[str(path)] = {**wt, "role": role,
                      "created_at": time.strftime("%Y-%m-%dT%H:%M:%S")}
    save_worktree_registry(reg)
    return wt


def _maybe_alloc_worktree(role: str, cwd: str,
                          flag: bool | None) -> dict | None:
    """The tri-state gate: --worktree forces (errors honestly when it
    can't), --no-worktree skips, None follows [worktree] enabled (default
    on — degrading to the plain cwd with one note outside a git repo, so
    spawning in ~/notes keeps working)."""
    enabled = worktree_settings()["enabled"] if flag is None else flag
    if not enabled:
        return None
    explicit = flag is True
    if shutil.which("git") is None:
        if explicit:
            raise TeamctlError("git is not installed — worktree isolation "
                               "needs it")
        print("note: git not found — teammate runs without worktree "
              "isolation", file=sys.stderr)
        return None
    if _repo_root(cwd) is None:
        if explicit:
            raise TeamctlError(f"{cwd} is not inside a git repository — "
                               "--worktree needs one")
        print(f"note: {_tilde(cwd)} is not a git repository — '{role}' "
              "runs without worktree isolation", file=sys.stderr)
        return None
    return _alloc_worktree(role, cwd)


def _worktree_unique_work(wt: dict) -> tuple[bool, str]:
    """(has_unique_work, detail). Dirty files or un-landed commits count
    as unique work; a landed branch (tip reachable from the repo's HEAD)
    or a no-new-commits branch does not. Anything UNREADABLE counts as
    unique work — when unsure, keep; never guess toward deletion."""
    path, repo = wt["path"], wt["repo"]
    branch, base = wt["branch"], wt.get("base_sha") or ""
    if not Path(path).exists():
        return False, "path gone"
    dirty = _git(path, "status", "--porcelain")
    if dirty is None or dirty.returncode != 0:
        return True, "git status unreadable — keeping"
    if dirty.stdout.strip():
        n = len(dirty.stdout.strip().splitlines())
        return True, f"{n} uncommitted change(s)"
    if base:
        cnt = _git_ok(repo, "rev-list", "--count", f"{base}..{branch}")
        if cnt == "0":
            return False, "no new commits"
        if cnt is None:
            return True, "history unreadable — keeping"
    merged = _git(repo, "merge-base", "--is-ancestor", branch, "HEAD")
    if merged is not None and merged.returncode == 0:
        return False, "landed (branch tip is in HEAD)"
    if base:
        cnt = _git_ok(repo, "rev-list", "--count", f"{base}..{branch}")
        return True, f"{cnt} un-landed commit(s)"
    return True, "unknown base — keeping"


def _remove_worktree(wt: dict) -> tuple[bool, str]:
    """Remove a worktree + its branch — via git's own NON-forced commands
    only (`worktree remove`, `branch -d`): if either refuses, the caller
    keeps everything and says so. Clears the registry entry on success."""
    repo, path, branch = wt["repo"], wt["path"], wt["branch"]
    if Path(path).exists():
        res = _git(repo, "worktree", "remove", path)
        if res is None or res.returncode != 0:
            return False, ("git worktree remove refused: "
                           + _git_fail_tail(res, "worktree remove failed"))
    else:
        _git(repo, "worktree", "prune")
    if _git_ok(repo, "rev-parse", "--verify", "--quiet",
               f"refs/heads/{branch}") is not None:
        res = _git(repo, "branch", "-d", branch)
        if res is None or res.returncode != 0:
            return False, ("git branch -d refused: "
                           + _git_fail_tail(res, "branch delete failed"))
    reg = load_worktree_registry()
    reg.pop(path, None)
    save_worktree_registry(reg)
    return True, "removed"


def _shutdown_worktree(role: str, wt: dict) -> None:
    """Shutdown's strand-proofing: remove a worktree only when it provably
    holds nothing un-landed; otherwise KEEP it and print the way out. The
    registry entry survives with it, so `teamctl land <role>` still works
    after the teammate is gone."""
    if worktree_settings()["cleanup"] == "keep":
        print(f"kept worktree: {_tilde(wt['path'])} (branch {wt['branch']}"
              ", [worktree] cleanup = keep)")
        return
    unique, detail = _worktree_unique_work(wt)
    if not unique:
        ok, msg = _remove_worktree(wt)
        if ok:
            print(f"removed clean worktree {_tilde(wt['path'])} ({detail})")
        else:
            print(f"kept worktree {_tilde(wt['path'])}: {msg}",
                  file=sys.stderr)
        return
    print(f"kept worktree with un-landed work: {_tilde(wt['path'])} "
          f"(branch {wt['branch']}, {detail})")
    print(f"  land it:  teamctl land {role}    (works after shutdown too)")
    print("  or list:  teamctl worktree list")


def _find_worktree_for_role(role: str) -> tuple[dict | None, dict | None]:
    """(worktree, live_state_info) for a role: the live state entry first,
    then the registry (a shutdown that kept un-landed work, or a reboot).
    Ambiguity (same role in several repos) is refused, never guessed."""
    with state_lock():
        state = reconcile(load_state())
    info = state["teammates"].get(role)
    if info and info.get("worktree"):
        return dict(info["worktree"]), info
    matches = [dict(e) for e in load_worktree_registry().values()
               if e.get("role") == role]
    if len(matches) > 1:
        paths = ", ".join(m["path"] for m in matches)
        raise TeamctlError(
            f"'{role}' has worktrees in several repos ({paths}) — "
            "`teamctl worktree list` and land/prune by hand")
    return (matches[0] if matches else None), info


def cmd_land(args: argparse.Namespace) -> int:
    """Close the worktree loop: review the diff, checkpoint anything
    uncommitted (with consent), merge the teammate's branch into the
    repo's checked-out branch, then clean up. Conflicts stop-and-report
    (merge aborted, tree left clean) — teamctl never auto-resolves."""
    role = args.role
    if _reject_bad_role(role):
        return 2
    try:
        wt, info = _find_worktree_for_role(role)
    except TeamctlError as exc:
        print(f"teamctl: {exc}", file=sys.stderr)
        return 2
    if wt is None:
        print(f"teamctl: no worktree recorded for '{role}' — see "
              "`teamctl worktree list`.", file=sys.stderr)
        return 1

    # never land under a live teammate: a moving diff cannot be reviewed
    if info is not None:
        pane = info.get("pane_id") or ""
        alive = bool(pane) and pane in live_pane_ids()
        if info.get("mode") == "dispatch":
            hd = Path(info.get("handoff") or handoff_dir(role))
            alive = alive or (_read_status(hd)[0] == "running"
                              and _teammate_alive(info, hd))
        if alive:
            print(f"teamctl: '{role}' is still active — landing under a "
                  "live teammate risks a moving diff. Shut it down first: "
                  f"`teamctl shutdown {role}`.", file=sys.stderr)
            return 1

    repo, path, branch = wt["repo"], wt["path"], wt["branch"]
    base = wt.get("base_sha") or ""
    if not Path(path).exists():
        print(f"teamctl: worktree {path} is gone — nothing to land "
              f"(branch {branch} may still exist in {repo}).",
              file=sys.stderr)
        return 1

    dirty_out = _git_ok(path, "status", "--porcelain") or ""
    dirty = len(dirty_out.splitlines()) if dirty_out else 0
    commits = _git_ok(repo, "rev-list", "--count", f"{base}..{branch}") \
        if base else None
    target = _git_ok(repo, "symbolic-ref", "--short", "HEAD")
    diffstat = (_git_ok(repo, "diff", "--stat", f"{base}..{branch}") or "") \
        if base else ""

    plan = {"role": role, "branch": branch, "path": path, "repo": repo,
            "base_sha": base, "target": target,
            "uncommitted_changes": dirty,
            "unlanded_commits": int(commits) if (commits or "").isdigit()
            else None}

    if args.dry_run:
        if args.json:
            print(json.dumps(plan, indent=2))
        else:
            print(f"land plan for '{role}':")
            print(f"  branch {branch} -> {target or '(detached HEAD)'}"
                  f"  ({plan['unlanded_commits']} commit(s), "
                  f"{dirty} uncommitted change(s))")
            if diffstat:
                print("  " + "\n  ".join(diffstat.splitlines()))
            print(f"  full diff: git -C {repo} diff {base}..{branch}")
        return 0

    # 1. checkpoint uncommitted work (consent required; nothing is ever
    #    landed silently)
    if dirty:
        if args.yes or _ask_yn(
                f"commit {dirty} uncommitted change(s) in {_tilde(path)} "
                f"as a checkpoint on {branch}? [Y/n] ", default=True):
            res = _git(path, "add", "-A")
            if res is None or res.returncode != 0:
                print("teamctl: git add failed — nothing landed.",
                      file=sys.stderr)
                return 1
            msg = f"teamctl checkpoint: {role} " \
                  + time.strftime("%Y-%m-%d %H:%M")
            res = _git(path, "commit", "-m", msg)
            if res is None or res.returncode != 0:
                print("teamctl: checkpoint commit failed: "
                      + _git_fail_tail(res, "git commit failed"),
                      file=sys.stderr)
                return 1
            print(f"checkpointed {dirty} change(s) on {branch}")
        else:
            print("land cancelled — uncommitted changes stay where they "
                  "are (nothing landed).")
            return 1
    if args.checkpoint_only:
        outcome = {**plan, "landed": False, "checkpointed": dirty}
        print(json.dumps(outcome, indent=2) if args.json
              else f"checkpoint done — land later with `teamctl land {role}`")
        return 0

    commits = _git_ok(repo, "rev-list", "--count", f"{base}..{branch}") \
        if base else None
    if commits == "0":
        print(f"nothing to land: {branch} adds no commits over its base — "
              f"`teamctl shutdown {role}` / `teamctl worktree prune` "
              "cleans it up.")
        return 0

    # 2. integrate into the repo's checked-out branch — teamctl never
    #    switches the user's branches
    if not target:
        print(f"teamctl: {repo} is on a detached HEAD — check out the "
              "branch you want to land into, then re-run.", file=sys.stderr)
        return 1
    if args.into and args.into != target:
        print(f"teamctl: {repo} has '{target}' checked out, not "
              f"'{args.into}' — teamctl never switches your branches. "
              f"Check out {args.into} first.", file=sys.stderr)
        return 1
    root_dirty = _git_ok(repo, "status", "--porcelain")
    if root_dirty:
        print(f"teamctl: {repo} has uncommitted changes — commit or stash "
              "them first (landing merges into your checked-out branch).",
              file=sys.stderr)
        return 1
    res = _git(repo, "merge", "--no-ff", "-m",
               f"teamctl land: {role} ({branch})", branch)
    if res is None or res.returncode != 0:
        _git(repo, "merge", "--abort")
        print("teamctl: land hit merge conflicts — merge aborted, your "
              "tree is untouched. Resolve by hand:\n"
              f"  git -C {repo} merge {branch}\n"
              "then clean up with `teamctl worktree prune`.",
              file=sys.stderr)
        return 1

    landed_msg = f"landed '{role}': {branch} -> {target} ({commits} commit(s))"
    removed = False
    if not args.keep:
        unique, _detail = _worktree_unique_work(wt)
        if not unique:
            ok, msg = _remove_worktree(wt)
            removed = ok
            landed_msg += (" · worktree removed" if ok
                           else f" · worktree kept ({msg})")
        else:
            landed_msg += " · worktree kept (still has unique work)"
    # a live teammate keeps its state; a registry-only worktree that was
    # fully landed+removed needs no further tracking
    if args.json:
        print(json.dumps({**plan, "landed": True, "target": target,
                          "worktree_removed": removed}, indent=2))
    else:
        print(landed_msg)
    return 0


def cmd_worktree(args: argparse.Namespace) -> int:
    """`teamctl worktree list|prune` — the audit/recovery surface for
    every worktree teamctl ever created."""
    reg = load_worktree_registry()
    with state_lock():
        state = reconcile(load_state())
    owners = {}
    for r, i in state["teammates"].items():
        if i.get("worktree"):
            owners[i["worktree"].get("path", "")] = r

    rows = []
    for path, entry in sorted(reg.items()):
        wt = {"path": path, "branch": entry.get("branch", ""),
              "repo": entry.get("repo", ""),
              "base_sha": entry.get("base_sha", "")}
        exists = Path(path).exists()
        unique, detail = _worktree_unique_work(wt) if exists \
            else (False, "path gone")
        rows.append({"role": entry.get("role", "?"), "path": path,
                     "branch": wt["branch"], "repo": wt["repo"],
                     "exists": exists, "unique_work": unique,
                     "detail": detail,
                     "owner_alive": path in owners,
                     "created_at": entry.get("created_at", "")})

    if args.action == "list":
        if args.json:
            print(json.dumps(rows, indent=2))
            return 0
        if not rows:
            print("no teamctl worktrees.")
            return 0
        for r in rows:
            owner = "live" if r["owner_alive"] else "orphan"
            state_txt = r["detail"] if r["exists"] else "path gone"
            print(f"{r['role']:<16} {r['branch']:<28} {owner:<7} "
                  f"{state_txt}")
            print(f"{'':<16} {_tilde(r['path'])}")
        return 0

    # prune: remove only what provably holds nothing — never a live
    # teammate's worktree, never anything with unique work
    pruned, kept = [], []
    for r in rows:
        wt = {"path": r["path"], "branch": r["branch"], "repo": r["repo"],
              "base_sha": next((e.get("base_sha", "") for p, e in
                                reg.items() if p == r["path"]), "")}
        if r["owner_alive"]:
            kept.append((r, "owner is live"))
            continue
        if r["unique_work"]:
            kept.append((r, r["detail"]))
            continue
        if args.dry_run:
            pruned.append((r, "would remove"))
            continue
        ok, msg = _remove_worktree(wt)
        if ok:
            pruned.append((r, "removed"))
        else:
            kept.append((r, msg))
    for r, msg in pruned:
        print(f"{'(dry-run) ' if args.dry_run else ''}pruned "
              f"{r['role']}: {_tilde(r['path'])} ({msg})")
    for r, msg in kept:
        print(f"kept {r['role']}: {_tilde(r['path'])} — {msg}")
    if not rows:
        print("no teamctl worktrees.")
    return 0


def _dispatch_pane(role: str, hd: Path, argv: list[str], cwd: str,
                   provider: str, model: str) -> str:
    """Run a headless provider in a watchable pane.

    stdout -> result.json (the parseable source of truth). stderr goes
    STRAIGHT to error.log (durable: no intermediary process that can lose
    buffered output when the pane closes) and a background `tail -f` mirrors
    it into the pane so the run stays watchable. The old
    `2> >(tee error.log >&2)` process substitution was verified to LOSE any
    stderr written after the pane closed (tmux HUPs the tee), and on a
    provider killed at exec it left an empty error.log with no explanation.

    The status file records the exit code AND, for rc > 128, the signal name
    (e.g. `DONE 137 SIGKILL`) so a killed provider is distinguishable from a
    failed one. The wrapper's PID is recorded for teardown.

    With [layout] keep_finished (the default), the pane does NOT self-close
    on completion: the wrapper prints a completion banner and blocks until
    `teamctl shutdown <role>` tears it down — finished work stays VISIBLE in
    the window, not just tracked in state. keep_finished=false restores the
    ephemeral behavior (pane closes ~2s after the task ends)."""
    hcmd = " ".join(shlex.quote(a) for a in argv)
    q = shlex.quote
    pid_f = q(str(hd / "pid"))
    res_f = q(str(hd / "result.json"))
    err_f = q(str(hd / "error.log"))
    sta_f = q(str(hd / "status"))
    banner = f"[teamctl] {provider} {model or ''} :: {role} — working…"
    if keep_finished_panes():
        # `tail -f /dev/null` blocks portably (macOS sleep has no infinity);
        # shutdown's process-tree kill (or the pane's C-c) ends it.
        ending = (
            f"printf '\\n[teamctl] {role} — DONE rc=%s%s · result captured · "
            f"closes on: teamctl shutdown {role}\\n' "
            "\"$rc\" \"${cause:+ (SIG$cause)}\"; "
            "tail -f /dev/null"
        )
    else:
        ending = (
            f"echo \"[teamctl] {role} finished rc=$rc${{cause:+ (SIG$cause)}}\"; "
            "sleep 2; kill $tailpid 2>/dev/null"
        )
    script = (
        f"echo $$ > {pid_f}; "
        f"cd {q(cwd)} || exit 97; "
        f"echo {q(banner)}; "
        f": > {err_f}; "
        f"tail -f {err_f} >&2 & tailpid=$!; "
        f"{hcmd} > {res_f} 2> {err_f}; "
        "rc=$?; cause=''; "
        "if [ \"$rc\" -gt 128 ]; then "
        "cause=$(kill -l $((rc-128)) 2>/dev/null); fi; "
        f"printf 'DONE %s%s\\n' \"$rc\" \"${{cause:+ SIG$cause}}\" > {sta_f}; "
        + ending
    )
    outer = "bash -c " + shlex.quote(script)
    existing = [i.get("pane_id", "") for i in load_state()["teammates"].values()]
    return _open_pane(outer, existing)


def _resolve_dispatch(provider: str, task: str, context_file: str, model_arg: str,
                      effort_arg: str, cwd_arg: str) -> tuple[str, str, str, str]:
    """Resolve (cwd, model, effort, task) exactly the way dispatch does."""
    cwd = os.path.abspath(os.path.expanduser(cwd_arg)) if cwd_arg else os.getcwd()
    d_model, d_effort = provider_defaults(provider)
    model = model_arg or d_model or ""
    effort = effort_arg or d_effort or ""
    if context_file:
        ctx = Path(os.path.expanduser(context_file)).read_text()
        task = f"{task}\n\n--- context ---\n{ctx}"
    return cwd, model, effort, task


def _do_dispatch(role: str, provider: str, task: str, context_file: str,
                 model_arg: str, effort_arg: str, cwd_arg: str,
                 worktree_flag: bool | None = None) -> int:
    """Shared dispatch body used by `dispatch` and `route`."""
    if _reject_bad_role(role):
        return 2
    if not in_tmux():
        print("teamctl: not inside a tmux session; start one first.", file=sys.stderr)
        return 2

    cwd, model, effort, task = _resolve_dispatch(
        provider, task, context_file, model_arg, effort_arg, cwd_arg)
    argv = headless_argv(provider, task, model, effort)

    with state_lock():
        state = reconcile(load_state())
        existing_info = state["teammates"].get(role)
        if existing_info:
            finished = False
            if existing_info.get("mode") == "dispatch":
                hd0 = Path(existing_info.get("handoff") or handoff_dir(role))
                finished = (_read_status(hd0)[0] == "done"
                            or not existing_info.get("pane_id"))
            if finished:
                print(f"teamctl: finished teammate '{role}' still holds this "
                      f"role — read it with `teamctl result {role}`, continue "
                      f"it with `teamctl followup {role}`, or clear it with "
                      f"`teamctl shutdown {role}`.", file=sys.stderr)
            else:
                print(f"teamctl: teammate '{role}' already exists.",
                      file=sys.stderr)
            return 1

        try:
            wt = _maybe_alloc_worktree(role, cwd, worktree_flag)
        except TeamctlError as exc:
            print(f"teamctl: {exc}", file=sys.stderr)
            return 2
        if wt:
            cwd = wt["path"]

        hd = handoff_dir(role)
        hd.mkdir(parents=True, exist_ok=True)
        (hd / "task.md").write_text(task)
        # "session" too: a fresh dispatch is a NEW conversation — a stale
        # session id from a previous holder of this role must never leak
        # into this teammate's follow-ups.
        for stale in ("status", "result.json", "error.log", "pid", "session"):
            (hd / stale).unlink(missing_ok=True)

        pane_id = _dispatch_pane(role, hd, argv, cwd, provider, model)
        _set_pane_title(pane_id, role, model)

        state["teammates"][role] = {
            "provider": provider,
            "pane_id": pane_id,
            "cwd": cwd,
            "model": model,
            "effort": effort,
            "mode": "dispatch",
            "handoff": str(hd),
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
        if wt:
            state["teammates"][role]["worktree"] = wt
        save_state(state)

    print(f"dispatched '{role}' ({provider}"
          f"{'/' + model if model else ''}) in pane {pane_id}")
    return 0


def cmd_dispatch(args: argparse.Namespace) -> int:
    provider = _provider_or_fail(args.provider)
    if provider is None:
        return 2
    return _do_dispatch(args.role, provider, args.task, args.context_file,
                        args.model, args.effort, args.cwd,
                        getattr(args, "worktree", None))


def _read_status(hd: Path) -> tuple[str, int | None]:
    sta = hd / "status"
    if not sta.exists():
        return "running", None
    raw = sta.read_text().strip()
    parts = raw.split()
    # "DONE <rc>" or "DONE <rc> <signal-cause>" (e.g. "DONE 137 SIGKILL")
    if len(parts) >= 2 and parts[0] == "DONE":
        try:
            return "done", int(parts[1])
        except ValueError:
            pass
    return "done", None


def _status_cause(hd: Path) -> str | None:
    """The signal cause the wrapper recorded (e.g. 'SIGKILL'), if any."""
    sta = hd / "status"
    try:
        parts = sta.read_text().split()
    except OSError:
        return None
    return parts[2] if len(parts) >= 3 else None


def _wrapper_pid(hd: Path) -> int | None:
    """PID recorded by the dispatch wrapper, if present and parseable."""
    pid_f = hd / "pid"
    if not pid_f.exists():
        return None
    try:
        return int(pid_f.read_text().strip())
    except (OSError, ValueError):
        return None


_UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")


def _codex_rollout_glob(since: float | None) -> str | None:
    """codex fallback: the newest rollout log created after the dispatch
    started whose filename ends in a uuid (the session id appears in the
    rollout filename — live-verified)."""
    base = Path.home() / ".codex" / "sessions"
    if not base.exists():
        return None
    logs = sorted(base.glob("*/*/*/rollout-*.jsonl"),
                  key=lambda p: p.stat().st_mtime, reverse=True)
    for log in logs[:8]:
        if since is not None and log.stat().st_mtime < since:
            continue
        tail = log.stem[-36:]
        if _UUID_RE.fullmatch(tail):
            return tail
    return None


def _extract_session_id(provider: str, hd: Path,
                        since: float | None = None) -> str | None:
    """Best-effort provider session id from a dispatch's artifacts, for
    exact-session follow-ups — driven by the spec's session_source.

    stderr-regex (codex): `codex exec` prints `session id: <uuid>` on
    stderr (OBSERVED banner; live-verified), with the rollout-filename
    glob as a named built-in fallback. result-json (claude/gemini:
    session_id; grok: sessionId): the id key found recursively in the
    JSON artifacts. The result JSON normally lands on stdout
    (result.json), but a failed run's error JSON can land on stderr
    instead — gemini verified live: its error JSON, session_id included,
    is emitted on stderr — so error.log is consulted second."""
    def _read(name: str) -> str:
        f = hd / name
        try:
            return f.read_text() if f.exists() else ""
        except OSError:
            return ""

    src = (provider_spec(provider) or {}).get("session_source")
    if not src:
        return None

    if src.get("type") == "stderr-regex":
        # which artifacts the pattern scans is part of the source spec:
        # codex deliberately scans ONLY error.log (its banner is the CLI's
        # own stderr; scanning the model's stdout could capture a merely
        # quoted id — a guess). Custom text-only providers that print the
        # id to stdout opt into ["error.log", "result.json"].
        for artifact in src.get("artifacts") or ("error.log",):
            m = re.search(src["pattern"], _read(artifact))
            if m:
                sid = (m.group(1) or "").strip()
                if sid and (not src.get("uuid") or _UUID_RE.fullmatch(sid)):
                    return sid
        if src.get("fallback") == "codex-rollout-glob":
            return _codex_rollout_glob(since)
        return None

    if src.get("type") == "result-json":
        for artifact in ("result.json", "error.log"):
            try:
                data = json.loads(_read(artifact))
            except (json.JSONDecodeError, ValueError):
                continue
            sid = _find_key(data, src["key"])
            if sid:
                return str(sid)
    return None


def _dispatch_started_at(info: dict) -> float | None:
    try:
        return time.mktime(time.strptime(info.get("created_at", ""),
                                         "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, OverflowError):
        return None


def _capture_session_id(info: dict, hd: Path) -> str | None:
    """Parse and persist the teammate's session id (hd/session). Refreshed
    whenever newer artifacts yield one — a resumed run can mint a new id.
    Returns the current best id, falling back to the persisted one."""
    sid = _extract_session_id(info.get("provider", ""), hd,
                              _dispatch_started_at(info))
    sf = hd / "session"
    if sid:
        try:
            sf.write_text(sid + "\n")
        except OSError:
            pass
        return sid
    try:
        if sf.exists():
            return sf.read_text().strip() or None
    except OSError:
        pass
    return None


def _teammate_alive(info: dict, hd: Path) -> bool:
    """True if the teammate pane still exists and/or the wrapper pid is live.

    Status is only written when the wrapper exits normally, so a killed pane
    or process would otherwise leave `result --wait` spinning until timeout.
    """
    pane_id = info.get("pane_id")
    if pane_id and pane_id in live_pane_ids():
        return True
    pid = _wrapper_pid(hd)
    if pid is not None and _pid_alive(pid):
        return True
    return False


def cmd_result(args: argparse.Namespace) -> int:
    if _reject_bad_role(args.role):
        return 2
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
    if not info:
        print(f"teamctl: no teammate '{args.role}'.", file=sys.stderr)
        return 1
    hd = Path(info.get("handoff") or handoff_dir(args.role))

    status, rc = _read_status(hd)
    if status == "running" and args.wait:
        deadline = args.timeout
        waited = 0.0
        while waited < deadline:
            status, rc = _read_status(hd)
            if status != "running":
                break
            if not _teammate_alive(info, hd):
                # Race: wrapper may have written status on the way out.
                status, rc = _read_status(hd)
                if status != "running":
                    break
                print(
                    f"{args.role}: failed (teammate died before writing status)",
                    file=sys.stderr,
                )
                return 1
            time.sleep(0.3)
            waited += 0.3

    # keep the exact-session id current whenever artifacts allow it
    _capture_session_id(info, hd)

    if status == "running":
        if not _teammate_alive(info, hd):
            print(f"{args.role}: failed (teammate died before writing "
                  "status)", file=sys.stderr)
            return 1
        print(f"{args.role}: running")
        return 0

    result_txt = ""
    res_f = hd / "result.json"
    if res_f.exists():
        result_txt = res_f.read_text()
    err_txt = (hd / "error.log").read_text() if (hd / "error.log").exists() else ""

    signal = classify_output(result_txt + "\n" + err_txt)
    if signal != "ok":
        _record_provider_signal(info["provider"], signal)

    if rc == 0:
        print(f"{args.role}: done")
        try:
            print(json.dumps(json.loads(result_txt), indent=2))
        except (json.JSONDecodeError, ValueError):
            print(result_txt.rstrip())
        if signal != "ok":
            print(f"[teamctl] note: provider signal = {signal}", file=sys.stderr)
        return 0

    cause = _status_cause(hd)
    print(f"{args.role}: failed (rc={rc}{', ' + cause if cause else ''}, "
          f"signal={signal})", file=sys.stderr)
    if err_txt.strip():
        print(err_txt.rstrip()[-2000:], file=sys.stderr)
    elif not result_txt.strip():
        # nothing on stdout OR stderr: the provider died before producing a
        # single byte — explain what that shape usually means instead of
        # leaving the user staring at two empty files.
        prov = info.get("provider", "the provider")
        print(
            f"[teamctl] no output captured: result.json and error.log are "
            f"both empty — {prov} died before writing anything.", file=sys.stderr)
        if rc is not None and rc > 128:
            print(
                f"[teamctl] rc={rc} means it was killed by a signal"
                f"{' (' + cause + ')' if cause else ''}. Common causes: an "
                "out-of-memory kill, or macOS killing a broken/unsigned "
                f"binary at exec. Check the CLI itself: run `{prov} "
                f"--version` in a shell, and on macOS "
                f"`codesign -v \"$(which {prov})\"`.", file=sys.stderr)
    return 1


def cmd_followup(args: argparse.Namespace) -> int:
    if _reject_bad_role(args.role):
        return 2
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
    if not info:
        print(f"teamctl: no teammate '{args.role}'.", file=sys.stderr)
        return 1
    if not in_tmux():
        print("teamctl: not inside a tmux session.", file=sys.stderr)
        return 2

    provider = info["provider"]
    cwd = info.get("cwd") or os.getcwd()
    model = info.get("model") or ""
    effort = info.get("effort") or ""
    hd = Path(info.get("handoff") or handoff_dir(args.role))
    hd.mkdir(parents=True, exist_ok=True)

    # refuse to stack a follow-up on a run that is still in flight: the two
    # wrappers would race on the same handoff files.
    status, _ = _read_status(hd)
    if status == "running" and _teammate_alive(info, hd):
        print(f"teamctl: '{args.role}' is still running — wait for "
              f"`teamctl result {args.role} --wait` first.", file=sys.stderr)
        return 1

    # capability check BEFORE touching the pane: a provider with no resume
    # shape can never follow up — refuse now, honestly, leaving the
    # teammate exactly as it was.
    spec = provider_spec(provider) or {}
    if not spec.get("resume"):
        print(f"teamctl: provider '{provider}' cannot resume a session — "
              "teamctl never guesses 'most recent'. Re-dispatch instead.",
              file=sys.stderr)
        return 1

    # a finished teammate may still hold its pane open (keep_finished):
    # close it before opening the follow-up pane so the role never shows
    # two panes at once.
    old_pane = info.get("pane_id") or ""
    if old_pane and old_pane in live_pane_ids():
        _close_pane(old_pane)

    # exact-session only: capture the id from the previous turn's artifacts
    # BEFORE they are cleared. Without one, refuse — never resume "the most
    # recent session", which grabs the wrong one under concurrency. (A spec
    # with a resume shape but no session_source — the shell test provider —
    # is deliberately sessionless: its "resume" is a fresh process.)
    session_id = ""
    if spec.get("session_source"):
        session_id = _capture_session_id(info, hd) or ""
        if not session_id:
            print(f"teamctl: no session id captured for '{args.role}' — "
                  "cannot resume its exact session (teamctl never guesses "
                  "'most recent'). Re-dispatch instead.", file=sys.stderr)
            return 1
    argv = resume_argv(provider, args.task, model, effort, session_id)
    for stale in ("status", "result.json", "error.log", "pid"):
        (hd / stale).unlink(missing_ok=True)

    with state_lock():
        state = reconcile(load_state())
        pane_id = _dispatch_pane(args.role, hd, argv, cwd, provider, model)
        _set_pane_title(pane_id, args.role, model)
        state["teammates"][args.role]["pane_id"] = pane_id
        save_state(state)
    print(f"follow-up sent to '{args.role}' in pane {pane_id}")
    return 0


# --------------------------------------------------------------------------
# `teamctl resurrect` — rebuild the roster after a crash/reboot.
#
# reconcile captures dropped interactive teammates in state["lost"] (the
# capture point IS the drop point — no parallel manifest that can drift);
# resurrect respawns them fresh with everything state recorded (provider/
# model/effort/cwd/prompt/worktree). Honesty first: teamctl never captured
# an interactive session id (capture is artifact-based, dispatch-only) and
# resuming "the most recent session in this cwd" would violate the
# never-guess rule — so a resurrected teammate STARTS OVER and says so in
# its opening prompt. Dispatch teammates never need resurrecting: their
# artifacts survive on disk and `result`/`followup` keep working —
# exact-session — indefinitely.
# --------------------------------------------------------------------------

RESURRECT_NOTE = ("[teamctl] resurrected after a crash/reboot — prior "
                  "conversation context was NOT restored.")


def _resurrect_plan(role: str, info: dict,
                    active: dict) -> tuple[str, str, dict | None, str]:
    """(action, cwd, worktree_to_reuse, note) for one lost teammate.
    action: respawn | skip | followup | error."""
    if role in active:
        return ("skip", "", None,
                "the role is active again — stale lost entry cleared")
    if info.get("mode") == "dispatch":
        return ("followup", "", None,
                "a dispatch teammate needs no respawn: its artifacts are "
                f"on disk — `teamctl result {role}` / `teamctl followup "
                f"{role} --task …` resume the exact session")
    wt = info.get("worktree")
    if wt and Path(wt.get("path", "")).is_dir():
        return ("respawn", wt["path"], dict(wt),
                f"reusing its worktree ({wt['branch']})")
    if wt:
        return ("respawn", wt.get("repo") or info.get("cwd", ""), None,
                "its worktree path is gone — a fresh one is allocated "
                "(refused honestly if the old branch still exists)")
    cwd = info.get("cwd", "")
    if not cwd or not Path(cwd).is_dir():
        return ("error", "", None,
                f"original cwd {cwd or '?'} no longer exists — respawn "
                f"manually: `teamctl spawn {role} --cwd <dir>`")
    return ("respawn", cwd, None, "")


def cmd_resurrect(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
    lost = dict(state.get("lost") or {})
    targets = list(args.roles) or sorted(lost)
    if not targets:
        print("nothing to resurrect — no lost teammates recorded.")
        return 0
    missing = [r for r in targets if r not in lost]
    if missing:
        print(f"teamctl: not in the lost roster: {', '.join(missing)} "
              f"(lost: {', '.join(sorted(lost)) or 'none'}).",
              file=sys.stderr)
        return 1

    plans = {r: _resurrect_plan(r, lost[r], state["teammates"])
             for r in targets}

    if args.dry_run:
        if getattr(args, "json", False):
            print(json.dumps({r: {
                "action": a, "cwd": cwd or None,
                "worktree": (wt or None), "note": note or None,
                "provider": lost[r].get("provider"),
                "model": lost[r].get("model") or None,
                "effort": lost[r].get("effort") or None,
                "lost_at": lost[r].get("lost_at")}
                for r, (a, cwd, wt, note) in plans.items()},
                indent=2, sort_keys=True))
            return 0
        for r, (action, cwd, _wt, note) in sorted(plans.items()):
            info = lost[r]
            tag = info.get("provider", "?") + (
                "/" + info["model"] if info.get("model") else "")
            line = f"{r}: {action} ({tag}"
            if action == "respawn":
                line += f", cwd {_tilde(cwd)}"
            line += ")"
            if note:
                line += f" — {note}"
            print(line)
        print("\n(a resurrected teammate starts a FRESH session — prior "
              "interactive context is not restorable; dispatch teammates "
              "resume exactly via `followup`.)")
        return 0

    respawns = [r for r, (a, *_r) in plans.items() if a == "respawn"]
    if respawns and not args.yes:
        if not _ask_yn(f"resurrect {len(respawns)} teammate(s) "
                       f"({', '.join(respawns)})? [Y/n] ", default=True):
            print("nothing resurrected.")
            return 1

    failures = 0
    for role in targets:
        action, cwd, reuse_wt, note = plans[role]
        info = lost[role]
        if action == "error":
            failures += 1
            print(f"{role}: NOT resurrected — {note}", file=sys.stderr)
            continue
        if action in ("skip", "followup"):
            print(f"{role}: {note}")
            if action == "skip":
                _drop_lost_entry(role)
            continue
        prompt = RESURRECT_NOTE
        if info.get("prompt"):
            prompt += "\n\n" + info["prompt"]
        ns = argparse.Namespace(
            role=role, provider=info.get("provider", ""),
            prompt=prompt, model=info.get("model", ""),
            effort=info.get("effort", ""), cwd=cwd, dry_run=False,
            worktree=(False if reuse_wt else None))
        rc = cmd_spawn(ns)
        if rc != 0:
            failures += 1
            print(f"{role}: respawn failed (rc={rc}) — see above.",
                  file=sys.stderr)
            continue
        if reuse_wt:
            with state_lock():
                st = load_state()
                if role in st["teammates"]:
                    st["teammates"][role]["worktree"] = reuse_wt
                    save_state(st)
        _drop_lost_entry(role)
        if note:
            print(f"{role}: {note}")
    return 1 if failures else 0


def _drop_lost_entry(role: str) -> None:
    with state_lock():
        st = load_state()
        lost = dict(st.get("lost") or {})
        if role in lost:
            del lost[role]
            st["lost"] = lost
            save_state(st)


def _record_provider_signal(provider: str, signal: str,
                            resets_at: float | None = None) -> None:
    """Cache a provider signal. Routing is not codified policy: the caller
    decides at spawn time. A signal with a known resets_at auto-expires at
    that moment so a stale 'exhausted' can never outlive the real window."""
    cache = state_path().parent / "providers.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        data = {}
    entry = {"signal": signal, "at": time.strftime("%Y-%m-%dT%H:%M:%S")}
    if resets_at:
        entry["resets_at"] = resets_at
    data[provider] = entry
    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(data, indent=2, sort_keys=True))


def _live_signal(entry: dict | None) -> str | None:
    """The cached signal, unless its reset time has already passed."""
    if not entry:
        return None
    resets_at = entry.get("resets_at")
    if resets_at and resets_at <= time.time():
        return None
    return entry.get("signal")


def _find_key(obj, key):
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        for v in obj.values():
            r = _find_key(v, key)
            if r is not None:
                return r
    elif isinstance(obj, list):
        for v in obj:
            r = _find_key(v, key)
            if r is not None:
                return r
    return None


def codex_usage() -> dict | None:
    """Latest {primary, secondary} rate-limit windows from Codex session logs.
    Codex records real usage in `token_count` events: each window has
    used_percent, window_minutes, and a resets_at unix timestamp."""
    base = Path.home() / ".codex" / "sessions"
    if not base.exists():
        return None
    logs = sorted(base.glob("*/*/*/*.jsonl"), key=lambda p: p.stat().st_mtime,
                  reverse=True)
    for log in logs[:8]:
        last = None
        try:
            with open(log) as fh:
                for line in fh:
                    if '"rate_limits"' in line:
                        try:
                            d = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        rl = _find_key(d, "rate_limits")
                        if isinstance(rl, dict):
                            last = rl
        except OSError:
            continue
        if last:
            return last
    return None


def _fmt_reset(resets_at, now) -> str:
    if not resets_at:
        return "?"
    when = time.strftime("%-I:%M %p", time.localtime(resets_at))
    mins = int((resets_at - now) / 60)
    if mins <= 0:
        return f"{when} (now)"
    return f"{when} (in {mins // 60}h{mins % 60:02d}m)"


def _fmt_age(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s ago"
    if s < 3600:
        return f"{s // 60}m ago"
    return f"{s // 3600}h{(s % 3600) // 60:02d}m ago"


def claude_usage() -> dict | None:
    """Claude 5h/weekly windows, cached by `teamctl statusline`.

    Claude Code pipes `rate_limits.five_hour/seven_day` (used_percentage,
    resets_at — documented statusLine fields, present for subscribers after
    the first API response) into the status line; ours dumps them to
    claude-usage.json next to the state file. Absent/partial data is normal."""
    path = state_path().parent / "claude-usage.json"
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict) or not isinstance(data.get("rate_limits"), dict):
        return None
    return data


# --------------------------------------------------------------------------
# the provider state lattice — one honest word per provider, everywhere
# (providers, usage, the init frames, the installer screen):
#
#   not installed   CLI not on PATH; residual usage artifacts are flagged,
#                   never rendered as a live provider
#   locked out      installed, not signed in
#   quiet           signed in, no usage numbers seen yet (it wakes on use)
#   ready           signed in, with usage numbers
#   unknown         auth artifacts exist but are unreadable — reported,
#                   never guessed
# --------------------------------------------------------------------------

# wake/login hints live in each provider's spec (wake_hint / login_hint —
# see PROVIDER_SPECS); the wake_hint() / login_hint() accessors add the
# fallbacks, so custom providers degrade to honest generic advice.


def _known_windows(provider: str) -> dict[str, dict]:
    """label -> {used_percent, resets_at} from the provider's native local
    source (codex session logs, the claude statusline cache); {} if none."""
    wins: dict[str, dict] = {}
    if provider == "codex":
        rl = codex_usage()
        if rl:
            for key, label in (("primary", "5h"), ("secondary", "weekly")):
                w = rl.get(key) or {}
                if w.get("used_percent") is not None:
                    wins[label] = {"used_percent": w["used_percent"],
                                   "resets_at": w.get("resets_at")}
    elif provider == "claude":
        cu = claude_usage()
        if cu:
            for key, label in (("five_hour", "5h"), ("seven_day", "weekly")):
                w = cu["rate_limits"].get(key) or {}
                if isinstance(w, dict) and w.get("used_percentage") is not None:
                    wins[label] = {"used_percent": w["used_percentage"],
                                   "resets_at": w.get("resets_at")}
    return wins


def _probe_windows(provider: str) -> dict[str, dict]:
    """Cached hidden-probe windows for a provider; {} when none."""
    entry = load_probe_cache().get(provider)
    if not isinstance(entry, dict):
        return {}
    wins = entry.get("windows")
    return wins if isinstance(wins, dict) else {}


def provider_has_usage_data(provider: str) -> bool:
    """Any locally-known usage numbers: a native source or a cached
    hidden-probe result."""
    return bool(_known_windows(provider)) or bool(_probe_windows(provider))


def _usage_summary(provider: str) -> str:
    """One-line usage digest for a ready provider, e.g. '5h 23% · weekly
    41% used'; '' when nothing is known."""
    wins, src = _known_windows(provider), ""
    if not wins:
        wins, src = _probe_windows(provider), " (probe)"
    parts = [f"{label} {w['used_percent']:.0f}%" for label, w in wins.items()
             if isinstance(w, dict)
             and isinstance(w.get("used_percent"), (int, float))]
    return (" · ".join(parts) + " used" + src) if parts else ""


def _used_percent(provider: str) -> float | None:
    """Binding-constraint usage for headroom ranking: the MAX used_percent
    across the provider's known windows (5h vs weekly — the tighter one
    governs), native source first, probe cache second — the same
    precedence _usage_summary uses. None when nothing is known (a 'quiet'
    provider, or gemini always — it has no usage source)."""
    wins = _known_windows(provider)
    if not wins:
        wins = _probe_windows(provider)
    pcts = [w.get("used_percent") for w in wins.values()
            if isinstance(w, dict)
            and isinstance(w.get("used_percent"), (int, float))]
    return float(max(pcts)) if pcts else None


def _probe_is_stale(provider: str) -> bool:
    """True when the provider's cached probe result is older than
    [usage] probe_stale_minutes."""
    entry = load_probe_cache().get(provider)
    if not isinstance(entry, dict):
        return False
    cap = entry.get("captured_at")
    return (isinstance(cap, (int, float))
            and time.time() - cap > probe_stale_minutes() * 60)


def provider_state(provider: str) -> tuple[str, str]:
    """(lattice state, note) for one provider — see the map above. An
    'unprobed' custom provider renders as quiet/ready with its "auth not
    probed" note: installed and explicitly configured, auth unknowable."""
    has_data = provider_has_usage_data(provider)
    if not provider_installed(provider):
        return ("not installed",
                "residual usage history found" if has_data else "")
    auth, note = provider_auth_state(provider)
    if auth == "unknown":
        return "unknown", note
    if auth == "signed-out":
        return "locked out", note
    return ("ready" if has_data else "quiet"), note


# --------------------------------------------------------------------------
# `teamctl models` — best-effort model discovery. Model ids always pass
# through to the provider CLI verbatim (the CLI is the validator), so new
# models work without updating teamctl; discovery only powers suggestions.
# --------------------------------------------------------------------------

def _grok_models_output() -> str | None:
    """Output of `grok models` (a documented subcommand; its output format is
    not documented, so it is passed through rather than parsed strictly)."""
    if shutil.which("grok") is None:
        return None
    try:
        res = subprocess.run(["grok", "models"], capture_output=True,
                             text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0:
        return None
    return res.stdout


def _codex_models_cache() -> tuple[list[dict], str] | None:
    """(models, fetched_at) from ~/.codex/models_cache.json. OBSERVED-ONLY:
    the shape ({'fetched_at', 'models': [{'slug', 'display_name',
    'supported_reasoning_levels': [{'effort', ...}]}]}) was seen in codex
    0.144 and is not a documented interface — parsed defensively."""
    path = Path.home() / ".codex" / "models_cache.json"
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    models = data.get("models") if isinstance(data, dict) else None
    if not isinstance(models, list):
        return None
    return ([m for m in models if isinstance(m, dict)],
            str(data.get("fetched_at") or "?"))


def discover_models(provider: str) -> list[str]:
    """Best-effort model ids for suggestions; [] whenever unknown."""
    if provider == "codex":
        cached = _codex_models_cache()
        if cached:
            return [str(m["slug"]) for m in cached[0] if m.get("slug")]
    if provider == "grok":
        out = _grok_models_output()
        if out:
            ids = []
            for line in out.splitlines():
                line = line.strip()
                if line.startswith(("*", "-")):
                    parts = line.lstrip("*- ").split()
                    if parts:
                        ids.append(parts[0])
            return ids
    return []


def cmd_models(args: argparse.Namespace) -> int:
    routable = routable_providers()
    providers = [args.provider] if args.provider else list(routable)
    for prov in providers:
        if prov not in routable:
            print(f"teamctl: unknown provider '{prov}'.", file=sys.stderr)
            return 2
    for prov in providers:
        print(f"{prov}:")
        if prov == "grok":
            out = _grok_models_output()
            if out:
                for line in out.rstrip().splitlines():
                    print(f"  {line}")
                print("  (source: `grok models` — documented command, output "
                      "passed through)")
            else:
                print("  could not run `grok models` (not installed, not "
                      "logged in, or the command failed)")
        elif prov == "codex":
            cached = _codex_models_cache()
            if cached:
                models, fetched = cached
                for m in models:
                    slug = m.get("slug") or "?"
                    efforts = "/".join(
                        str(lv["effort"])
                        for lv in (m.get("supported_reasoning_levels") or [])
                        if isinstance(lv, dict) and lv.get("effort"))
                    extra = ", ".join(x for x in (
                        str(m.get("display_name") or ""),
                        f"efforts: {efforts}" if efforts else "") if x)
                    print(f"  {slug}" + (f"  ({extra})" if extra else ""))
                print(f"  (source: ~/.codex/models_cache.json, fetched "
                      f"{fetched} — an observed cache, not a documented "
                      "interface)")
            else:
                print("  no local model list found; any model id is accepted "
                      "(the codex CLI validates it)")
        elif prov == "claude":
            print("  the claude CLI has no model-listing command; --model "
                  "takes a documented")
            print("  alias (sonnet, opus, haiku, fable) or a full model name. "
                  "Inside a session,")
            print("  /model opens the interactive picker.")
        elif prov == "gemini":
            print("  the gemini CLI has no model-listing command; --model "
                  "takes any Gemini")
            print("  model id (e.g. gemini-2.5-pro). GEMINI_MODEL and "
                  "settings.json model.name")
            print("  also work — the CLI is the validator.")
        else:   # a custom provider: teamctl knows only what the block says
            print("  no model discovery for a custom provider; --model "
                  "passes through its")
            print("  model_args verbatim (the CLI validates it).")
        print()
    print("model ids pass through to the provider CLI verbatim — new models "
          "work without updating teamctl.")
    return 0


# --------------------------------------------------------------------------
# hidden usage probes — run a provider TUI's own usage command inside a
# detached background tmux session (never the user's window) and scrape the
# numbers. TUI output is OBSERVED-ONLY text: parse defensively, degrade
# gracefully, and tear the TUI down with the same process-tree-verified kill
# used for teammates.
# --------------------------------------------------------------------------

PROBE_SESSION = "teamctl-probe"


def probe_specs() -> dict[str, dict]:
    """provider -> how to ask its TUI for usage, read off the registry
    (spec key "probe"; custom providers join via probe_command). claude
    deliberately has none: its statusline rate_limits feed
    (claude-usage.json) is the documented and cheaper source. gemini has
    none either: current builds expose no parseable used-% in /stats
    (verified 2026-07) — it stays honestly quiet. `command` is typed into
    the TUI followed by Enter; extra_enters presses Enter again if no
    numbers appear (menu confirmation)."""
    out: dict[str, dict] = {}
    for name in routable_providers():
        probe = (provider_spec(name) or {}).get("probe")
        if probe:
            out[name] = probe
    return out


def _capture_pane(pane_id: str) -> str:
    try:
        return tmux("capture-pane", "-p", "-t", pane_id).stdout
    except subprocess.CalledProcessError:
        return ""


def _probe_session_exists() -> bool:
    return tmux("has-session", "-t", f"={PROBE_SESSION}",
                check=False).returncode == 0


def _open_probe_pane(launch_line: str) -> str:
    """A window inside the detached probe session (created on demand):
    nothing ever appears in the user's own session or window."""
    if _probe_session_exists():
        return tmux("new-window", "-d", "-t", PROBE_SESSION, "-P", "-F",
                    "#{pane_id}", launch_line).stdout.strip()
    return tmux("new-session", "-d", "-s", PROBE_SESSION, "-x", "220",
                "-y", "50", "-P", "-F", "#{pane_id}",
                launch_line).stdout.strip()


def _wait_settled(pane_id: str, timeout: float) -> bool:
    """True once the pane shows non-empty content stable across two polls."""
    prev = None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        cur = _capture_pane(pane_id).strip()
        if cur and cur == prev:
            return True
        prev = cur
        time.sleep(0.4)
    return False


def parse_probe_text(text: str) -> dict:
    """Scrape usage numbers out of TUI text. Formats are OBSERVED-ONLY (e.g.
    grok: 'Weekly limit: 18%', 'Next reset: July 13, 11:33 PT'; codex
    /status output is explicitly unstable), so every field is optional:
    percentage lines become windows, reset-ish lines are kept verbatim."""
    windows: dict[str, dict] = {}
    notes: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        low = line.lower()
        m = re.search(r"(\d{1,3}(?:\.\d+)?)\s*%", line)
        if m and any(k in low for k in ("limit", "usage", "used", "quota")):
            pct = float(m.group(1))
            # codex /status phrases these as "N% left" (remaining, not used)
            if "left" in low or "remaining" in low:
                pct = max(0.0, 100.0 - pct)
            if any(k in low for k in ("week", "7d", "7-day", "seven")):
                label = "weekly"
            elif any(k in low for k in ("5h", "5-hour", "session", "hour")):
                label = "5h"
            else:
                label = (low.split(":", 1)[0].strip()[:24] or "usage")
            windows.setdefault(label, {"used_percent": pct})
        elif "reset" in low and ":" in line:
            notes.append(line)
    return {"windows": windows, "reset_notes": notes[:4]}


def probe_provider(provider: str, spec: dict, timeout: float = 40.0
                   ) -> tuple[dict | None, str]:
    """Run one hidden probe; returns (result, "") or (None, reason). The
    probe pane is always torn down, verified, before returning."""
    pane_id = ""
    try:
        launch = " ".join(shlex.quote(a) for a in spec["argv"])
        pane_id = _open_probe_pane(launch)
        if not pane_id:
            return None, "could not open a probe pane"
        if not _wait_settled(pane_id, timeout / 2):
            return None, "the TUI never settled"
        tmux("send-keys", "-t", pane_id, "-l", "--", spec["command"],
             check=False)
        tmux("send-keys", "-t", pane_id, "C-m", check=False)
        enters_left = int(spec.get("extra_enters", 0))
        deadline = time.monotonic() + timeout / 2
        while time.monotonic() < deadline:
            time.sleep(1.0)
            parsed = parse_probe_text(_capture_pane(pane_id))
            if parsed["windows"]:
                return parsed, ""
            if enters_left > 0:  # e.g. a menu needing a confirming Enter
                tmux("send-keys", "-t", pane_id, "C-m", check=False)
                enters_left -= 1
        return None, "no usage numbers appeared before the timeout"
    except TeamctlError as exc:
        return None, str(exc)
    finally:
        # verified teardown; tmux removes the probe session automatically
        # once its last window dies.
        if pane_id and not _close_pane(pane_id):
            print(f"teamctl: warning: probe pane {pane_id} did not shut "
                  "down cleanly", file=sys.stderr)


def _save_probe_result(provider: str, result: dict) -> None:
    cache = state_path().parent / "probe-usage.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    entry = {"captured_at": time.time(), "source": "probe"}
    entry.update(result)
    data[provider] = entry
    cache.parent.mkdir(parents=True, exist_ok=True)
    tmp = cache.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(cache)


def load_probe_cache() -> dict:
    cache = state_path().parent / "probe-usage.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def probe_stale_minutes() -> int:
    raw = (load_config().get("usage") or {}).get("probe_stale_minutes", 30)
    try:
        val = int(raw)
    except (TypeError, ValueError):
        val = 30
    return max(1, val)


def _run_probes(which: str) -> int:
    """Handle `usage --probe [provider|all]`. Returns 2 on a bad target."""
    probes = probe_specs()
    if which == "claude":
        print("claude: probe skipped — the statusline cache is the "
              "documented, cheaper source (install it via `teamctl init`).")
        return 0
    if which == "all":
        targets = [p for p in probes
                   if shutil.which(probes[p]["argv"][0])]
        if not targets:
            print("no probe-able provider CLI installed.", file=sys.stderr)
    elif which in probes:
        if shutil.which(probes[which]["argv"][0]):
            targets = [which]
        else:
            targets = []
            print(f"{which}: not installed — probe skipped.", file=sys.stderr)
    else:
        print(f"teamctl: no probe defined for provider '{which}'.",
              file=sys.stderr)
        return 2
    for prov in targets:
        print(f"probing {prov} in hidden tmux session '{PROBE_SESSION}'…")
        result, err = probe_provider(prov, probes[prov])
        if result:
            _save_probe_result(prov, result)
            wins = ", ".join(f"{k} {v['used_percent']:.0f}%"
                             for k, v in result["windows"].items())
            print(f"{prov}: probe ok — {wins}")
        else:
            print(f"{prov}: probe failed ({err})")
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    """Real provider usage %/reset where the provider exposes it locally,
    gated by the provider state lattice — residual artifacts left by an
    uninstalled CLI are flagged, never rendered as a live provider. Also
    refreshes routing signals: a live provider at 100% on its 5h window is
    marked exhausted so `route` skips it until it resets."""
    if getattr(args, "probe", ""):
        rc = _run_probes(args.probe)
        if rc:
            return rc
    now = time.time()

    states = {prov: provider_state(prov) for prov in routable_providers()}
    live = {prov for prov, (st, _n) in states.items()
            if st in ("ready", "quiet")}

    codex = _known_windows("codex") if "codex" in live else {}
    pw = codex.get("5h") or {}
    if (pw.get("used_percent") or 0) >= 100 and (pw.get("resets_at") or 0) > now:
        _record_provider_signal("codex", "exhausted",
                                resets_at=pw.get("resets_at"))

    claude = _known_windows("claude") if "claude" in live else {}
    claude_captured = None
    if claude:
        cu = claude_usage()
        if cu:
            claude_captured = cu.get("captured_at")
        fh = claude.get("5h") or {}
        if (fh.get("used_percent") or 0) >= 100 \
                and (fh.get("resets_at") or 0) > now:
            _record_provider_signal("claude", "exhausted",
                                    resets_at=fh.get("resets_at"))

    probes = load_probe_cache()
    stale_after = probe_stale_minutes() * 60

    if args.json:
        # one key per routable provider: its native windows or null (the
        # spec-registry guarantee — new/custom providers appear here on
        # day one instead of being hardcoded out)
        payload: dict = {}
        for prov in states:
            wins = {"codex": codex, "claude": claude}.get(prov) or None
            if prov == "claude" and wins:
                wins = dict(wins)
                wins["captured_at"] = claude_captured
            payload[prov] = wins
        payload["probes"] = probes or None
        payload["states"] = {prov: {"state": st, "note": note or None}
                             for prov, (st, note) in states.items()}
        print(json.dumps(payload, indent=2))
        return 0

    def _stale_note(age_seconds: float) -> str:
        if age_seconds > stale_after:
            return " — stale, consider `teamctl usage --probe`"
        return ""

    native = {"codex": codex, "claude": claude}
    width = max([8] + [len(p) for p in states])
    print(f"{'PROVIDER'.ljust(width)}  USAGE")
    for prov in states:
        state, note = states[prov]
        if state == "not installed":
            print(f"{prov.ljust(width)}  not installed"
                  + (f" — {note}" if note else ""))
            continue
        if state == "locked out":
            print(f"{prov.ljust(width)}  locked out — sign in: "
                  f"`{login_hint(prov)}`")
            continue
        if state == "unknown":
            print(f"{prov.ljust(width)}  unknown — "
                  f"{note or 'auth state unreadable'}")
            continue
        wins = native.get(prov) or {}
        if wins:
            for label, w in wins.items():
                print(f"{prov.ljust(width)}  {label}: "
                      f"{w['used_percent']:.0f}% used, "
                      f"resets {_fmt_reset(w['resets_at'], now)}")
            if prov == "claude":
                if isinstance(claude_captured, (int, float)):
                    age = (_fmt_age(now - claude_captured)
                           + _stale_note(now - claude_captured))
                else:
                    age = "age unknown"
                print(f"{prov.ljust(width)}  (source: statusline cache, "
                      f"{age})")
        elif state == "ready":       # numbers live in the probe cache below
            print(f"{prov.ljust(width)}  ready — probe data below")
        elif note.startswith("auth not probed"):
            print(f"{prov.ljust(width)}  quiet — {note}")
        else:
            print(f"{prov.ljust(width)}  quiet — signed in, no usage data "
                  f"yet ({wake_hint(prov)})")

    # cached probe results — but never for an uninstalled provider (its
    # residue is already flagged above, and it is not a live provider)
    probes = {prov: entry for prov, entry in probes.items()
              if states.get(prov, ("", ""))[0] != "not installed"}
    if probes:
        print(f"\n{'PROBE':<8}  (TUI-scraped, observed-only formats)")
        for prov in sorted(probes):
            entry = probes[prov]
            if not isinstance(entry, dict):
                continue
            cap = entry.get("captured_at")
            age = (_fmt_age(now - cap) + _stale_note(now - cap)
                   if isinstance(cap, (int, float)) else "age unknown")
            windows = entry.get("windows") or {}
            for label, w in windows.items():
                if isinstance(w, dict) and w.get("used_percent") is not None:
                    print(f"{prov:<8}  {label}: {w['used_percent']:.0f}% used "
                          f"({age})")
            for note in entry.get("reset_notes") or []:
                print(f"{prov:<8}  {note}")
    _maybe_spawn_update_check()
    _print_update_notice()
    return 0


def cmd_providers(args: argparse.Namespace) -> int:
    """One lattice state per provider (see provider_state), with usage
    numbers on ready providers and cached credit/auth signals appended."""
    cached = _cached_signals()
    now = time.time()

    rows: list[tuple[str, str, str]] = []
    for prov in routable_providers():
        state, note = provider_state(prov)
        details: list[str] = []
        if state == "quiet" and note.startswith("auth not probed"):
            details.append(note)     # the honest custom-provider caveat
            note = ""
        if state == "ready":
            summary = _usage_summary(prov)
            if summary:
                details.append(summary)
        elif state == "quiet" and not details:
            details.append("signed in, no usage data yet — "
                           + wake_hint(prov))
        elif state == "locked out":
            details.append(f"sign in: `{login_hint(prov)}`")
        if note:
            details.append(note if state == "not installed" else f"({note})")
        sig_entry = cached.get(prov, {})
        sig = _live_signal(sig_entry)
        if state in ("ready", "quiet") and sig == "exhausted":
            d = f"usage limit hit (last seen {sig_entry.get('at', '?')})"
            ra = sig_entry.get("resets_at")
            if ra:
                d += f", resets {_fmt_reset(ra, now)}"
            details.append(d)
        elif state in ("ready", "quiet") and sig == "auth-error":
            details.append(f"auth error at last use "
                           f"({sig_entry.get('at', '?')}) — it may have "
                           "signed out; try it once")
        rows.append((prov, state, " · ".join(details)))

    if args.json:
        print(json.dumps({p: {"state": s, "detail": d or None}
                          for p, s, d in rows}, indent=2))
        return 0
    print(f"{'PROVIDER':<8}  STATE")
    for prov, state, detail in rows:
        print(f"{prov:<8}  {state}" + (f" — {detail}" if detail else ""))
    _maybe_spawn_update_check()
    _print_update_notice()
    return 0


def _cached_signals() -> dict:
    cache = state_path().parent / "providers.json"
    try:
        return json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}


def routing_strategy() -> str:
    """[routing] strategy: 'headroom' (default — among usable providers,
    the one with the most remaining quota wins, preference order breaking
    ties) or 'preference' (strict order, the v0.4.0 behavior)."""
    raw = (load_config().get("routing") or {}).get("strategy", "headroom")
    return raw if raw in ("headroom", "preference") else "headroom"


# headroom ranking treats a provider with NO usage data as 0% used
# (Decision D2: 'quiet' usually means genuinely idle; ranking unknowns
# last would permanently bury providers with no usage source at all,
# e.g. gemini). Preference order tie-breaks among unknowns.
UNKNOWN_USED = 0.0


def route_select(requested: list[str] | None = None
                 ) -> tuple[str | None, list[str], dict[str, str],
                            list[tuple[str, float | None, bool]]]:
    """Pick the best available provider.

    Returns (selected, preference, exclusions, ranking). exclusions maps
    each rejected candidate to a reason: unknown / not installed / locked
    out / auth unknown / exhausted / auth-error; the exclusion phase is
    identical under every strategy — ranking only ever reorders the
    SURVIVORS. ranking is the ranked survivors as (provider, used_percent
    | None, stale_probe) so the caller can show every number the choice
    used. selected is None when no candidate survives.
    """
    routable = routable_providers()
    candidates = requested if requested else list(routable)
    cached = _cached_signals()
    exclusions: dict[str, str] = {}
    survivors: list[str] = []
    for prov in candidates:
        if prov not in routable:
            exclusions[prov] = "unknown"
            continue
        if not provider_installed(prov):
            exclusions[prov] = "not installed"
            continue
        auth = provider_auth_state(prov)[0]
        # 'unprobed' (a custom provider with no auth config) stays IN:
        # the user configured it deliberately — excluding it would make
        # the escape hatch useless (the reason line notes it instead)
        if auth not in ("signed-in", "unprobed"):
            exclusions[prov] = ("locked out" if auth == "signed-out"
                                else "auth unknown")
            continue
        signal = _live_signal(cached.get(prov))
        if signal in ("exhausted", "auth-error"):
            exclusions[prov] = signal
            continue
        survivors.append(prov)

    preference = (load_config().get("routing") or {}).get("preference")
    if not isinstance(preference, list) or not preference:
        preference = list(routable)

    def _pref_key(p: str) -> tuple:
        return (preference.index(p) if p in preference else len(preference),
                survivors.index(p))

    if routing_strategy() == "headroom":
        usage = {p: _used_percent(p) for p in survivors}
        ranked = sorted(
            survivors,
            key=lambda p: (usage[p] if usage[p] is not None
                           else UNKNOWN_USED, *_pref_key(p)))
    else:                       # strict preference — the v0.4.0 ranking
        usage = {p: _used_percent(p) for p in survivors}
        ranked = sorted(survivors, key=_pref_key)

    ranking = [(p, usage[p],
                usage[p] is not None and not _known_windows(p)
                and _probe_is_stale(p))
               for p in ranked]
    return (ranked[0] if ranked else None), preference, exclusions, ranking


def cmd_route(args: argparse.Namespace) -> int:
    if _reject_bad_role(args.role):
        return 2
    requested = [p.strip() for p in args.providers.split(",") if p.strip()] \
        if args.providers else None
    selected, preference, exclusions, ranking = route_select(requested)

    if selected is None:
        print("teamctl: route found no available provider:", file=sys.stderr)
        for prov, reason in exclusions.items():
            print(f"  {prov}: {reason}", file=sys.stderr)
        return 1

    configured = (load_config().get("routing") or {}).get("preference")
    if routing_strategy() == "headroom":
        # every number the choice used, unknowns as ?%, stale flagged —
        # the pick must always be auditable
        rank_txt = " < ".join(
            f"{p} {f'{u:.0f}%' if u is not None else '?%'}"
            f"{' (stale probe)' if stale else ''}"
            for p, u, stale in ranking)
        reason = (f"headroom: {rank_txt} used · preference tiebreak "
                  f"{'>'.join(preference)}")
        if any(stale for _p, _u, stale in ranking):
            reason += " · refresh stale numbers: teamctl usage --probe"
    elif isinstance(configured, list) and configured:
        reason = f"first available in your preference {'>'.join(preference)}"
    else:
        reason = (f"first available in registry order "
                  f"{'>'.join(preference)} — an arbitrary order, not a "
                  "recommendation; set yours with `teamctl config "
                  "routing.preference ...`")
    if exclusions:
        skipped = ", ".join(f"{p}: {r}" for p, r in exclusions.items())
        reason += f"; skipped {skipped}"
    print(f"route: selected {selected} ({reason})")

    if args.dry_run:
        cwd, model, effort, task = _resolve_dispatch(
            selected, args.task, "", args.model, args.effort, args.cwd)
        argv = headless_argv(selected, task, model, effort)
        print("dry-run: " + " ".join(shlex.quote(a) for a in argv))
        return 0

    return _do_dispatch(args.role, selected, args.task, "",
                        args.model, args.effort, args.cwd,
                        getattr(args, "worktree", None))


