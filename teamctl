        print(f"created {settings_path} with a statusLine key")
        changes.append((f"created {settings_path}", f"rm {settings_path}"))


def _install_lead(changes: list[tuple[str, str]], want_hook: bool) -> None:
    selected = _lead_selected_clis("")
    if "claude" in selected:
        _lead_install_skill(changes)
    for cli in selected:
        _lead_install_block(cli, changes)
    if "claude" in selected:
        if _lead_status()["hook"] == "installed":
            print("settings.json already has a teamctl-lead hook — skipping.")
        elif want_hook:
            _lead_install_hook(changes)

# --------------------------------------------------------------------------
# `teamctl lead` — durable manager identity for a Claude Code lead agent.
#
# Three tiers, individually reversible, all marker-guarded or key-guarded:
#   1. skill      ~/.claude/skills/teamctl-lead/SKILL.md — discoverable; Claude
#                 loads it when delegation/teammate topics come up.
#   2. CLAUDE.md  a marker-guarded block — always in context at session start.
#   3. hook       a UserPromptSubmit echo in ~/.claude/settings.json — the
#                 strongest tier: its stdout is re-injected into context on
#                 every prompt, so it survives context compaction (which can
#                 drop the CLAUDE.md text from a long session).
# --------------------------------------------------------------------------

LEAD_MD_BEGIN = "<!-- BEGIN teamctl-lead -->"
LEAD_MD_END = "<!-- END teamctl-lead -->"

LEAD_CLAUDE_BLOCK = LEAD_MD_BEGIN + """
## teamctl lead mode
<!-- Added by `teamctl lead on`; remove with `teamctl lead off`. -->
You are the LEAD of a teamctl agent team (teammates run as tmux panes to
your right). Keep this chat free and responsive for the user's dynamic
tasks: delegate all non-trivial work to teammates via `teamctl
spawn`/`dispatch`/`route`. Before spawning a teammate or planning anything
large, run `teamctl usage` and `teamctl providers`, then choose
provider/model/effort from that live data, the user's preferences
(~/.config/agent-team/config.toml — see `teamctl config`), and task fit.
Use descriptive role names; never point two teammates at the same file;
land a writing teammate's worktree when it finishes (`teamctl land
<role>`); shut each teammate down (`teamctl shutdown <role>`) the moment
its job is done — zero idle teammates. Keep the toolchain current: when teamctl or
any provider CLI reports an available update, surface it to the user
promptly (e.g. `teamctl update`) instead of silently ignoring it.
Delegation posture: honor `teamctl config lead.delegation` (ask / always /
manual; missing = ask). ask = the FIRST time non-trivial work comes up in
a session, ask once whether to use teamctl agent teams (parallel
teammates; taps the user's other AI subscriptions and uses more, and
different, resources) or stay single-agent; offer to remember the answer
("always" / "never" -> `teamctl config lead.delegation always|manual`)
and do not re-ask that session. manual = single-agent unless the user
asks. Whatever the posture, a genuinely large task (multi-file,
parallelizable, long-running) earns ONE offer per session to spin up a
team — never nag; a no is final for the session. The user's explicit
instructions always override these rules.
""" + LEAD_MD_END + "\n"

LEAD_SKILL_MD = """\
---
name: teamctl-lead
description: Lead-agent discipline for running an agent team with teamctl. Use when delegating work, spawning or shutting down teammates, planning multi-agent or parallel efforts, choosing a provider/model/effort for a task, or checking team capacity, usage, and provider availability.
---

# teamctl lead mode

You are the LEAD agent of a teamctl agent team. Your pane is the user's
main chat; teammates are tmux panes tiled to your right.

## Standing rules

1. **Stay responsive.** Keep this main chat free for the user's dynamic
   tasks. Delegate all non-trivial work to teammates (`teamctl spawn`,
   `teamctl dispatch`, `teamctl route`); handle only trivial replies and
   one-line edits yourself.
2. **Decide capacity from live data, not habit.** Before spawning a
   teammate, planning a multi-agent effort, or dispatching anything large:
   run `teamctl usage` (real usage %/reset times where the provider
   exposes them) and `teamctl providers` (installed / authed / exhausted).
   Pick the provider, model, and effort from that live data, the user's
   preferences (`~/.config/agent-team/config.toml`, adjustable via
   `teamctl config`), and task fit — light/cheap models for mechanical
   work, heavyweight for hard reasoning. `teamctl route` automates the
   pick and `teamctl models` shows what each provider currently offers.
   Keep the numbers fresh: occasionally run `teamctl usage --probe all`
   (each provider's own usage command, in a hidden background tmux
   session the user never sees) — do a check-in before any large
   dispatch wave.
3. **Name teammates by role.** Descriptive role names (`code-reviewer`,
   `api-researcher`), one clear deliverable each.
4. **One owner per file.** Never point two teammates at the same file; use
   extra teammates as reviewers of a single owner's work.
5. **Zero idle teammates — and land before you leave.** A writing
   teammate's worktree branch is merged back with `teamctl land <role>`
   (review with `--dry-run` first); then shut each teammate down the
   moment its job is done (`teamctl shutdown <role>`). Shutdown never
   discards un-landed work, but landing it is your job. Check
   `teamctl status` before assuming a silent teammate is working — a
   `needs-input` teammate is blocked on an approval you can answer with
   `teamctl send`.
6. **Keep the toolchain current.** When teamctl or any provider CLI
   reports an available update, surface it to the user promptly (e.g.
   `teamctl update`) rather than silently ignoring it — and apply it only
   with the user's go-ahead.
7. **The user overrides everything.** The user's explicit instructions
   always take precedence over these rules.

## Command reference

    teamctl spawn <role> --provider claude|codex|grok|gemini [--model M] [--effort E] [--prompt TEXT]
    teamctl dispatch <role> --provider P --task "…"   # headless, watchable pane
    teamctl result <role> --wait                      # read the result back
    teamctl followup <role> --task "…"                # another turn, same session
    teamctl route <role> --task "…"                   # auto-pick: most headroom wins
    teamctl send <role> "…"                           # type into a live teammate
    teamctl status [role] [--json]                    # busy / needs-input / idle
    teamctl land <role> [--dry-run]                   # merge a worktree branch back
    teamctl worktree list|prune                       # audit teammate worktrees
    teamctl resurrect [--dry-run]                     # rebuild after a crash/reboot
    teamctl list / teamctl usage / teamctl providers
    teamctl shutdown <role>                           # always, as soon as done

## Delegation posture

Read the user's posture from `teamctl config lead.delegation`
(ask / always / manual; missing or unreadable = ask). The per-prompt hook
also echoes the live value as `delegation=<value>`.

- **always** — delegate non-trivial work to teamctl teammates by default.
- **manual** — work single-agent; use teamctl only when the user asks.
- **ask** — the FIRST time non-trivial or code-executing work comes up in
  a session, ask once, plainly: "Want me to use teamctl agent teams for
  work like this (parallel teammates, can tap your other AI
  subscriptions — uses more, and different, resources), or stick to
  regular single-agent work?" Then offer to make it permanent: "I can
  remember this — say 'always', 'never' (manual), or I'll ask again next
  session." Persist an answer with
  `teamctl config lead.delegation always|manual` and confirm it back.
  One and done — never re-ask in the same session.

**Escalation valve (all postures, including manual):** when a task is
genuinely large — multi-file, parallelizable, long-running, or one that
would block this chat for a long time — you may suggest ONCE per session:
"This is big — want me to spin up a teamctl team for it?" Never nag; a no
is final for that session.

## Chat-based settings menu

When the user asks for the teamctl menu, settings, or preferences:

1. Run `teamctl config` and read the current dotted keys.
2. Present them to the user as a numbered menu in chat.
3. Apply each change with `teamctl config <dotted.key> <value>`
   (comma-separated values become lists), then re-run `teamctl config`
   and confirm the new value back to the user before moving on.

There is also a full interactive cockpit the user can run directly in a
terminal: **`teamctl settings`** — an arrow-key dark-room editor over the
same config (space/←/→ cycle choices, enter to edit, save with backup).
Point the user at it when they'd rather drive the settings themselves;
without a TTY it prints the current values plus the matching `teamctl
config` one-liners.

## Lead mode tiers

This identity is installed by `teamctl lead on` in three tiers: this skill
(discoverable), a marker-guarded CLAUDE.md block (always in context), and a
UserPromptSubmit hook (recommended — it re-injects the standing rule on
every prompt, so it keeps firing even after context compaction drops older
text). `teamctl lead status` shows the tiers; `teamctl lead off` removes
all three.
"""

# The hook reads the LIVE delegation posture at fire time (cheap direct
# grep of config.toml; missing config -> "ask"), so the lead knows the
# current mode even after context compaction has dropped everything else.
LEAD_HOOK_COMMAND = (
    "d=$(sed -n 's/^delegation *= *\"\\(.*\\)\"/\\1/p' "
    "~/.config/agent-team/config.toml 2>/dev/null | head -1); "
    "echo \"[teamctl-lead] delegation=${d:-ask} | Standing rule: delegate "
    "non-trivial work to teamctl teammates per the posture - check teamctl "
    "usage and teamctl providers before spawning, and shut each teammate "
    "down the moment it is done.\""
)


def delegation_posture() -> str:
    """[lead] delegation: ask | always | manual (anything else -> ask)."""
    raw = (load_config().get("lead") or {}).get("delegation", "ask")
    return raw if raw in ("ask", "always", "manual") else "ask"


def _lead_hook_entry() -> dict:
    """A fresh UserPromptSubmit hook entry (nested shape per the hooks docs;
    UserPromptSubmit takes no matcher). Its stdout is added to context."""
    return {"hooks": [{"type": "command", "command": LEAD_HOOK_COMMAND}]}


def _print_controls() -> None:
    """The 'how do I drive this later' footer shown after init / lead on /
    lead status — from the shell or from a chat with a lead agent."""
    print("\nControls — adjust teamctl any time:")
    print("  from your shell:  teamctl settings           (preferences cockpit)")
    print("                    teamctl lead on|off|status  (manager identity)")
    print('  from a chat:      tell your lead agent "open the teamctl menu" —')
    print("                    with lead mode on it presents your settings and")
    print("                    applies changes via `teamctl config`.")


def _lead_paths() -> dict[str, Path]:
    home = Path.home()
    skill_dir = home / ".claude" / "skills" / "teamctl-lead"
    return {
        "skill_dir": skill_dir,
        "skill_md": skill_dir / "SKILL.md",
        "claude_md": home / ".claude" / "CLAUDE.md",
        "settings": home / ".claude" / "settings.json",
    }


# Where each CLI reads GLOBAL instructions (all officially documented):
# claude: ~/.claude/CLAUDE.md; codex: ~/.codex/AGENTS.md (global scope, read
# first); grok: ~/.grok/AGENTS.md (global rules, deeper files take
# precedence); gemini: ~/.gemini/GEMINI.md (the global context file — the
# default contextFileName, loaded for every project). The skill and hook
# tiers are Claude Code mechanisms with no equivalent elsewhere — that's
# parity with what each CLI offers, not bias.
LEAD_BLOCK_FILES: dict[str, tuple[str, str]] = {
    "claude": (".claude", "CLAUDE.md"),
    "codex": (".codex", "AGENTS.md"),
    "grok": (".grok", "AGENTS.md"),
    "gemini": (".gemini", "GEMINI.md"),
}


def _lead_block_path(cli: str) -> Path:
    d, name = LEAD_BLOCK_FILES[cli]
    return Path.home() / d / name


def _lead_selected_clis(cli_arg: str) -> list[str]:
    """--cli value -> CLIs to manage. Default: every detected CLI (falling
    back to claude when none is on PATH, so `lead on` still does something
    useful on a bare machine)."""
    if cli_arg == "all":
        return list(LEAD_BLOCK_FILES)
    if cli_arg:
        return [cli_arg]
    detected = [c for c in LEAD_BLOCK_FILES if shutil.which(c)]
    return detected or ["claude"]


def _lead_hook_indexes(data: dict) -> list[int]:
    """Indexes of hooks.UserPromptSubmit entries carrying a teamctl-lead hook."""
    entries = (data.get("hooks") or {}).get("UserPromptSubmit")
    if not isinstance(entries, list):
        return []
    found = []
    for i, entry in enumerate(entries):
        if not isinstance(entry, dict):
            continue
        hooks = entry.get("hooks")
        if not isinstance(hooks, list):
            continue
        if any(isinstance(h, dict) and "teamctl-lead" in str(h.get("command", ""))
               for h in hooks):
            found.append(i)
    return found


def _lead_install_skill(changes: list[tuple[str, str]]) -> None:
    skill_md = _lead_paths()["skill_md"]
    if skill_md.exists():
        if skill_md.read_text() == LEAD_SKILL_MD:
            print(f"{skill_md} already installed — skipping.")
            return
        bak = skill_md.with_name("SKILL.md.bak-teamctl")
        shutil.copy2(skill_md, bak)
        skill_md.write_text(LEAD_SKILL_MD)
        print(f"updated {skill_md} (previous version backed up to {bak})")
        changes.append((f"updated {skill_md}",
                        f"restore {bak}, or run `teamctl lead off`"))
        return
    skill_md.parent.mkdir(parents=True, exist_ok=True)
    skill_md.write_text(LEAD_SKILL_MD)
    print(f"installed skill {skill_md}")
    changes.append((f"installed {skill_md}", "teamctl lead off"))


def _extract_lead_block(text: str) -> str:
    """The first BEGIN..END teamctl-lead block in `text`, markers included
    (through to end-of-text if the END marker is missing), or ''."""
    out, inside = [], False
    for line in text.splitlines(keepends=True):
        if line.strip() == LEAD_MD_BEGIN:
            inside = True
        if inside:
            out.append(line)
        if inside and line.strip() == LEAD_MD_END:
            break
    return "".join(out)


def _lead_install_block(cli: str, changes: list[tuple[str, str]]) -> None:
    cm = _lead_block_path(cli)
    text = cm.read_text() if cm.exists() else ""
    if LEAD_MD_BEGIN in text:
        current = _extract_lead_block(text)
        if current.rstrip("\n") == LEAD_CLAUDE_BLOCK.rstrip("\n"):
            print(f"{cm} already contains the current teamctl-lead block "
                  "— skipping.")
            return
        # stale block from an older teamctl: refresh it in place (like the
        # skill file), leaving everything around it untouched
        bak = Path(str(cm) + ".bak-teamctl")
        shutil.copy2(cm, bak)
        replacement = (LEAD_CLAUDE_BLOCK if current.endswith("\n")
                       else LEAD_CLAUDE_BLOCK.rstrip("\n"))
        cm.write_text(text.replace(current, replacement, 1))
        print(f"updated the teamctl-lead block in {cm} (backup: {bak})")
        changes.append((f"updated the teamctl-lead block in {cm}",
                        f"restore {bak}, or run `teamctl lead off`"))
        return
    if cm.exists():
        bak = Path(str(cm) + ".bak-teamctl")
        shutil.copy2(cm, bak)
        print(f"backed up {cm} to {bak}")
    cm.parent.mkdir(parents=True, exist_ok=True)
    with open(cm, "a") as fh:
        if text and not text.endswith("\n"):
            fh.write("\n")
        if text:
            fh.write("\n")
        fh.write(LEAD_CLAUDE_BLOCK)
    print(f"appended teamctl-lead block to {cm}")
    changes.append((
        f"appended a marker-guarded block to {cm}",
        f"run `teamctl lead off`, or delete the block between the "
        f"'{LEAD_MD_BEGIN}' and '{LEAD_MD_END}' lines",
    ))


def _lead_install_hook(changes: list[tuple[str, str]]) -> None:
    sp = _lead_paths()["settings"]
    if not sp.exists():
        sp.parent.mkdir(parents=True, exist_ok=True)
        sp.write_text(json.dumps(
            {"hooks": {"UserPromptSubmit": [_lead_hook_entry()]}}, indent=2) + "\n")
        print(f"created {sp} with a teamctl-lead UserPromptSubmit hook")
        changes.append((f"created {sp}", f"teamctl lead off  (or rm {sp})"))
        return

    try:
        data = json.loads(sp.read_text())
    except (json.JSONDecodeError, OSError):
        data = None
    if not isinstance(data, dict):
        print(f"could not parse {sp} — leaving it untouched.")
        print("add this entry yourself under hooks.UserPromptSubmit:  "
              + json.dumps(_lead_hook_entry()))
        return
    if _lead_hook_indexes(data):
        print(f"{sp} already has a teamctl-lead hook — skipping.")
        return
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        print(f"'hooks' in {sp} has an unexpected shape — leaving it untouched.")
        return
    ups = hooks.setdefault("UserPromptSubmit", [])
    if not isinstance(ups, list):
        print(f"hooks.UserPromptSubmit in {sp} has an unexpected shape — "
              "leaving it untouched.")
        return
    bak = Path(str(sp) + ".bak-teamctl")
    shutil.copy2(sp, bak)
    ups.append(_lead_hook_entry())
    sp.write_text(json.dumps(data, indent=2) + "\n")
    print(f"added teamctl-lead UserPromptSubmit hook to {sp} (backup: {bak})")
    changes.append((f"added a teamctl-lead hook to {sp}",
                    f"restore {bak}, or run `teamctl lead off`"))


def _lead_remove_skill(removed: list[str], left: list[str]) -> None:
    p = _lead_paths()
    sd = p["skill_dir"]
    if not sd.exists():
        left.append(f"skill: {sd} not present")
        return
    # Back up OUTSIDE ~/.claude/skills/ so Claude Code never scans the copy.
    bak = sd.parent.parent / "teamctl-lead-skill.bak-teamctl-off"
    if bak.exists():
        shutil.rmtree(bak)
    shutil.copytree(sd, bak)
    shutil.rmtree(sd)
    removed.append(f"skill dir {sd} (backup: {bak})")


def _lead_remove_block(cli: str, removed: list[str], left: list[str]) -> None:
    cm = _lead_block_path(cli)
    if not cm.exists():
        left.append(f"{cli} block: {cm} not present")
        return
    text = cm.read_text()
    if LEAD_MD_BEGIN not in text:
        left.append(f"{cli} block: no teamctl-lead block in {cm}; left untouched")
        return
    bak = Path(str(cm) + ".bak-teamctl-off")
    shutil.copy2(cm, bak)
    kept, skip = [], False
    for line in text.splitlines(keepends=True):
        if line.strip() == LEAD_MD_BEGIN:
            skip = True
            continue
        if line.strip() == LEAD_MD_END:
            skip = False
            continue
        if not skip:
            kept.append(line)
    remainder = "".join(kept)
    if remainder.strip():
        cm.write_text(remainder.rstrip("\n") + "\n")
        removed.append(f"teamctl-lead block from {cm} "
                       f"(backup: {bak}; other content preserved)")
    else:
        cm.unlink()
        removed.append(f"{cm} (it contained only the teamctl-lead block; "
                       f"backup: {bak})")


def _lead_remove_hook(removed: list[str], left: list[str]) -> None:
    sp = _lead_paths()["settings"]
    if not sp.exists():
        left.append(f"hook: {sp} not present")
        return
    try:
        data = json.loads(sp.read_text())
    except (json.JSONDecodeError, OSError):
        data = None
    if not isinstance(data, dict):
        left.append(f"hook: could not parse {sp}; left untouched")
        return
    idx = _lead_hook_indexes(data)
    if not idx:
        left.append(f"hook: no teamctl-lead hook in {sp}; left untouched")
        return
    bak = Path(str(sp) + ".bak-teamctl-off")
    shutil.copy2(sp, bak)
    ups = data["hooks"]["UserPromptSubmit"]
    data["hooks"]["UserPromptSubmit"] = [e for i, e in enumerate(ups)
                                         if i not in idx]
    if not data["hooks"]["UserPromptSubmit"]:
        del data["hooks"]["UserPromptSubmit"]
    if not data["hooks"]:
        del data["hooks"]
    sp.write_text(json.dumps(data, indent=2) + "\n")
    removed.append(f"teamctl-lead hook from {sp} "
                   f"(backup: {bak}; other settings preserved)")


def _lead_status() -> dict:
    p = _lead_paths()
    skill = "installed" if p["skill_md"].exists() else "not installed"
    blocks: dict[str, str] = {}
    for cli in LEAD_BLOCK_FILES:
        f = _lead_block_path(cli)
        try:
            present = f.exists() and LEAD_MD_BEGIN in f.read_text()
        except OSError:
            present = False
        blocks[cli] = "installed" if present else "not installed"
    sp = p["settings"]
    if not sp.exists():
        hook = "not installed"
    else:
        try:
            data = json.loads(sp.read_text())
        except (json.JSONDecodeError, OSError):
            data = None
        if not isinstance(data, dict):
            hook = "unknown (settings.json is not parseable JSON)"
        else:
            hook = "installed" if _lead_hook_indexes(data) else "not installed"
    return {"skill": skill, "blocks": blocks, "hook": hook}


def cmd_lead(args: argparse.Namespace) -> int:
    p = _lead_paths()

    if args.action == "status":
        st = _lead_status()
        print("lead mode (manager identity) — tier status:")
        print(f"  skill         {st['skill']:<14}  {p['skill_md']} "
              "(Claude Code mechanism)")
        for cli in LEAD_BLOCK_FILES:
            print(f"  {cli + ' block':<12}  {st['blocks'][cli]:<14}  "
                  f"marker block in {_lead_block_path(cli)}")
        print(f"  hook          {st['hook']:<14}  UserPromptSubmit in "
              f"{p['settings']} (Claude Code mechanism)")
        print(f"\n  delegation posture: {delegation_posture()}   (change: "
              "teamctl config lead.delegation ask|always|manual)")
        _print_controls()
        return 0

    if args.action == "on":
        selected = _lead_selected_clis(args.cli)
        changes: list[tuple[str, str]] = []
        print("teamctl lead on — install the lead-agent identity "
              f"({', '.join(selected)}).\n")
        if "claude" in selected:
            _lead_install_skill(changes)
        for cli in selected:
            _lead_install_block(cli, changes)
        want_hook = False
        if "claude" in selected:
            if _lead_status()["hook"] == "installed":
                print(f"{p['settings']} already has a teamctl-lead hook — "
                      "skipping.")
            elif args.hook:
                want_hook = True
            else:
                print("\nRecommended: a UserPromptSubmit hook echoes a one-line")
                print("reminder into context on every prompt. It is the strongest")
                print("tier because it survives context compaction (compaction can")
                print("drop instruction-file text from a long session; the hook")
                print("re-injects the rule each turn).")
                want_hook = _ask_yn("Install the per-prompt reminder hook? [Y/n] ",
                                    default=True)
        else:
            print("(skill and hook tiers are Claude Code mechanisms; the other "
                  "CLIs have no equivalent — their block is the whole install.)")
        if want_hook:
            _lead_install_hook(changes)

        print("\nSummary of changes:")
        for what, revert in changes:
            print(f"  * {what}")
            print(f"    revert: {revert}")
        if not changes:
            print("  nothing was changed (already installed)")
        print("undo everything any time with: teamctl lead off")
        _print_controls()
        return 0

    # off: remove exactly what `on` installed, tolerating partial installs.
    # Default (and --cli all): clean up everything ever installed.
    selected = ([args.cli] if args.cli and args.cli != "all"
                else list(LEAD_BLOCK_FILES))
    removed: list[str] = []
    left: list[str] = []
    if "claude" in selected:
        _lead_remove_skill(removed, left)
    for cli in selected:
        _lead_remove_block(cli, removed, left)
    if "claude" in selected:
        _lead_remove_hook(removed, left)
    print("teamctl lead off:")
    for line in removed:
        print(f"  removed: {line}")
    for line in left:
        print(f"  left alone: {line}")
    if not removed:
        print("  nothing to remove — lead mode was not installed.")
    return 0


# --------------------------------------------------------------------------
# `teamctl statusline` — the Claude Code statusLine command. Folded into
# teamctl in v0.4.0 (previously the separate claude-statusline script):
# one binary to install, update, and uninstall. Reads the session JSON
# Claude Code pipes to stdin and prints `model · effort · ctx N%`; the
# stdin JSON also carries rate_limits.five_hour/seven_day (documented
# statusLine fields), which are cached for `teamctl usage`. This runs on
# every Claude Code render, so main() dispatches it BEFORE argparse is
# even built (~46ms end-to-end, interpreter included — measured).
# --------------------------------------------------------------------------

def _statusline_dump_usage(data: dict) -> None:
    """Best-effort cache of rate_limits for `teamctl usage`. Never raises."""
    try:
        rl = data.get("rate_limits")
        if not isinstance(rl, dict):
            return
        windows = {}
        for win in ("five_hour", "seven_day"):
            w = rl.get(win)
            if isinstance(w, dict):
                windows[win] = {"used_percentage": w.get("used_percentage"),
                                "resets_at": w.get("resets_at")}
        if not windows:
            return
        d = state_path().parent
        d.mkdir(parents=True, exist_ok=True)
        path = d / "claude-usage.json"
        tmp = Path(f"{path}.tmp{os.getpid()}")
        tmp.write_text(json.dumps({"captured_at": time.time(),
                                   "rate_limits": windows}))
        tmp.replace(path)  # atomic: readers never see a partial file
    except Exception:
        pass  # the status line must never break over caching


def cmd_statusline() -> int:
    """Print the status line from Claude Code's session JSON on stdin.

    Field sources (documented statusLine JSON): model.display_name;
    effort.level (the whole object is absent when the model has no effort
    parameter — "?" is shown); context_window.used_percentage (null early
    in a session or right after /compact — the segment is omitted rather
    than a number invented). Never raises."""
    try:
        data = json.load(sys.stdin)
    except Exception:
        print("claude · ? · ?")
        return 0
    if not isinstance(data, dict):
        print("claude · ? · ?")
        return 0
    model = (data.get("model") or {}).get("display_name") or "?"
    effort = (data.get("effort") or {}).get("level")
    parts = [model, effort or "?"]
    pct = (data.get("context_window") or {}).get("used_percentage")
    if isinstance(pct, (int, float)):
        parts.append(f"ctx {int(pct)}%")
    # else: genuinely unknown — do not fabricate a number.
    print(" · ".join(parts))
    _statusline_dump_usage(data)
    return 0


# --------------------------------------------------------------------------
# `teamctl update` — self-update from the recorded install source.
#
# install.sh records where this copy came from (install-meta.json in the
# state dir: source, repo, ref, src_dir, bin_dir, version). `update`
# re-fetches teamctl from that source and atomically replaces the
# installed copy; user config (~/.config/agent-team/) and
# state are never touched. Reachability degrades honestly, route by route:
#
#   git    fetch inside the original checkout, then read the files out of
#          FETCH_HEAD — the checkout itself is never moved or dirtied
#   gh     authenticated GitHub API raw-content fetch (private repos)
#   curl   raw.githubusercontent.com (public repos)
#   local  plain file copy from the recorded source dir (local-copy installs)
#
# Every subprocess runs with a timeout and GIT_TERMINAL_PROMPT=0 — an
# unreachable or credential-hungry source produces a reasons list, never a
# hang or a stack trace.
# --------------------------------------------------------------------------

UPDATE_FILES = ("teamctl",)   # one binary since the v0.4.0 statusline fold

UPDATE_CHECK_SECONDS = 24 * 3600      # background check: at most once a day

_VERSION_RE = re.compile(r'^VERSION = "([^"]+)"', re.M)


def install_meta_path() -> Path:
    return state_path().parent / "install-meta.json"


def load_install_meta() -> dict | None:
    try:
        data = json.loads(install_meta_path().read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def _version_key(v: str) -> tuple:
    """Sortable key: '0.4.0' > '0.4.0-dev' > '0.3.9'. Unparseable numeric
    parts count as 0; any -suffix marks a prerelease of its core."""
    core, _, suffix = str(v).partition("-")
    nums = []
    for part in core.split("."):
        try:
            nums.append(int(part))
        except ValueError:
            nums.append(0)
    while len(nums) < 3:
        nums.append(0)
    return (*nums[:3], 0 if suffix else 1)


def _source_version(text: str) -> str | None:
    m = _VERSION_RE.search(text)
    return m.group(1) if m else None


def _repo_owner_name(meta: dict) -> tuple[str, str] | None:
    m = re.search(r"github\.com[:/]([^/]+)/([^/\s]+?)(?:\.git)?/?$",
                  str(meta.get("repo") or ""))
    return (m.group(1), m.group(2)) if m else None


def _run_captured(argv: list[str], timeout: float = 30.0
                  ) -> subprocess.CompletedProcess | None:
    """subprocess.run that can never prompt or hang; None on OS failure."""
    env = dict(os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"   # a private remote must fail, not ask
    try:
        return subprocess.run(argv, capture_output=True, text=True,
                              timeout=timeout, env=env)
    except (OSError, subprocess.SubprocessError):
        return None


def _fetch_via_git(meta: dict, names: list[str]
                   ) -> tuple[dict[str, str] | None, str]:
    src = str(meta.get("src_dir") or "")
    if not src or not Path(src).is_dir():
        return None, "original checkout not found"
    ref = str(meta.get("ref") or "main")
    res = _run_captured(["git", "-C", src, "fetch", "--quiet", "origin", ref],
                        timeout=60)
    if res is None or res.returncode != 0:
        why = "git not runnable"
        if res is not None:
            tail = res.stderr.strip().splitlines()
            why = tail[-1] if tail else "git fetch failed"
        return None, f"git fetch: {why}"
    files = {}
    for name in names:
        res = _run_captured(["git", "-C", src, "show", f"FETCH_HEAD:{name}"])
        if res is None or res.returncode != 0:
            return None, f"git show FETCH_HEAD:{name} failed"
        files[name] = res.stdout
    return files, ""


def _fetch_via_gh(meta: dict, names: list[str]
                  ) -> tuple[dict[str, str] | None, str]:
    if shutil.which("gh") is None:
        return None, "gh not installed"
    repo = _repo_owner_name(meta)
    if repo is None:
        return None, "no GitHub repo recorded"
    owner, rname = repo
    ref = str(meta.get("ref") or "main")
    files = {}
    for name in names:
        res = _run_captured(
            ["gh", "api", "-H", "Accept: application/vnd.github.raw",
             f"repos/{owner}/{rname}/contents/{name}?ref={ref}"])
        if res is None or res.returncode != 0:
            why = "gh not runnable"
            if res is not None:
                head = res.stderr.strip().splitlines()
                why = head[0] if head else "gh api failed"
            return None, f"gh api: {why}"
        files[name] = res.stdout
    return files, ""


def _fetch_via_curl(meta: dict, names: list[str]
                    ) -> tuple[dict[str, str] | None, str]:
    if shutil.which("curl") is None:
        return None, "curl not installed"
    raw_base = str(meta.get("raw_base") or "")
    if not raw_base:
        repo = _repo_owner_name(meta)
        if repo is None:
            return None, "no download URL recorded"
        raw_base = (f"https://raw.githubusercontent.com/{repo[0]}/{repo[1]}"
                    f"/{meta.get('ref') or 'main'}")
    files = {}
    for name in names:
        res = _run_captured(["curl", "-fsSL", "-m", "20",
                             f"{raw_base}/{name}"])
        if res is None or res.returncode != 0:
            return None, (f"curl {raw_base}/{name} failed "
                          "(offline, or a private repo — gh handles those)")
        files[name] = res.stdout
    return files, ""


def _fetch_via_local(meta: dict, names: list[str]
                     ) -> tuple[dict[str, str] | None, str]:
    src = str(meta.get("src_dir") or "")
    if not src or not Path(src).is_dir():
        return None, "original source dir not found"
    files = {}
    for name in names:
        try:
            files[name] = (Path(src) / name).read_text()
        except OSError as exc:
            return None, f"could not read {Path(src) / name}: {exc}"
    return files, ""


def _fetch_from_source(meta: dict, names: list[str]
                       ) -> tuple[dict[str, str] | None, str, list[str]]:
    """(files, via, tried): the recorded source's route first, then the
    others; `tried` collects each failure reason for honest reporting."""
    source = str(meta.get("source") or "")
    if source == "curl":
        routes = [("curl", _fetch_via_curl), ("gh", _fetch_via_gh)]
    elif source == "local-copy":
        routes = [("local", _fetch_via_local), ("git", _fetch_via_git),
                  ("gh", _fetch_via_gh), ("curl", _fetch_via_curl)]
    else:                                  # git-clone (and anything unknown)
        routes = [("git", _fetch_via_git), ("gh", _fetch_via_gh),
                  ("curl", _fetch_via_curl)]
    tried: list[str] = []
    for via, fn in routes:
        files, why = fn(meta, names)
        if files is not None:
            return files, via, tried
        tried.append(f"{via}: {why}")
    return None, "", tried


def _installed_version(bin_dir: Path) -> str:
    """Version of the installed copy (falling back to this running one)."""
    try:
        v = _source_version((bin_dir / "teamctl").read_text())
        if v:
            return v
    except OSError:
        pass
    return VERSION


def _apply_update(meta: dict, files: dict[str, str]) -> Path:
    """Atomically replace the installed artifacts; returns the bin dir.
    Refuses a download that does not compile. Config/state untouched."""
    compile(files["teamctl"], "teamctl", "exec")
    bin_dir = Path(str(meta.get("bin_dir") or "~/.local/bin")).expanduser()
    bin_dir.mkdir(parents=True, exist_ok=True)
    for name, text in files.items():
        dest = bin_dir / name
        tmp = dest.with_name(dest.name + ".tmp-update")
        tmp.write_text(text)
        os.chmod(tmp, 0o755)
        tmp.replace(dest)
    meta = dict(meta)
    meta["version"] = _source_version(files["teamctl"]) or meta.get("version")
    meta["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    mp = install_meta_path()
    mp.parent.mkdir(parents=True, exist_ok=True)
    mp.write_text(json.dumps(meta, indent=2, sort_keys=True) + "\n")
    # migrate anything a pre-fold install left behind (old statusline
    # wiring + orphaned script) — updating IS the migration moment
    for note in _migrate_legacy_statusline(bin_dir):
        print(note)
    return bin_dir


# ---- the once-a-day background check and its one unobtrusive line --------

def update_cache_path() -> Path:
    return state_path().parent / "update-check.json"


def _read_update_cache() -> dict:
    try:
        data = json.loads(update_cache_path().read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def _write_update_cache(latest: str | None) -> None:
    """Stamp a check; keep the last known `latest` when none was learned.
    Best-effort — a cache failure must never break the caller."""
    try:
        entry: dict = {"checked_at": time.time()}
        known = latest or _read_update_cache().get("latest")
        if known:
            entry["latest"] = known
        p = update_cache_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(entry))
        tmp.replace(p)
    except OSError:
        pass


def update_settings() -> tuple[bool, str]:
    """[update]: check = true|false (default true) and mode = prompt |
    auto | off (default prompt). prompt = one quiet line when newer
    exists; auto = apply it at session start (explicit opt-in — never the
    default); off = never mention updates. check=false disables the
    background check entirely."""
    upd = load_config().get("update") or {}
    check = upd.get("check", True)
    if not isinstance(check, bool):
        check = str(check).strip().lower() not in ("false", "0", "no", "off")
    mode = str(upd.get("mode", "prompt")).strip().lower()
    if mode not in ("prompt", "auto", "off"):
        mode = "prompt"
    return check, mode


def _maybe_spawn_update_check() -> None:
    """Background version check: at most once a day, fully detached,
    silent on every failure, never blocking the caller. No-op when
    disabled ([update]) or when this copy has no recorded install
    source."""
    check, mode = update_settings()
    if not check or mode == "off":
        return
    if load_install_meta() is None:
        return
    cache = _read_update_cache()
    if time.time() - (cache.get("checked_at") or 0) < UPDATE_CHECK_SECONDS:
        return
    _write_update_cache(None)   # stamp first: a failure must not retry-storm
    try:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()),
             "update", "--refresh-cache"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def _update_notice() -> str | None:
    """One line when the cached daily check knows a newer version."""
    _check, mode = update_settings()
    if mode == "off":
        return None
    latest = _read_update_cache().get("latest")
    if latest and _version_key(str(latest)) > _version_key(VERSION):
        return f"teamctl {latest} available — teamctl update"
    return None


def _print_update_notice() -> None:
    """The quiet footer line for providers/usage (prompt mode only)."""
    _check, mode = update_settings()
    if mode != "prompt":
        return
    notice = _update_notice()
    if notice:
        print(_fg("dim", f"\n· {notice}"))


def _session_update_line() -> str | None:
    """Session-start line for the init frame. prompt: the invitation.
    auto: actually apply the known-newer version, quietly, and report in
    one line — degrading to the invitation when the source is
    unreachable."""
    notice = _update_notice()
    if notice is None:
        return None
    _check, mode = update_settings()
    if mode != "auto":
        return notice
    meta = load_install_meta()
    if meta is None:
        return notice
    files, _via, _tried = _fetch_from_source(meta, list(UPDATE_FILES))
    if not files:
        return notice + " (auto-update could not reach the source)"
    latest = _source_version(files["teamctl"])
    bin_dir = Path(str(meta.get("bin_dir") or "~/.local/bin")).expanduser()
    if not latest or _version_key(latest) <= _version_key(
            _installed_version(bin_dir)):
        _write_update_cache(latest)
        return None
    try:
        _apply_update(meta, files)
    except (OSError, SyntaxError, ValueError):
        return notice + " (auto-update failed — run it by hand)"
    _write_update_cache(latest)
    return f"auto-updated teamctl → {latest}"


def cmd_update(args: argparse.Namespace) -> int:
    meta = load_install_meta()

    if getattr(args, "refresh_cache", False):
        # hidden flag: the detached daily check. Silent; always exits 0.
        if meta is not None:
            files, _via, _tried = _fetch_from_source(meta, ["teamctl"])
            if files:
                _write_update_cache(_source_version(files["teamctl"]))
        return 0

    if meta is None:
        print("teamctl: no install metadata found — this copy predates "
              "`teamctl update` or was not installed by install.sh.\n"
              "Re-run the installer once from your original source (it now "
              "records the source, so future updates are one command):\n"
              "  ./install.sh --no-init            # from a checkout\n"
              "  curl -fsSL <install.sh url> | bash -s -- --no-init",
              file=sys.stderr)
        return 1

    bin_dir = Path(str(meta.get("bin_dir") or "~/.local/bin")).expanduser()
    installed = _installed_version(bin_dir)
    names = ["teamctl"] if args.check else list(UPDATE_FILES)
    files, via, tried = _fetch_from_source(meta, names)
    if files is None:
        print(f"teamctl: could not reach the install source "
              f"({meta.get('source', '?')}):", file=sys.stderr)
        for reason in tried:
            print(f"  {reason}", file=sys.stderr)
        print("  the installed copy is untouched.", file=sys.stderr)
        return 1
    latest = _source_version(files["teamctl"])
    if not latest:
        print("teamctl: the fetched teamctl has no version string — "
              "refusing to install it.", file=sys.stderr)
        return 1
    _write_update_cache(latest)

    if args.check:
        print(f"installed {installed} · latest {latest} (via {via})")
        if _version_key(latest) > _version_key(installed):
            print("update available — run `teamctl update`")
        else:
            print("up to date")
        return 0

    if _version_key(latest) <= _version_key(installed):
        print(f"already up to date (installed {installed}, "
              f"latest {latest} via {via})")
        return 0
    try:
        bin_dir = _apply_update(meta, files)
    except (SyntaxError, ValueError):
        print("teamctl: the fetched teamctl does not compile — refusing to "
              "install it. The installed copy is untouched.", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"teamctl: could not write the update: {exc}", file=sys.stderr)
        return 1
    print(f"updated teamctl {installed} {_out_glyphs()['arrow']} {latest} "
          f"in {bin_dir} (via {via})")
    print("config and state untouched (~/.config/agent-team, "
          "~/.local/state/agent-team)")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    """Reverse what install.sh and `teamctl init` set up: the installed
    binary (plus a legacy claude-statusline), the ~/.tmux.conf marker
    block, our statusLine wiring, and the install/update metadata —
    backups first, exactly like the installer made them. Config, state,
    and lead mode are left in place, with their removal commands printed
    (`teamctl lead off` reverses lead mode on its own)."""
    meta = load_install_meta() or {}
    bin_dir = Path(str(meta.get("bin_dir") or "~/.local/bin")).expanduser()
    if not getattr(args, "yes", False):
        if not _ask_yn(f"remove teamctl from {bin_dir}? [y/N] "):
            print("nothing removed.")
            return 0

    removed: list[str] = []
    left: list[str] = []

    # 1. binaries (claude-statusline is the pre-v0.4.0 companion script)
    for name in ("teamctl", "claude-statusline"):
        p = bin_dir / name
        try:
            if p.exists():
                p.unlink()
                removed.append(str(p))
        except OSError as exc:
            left.append(f"{p}: {exc}")

    # 2. tmux marker block
    conf = Path.home() / ".tmux.conf"
    try:
        text = conf.read_text() if conf.exists() else ""
    except OSError:
        text = ""
    if TMUX_MARKER_BEGIN in text:
        bak = Path(str(conf) + ".bak-teamctl-uninstall")
        shutil.copy2(conf, bak)
        kept, skip = [], False
        for line in text.splitlines(keepends=True):
            if line.strip() == TMUX_MARKER_BEGIN:
                skip = True
                continue
            if line.strip() == TMUX_MARKER_END:
                skip = False
                continue
            if not skip:
                kept.append(line)
        conf.write_text("".join(kept))
        removed.append(f"teamctl block from {conf} (backup: {bak})")
        print("if tmux is running, reload the config and reset the options "
              "the block set:")
        print("  tmux source-file ~/.tmux.conf")
        print("  tmux set-option -gu pane-border-status; "
              "tmux set-option -gu pane-border-format")
        print("  tmux set-option -gu status-right; "
              "tmux set-option -gu @teamctl_status_added")

    # 3. statusLine key — only if it points at teamctl (any era)
    sp = Path.home() / ".claude" / "settings.json"
    if sp.exists():
        try:
            data = json.loads(sp.read_text())
        except (json.JSONDecodeError, OSError):
            data = None
        if not isinstance(data, dict):
            left.append(f"could not parse {sp}; left untouched")
        else:
            sl = data.get("statusLine")
            if isinstance(sl, dict) \
                    and sl.get("command") in _our_statusline_commands():
                bak = Path(str(sp) + ".bak-teamctl-uninstall")
                shutil.copy2(sp, bak)
                del data["statusLine"]
                sp.write_text(json.dumps(data, indent=2) + "\n")
                removed.append(f"statusLine key from {sp} (backup: {bak})")
            elif "statusLine" in data:
                left.append(f"statusLine in {sp} is not teamctl's; "
                            "left untouched")

    # 4. install/update metadata (written by install.sh / the update check)
    for p in (install_meta_path(), update_cache_path()):
        try:
            if p.exists():
                p.unlink()
                removed.append(str(p))
        except OSError as exc:
            left.append(f"{p}: {exc}")

    print("teamctl uninstall:")
    for line in removed:
        print(f"  removed: {line}")
    for line in left:
        print(f"  left alone: {line}")
    if not removed:
        print("  nothing to remove.")
    print("note: lead mode (if installed) reverses with `teamctl lead off` "
          "— run it BEFORE deleting the binary next time, or remove the "
          "marker blocks by hand.")
    print("note: per-user data was left in place; remove it with:")
    print("  rm -rf ~/.config/agent-team ~/.local/state/agent-team")
    return 0


# --------------------------------------------------------------------------
# bare `teamctl` — the front door. With no subcommand on a real terminal it
# launches the user's default lead session: the default chat provider,
# model, and effort (from [lead] chat_* in config, falling back to the
# routing preference), with lead mode enabled, in the teamctl tmux session.
# Provider-agnostic: whichever CLI the user prefers becomes the front door.
# --------------------------------------------------------------------------

def _chat_defaults() -> tuple[str, str, str]:
    """([lead] chat_provider, chat_model, chat_effort) from config."""
    lead = load_config().get("lead") or {}
    return (str(lead.get("chat_provider") or ""),
            str(lead.get("chat_model") or ""),
            str(lead.get("chat_effort") or ""))


def _resolve_chat() -> tuple[str | None, str, str, str]:
    """Resolve the lead chat as (provider, model, effort, error).

    provider is None with a human error when there is no honest default or
    the chosen provider isn't ready (not installed / locked out / unknown)
    — the message names the fix, never a stack trace."""
    prov, model, effort = _chat_defaults()
    if prov and provider_spec(prov) is None:
        return None, "", "", (f"[lead] chat_provider is '{prov}', which is "
                              "not a known provider — fix it with `teamctl "
                              "settings` or `teamctl config lead.chat_provider "
                              f"{'|'.join(routable_providers())}`.")
    if not prov:
        prov = default_provider()
    if prov is None:
        avail = [p for p in routable_providers() if provider_state(p)[0] in
                 ("ready", "quiet")]
        if avail:
            return None, "", "", (
                "no default chat provider set and several are available "
                f"({', '.join(avail)}). Pick one: `teamctl config "
                "lead.chat_provider <name>` (or `teamctl settings`).")
        return None, "", "", (
            "no provider is signed in. Sign one in, then run `teamctl` "
            "again — see `teamctl providers`.")

    state, _note = provider_state(prov)
    if state == "not installed":
        return None, "", "", (
            f"{prov} is not installed. Install it (see `teamctl providers`), "
            "or pick another with `teamctl config lead.chat_provider <name>`.")
    if state == "locked out":
        return None, "", "", (
            f"{prov} is installed but signed out — sign in with "
            f"`{login_hint(prov)}`, then run `teamctl`.")
    if state == "unknown":
        return None, "", "", (
            f"{prov}'s login state can't be read — check the CLI, or pick "
            "another with `teamctl config lead.chat_provider <name>`.")

    d_model, d_effort = provider_defaults(prov)
    return prov, (model or d_model or ""), (effort or d_effort or ""), ""


def _launch_plan(in_tmux_flag: bool, provider: str, model: str,
                 effort: str, cwd: str) -> dict:
    """Pure description of how the launcher would start the lead chat, so
    the decision is testable without exec'ing anything.

    mode 'exec' — already in tmux: replace this process with the provider
    CLI (the front door IS the lead chat). mode 'new-session' — outside
    tmux: attach-or-create the 'teamctl' session running the provider."""
    argv = list(PROVIDERS[provider]) + interactive_flags(provider, model,
                                                          effort)
    if in_tmux_flag:
        return {"mode": "exec", "argv": argv, "provider": provider,
                "model": model, "effort": effort}
    launch = build_launch_line(provider, "", cwd, model, effort)
    return {"mode": "new-session", "session": "teamctl", "launch": launch,
            "argv": ["tmux", "new-session", "-A", "-s", "teamctl", launch],
            "provider": provider, "model": model, "effort": effort}


def _ensure_lead_mode(provider: str) -> None:
    """Enable lead mode for the chat provider if it isn't already — the
    front door is the full team-lead experience. Idempotent and quiet;
    installs only the block (plus the skill for claude), never the
    interactive hook prompt."""
    status = _lead_status()
    if status["blocks"].get(provider) == "installed":
        return
    changes: list[tuple[str, str]] = []
    if provider == "claude" and status["skill"] != "installed":
        _lead_install_skill(changes)
    _lead_install_block(provider, changes)
    if changes:
        print(_fg("dim", f"· enabled lead mode for {provider} "
                         "(reverse: teamctl lead off)"))


def cmd_launch(args: argparse.Namespace) -> int:
    """Bare `teamctl`: open the default lead session."""
    # first run with no config → funnel through express init, then launch
    if not config_path().exists():
        print(_fg("dim", "first run — configuring defaults…\n"))
        _init_express(argparse.Namespace(custom=False, yes=False))
        print()

    # a reboot/crash killed the roster? say so at the front door — the
    # reconcile here is what moves dead-pane teammates into the lost
    # record after a reboot. Never auto-resurrects: consent first.
    try:
        with state_lock():
            state = reconcile(load_state())
        lost = state.get("lost") or {}
        if lost:
            print(_fg("warn", f"· {len(lost)} teammate(s) lost in a "
                              f"crash/reboot ({', '.join(sorted(lost))}) "
                              "— rebuild: teamctl resurrect "
                              "(preview: --dry-run)"))
    except TeamctlError:
        pass    # no tmux yet — the launch path below explains that itself

    provider, model, effort, err = _resolve_chat()
    if provider is None:
        print(f"teamctl: {err}", file=sys.stderr)
        return 1

    cwd = os.getcwd()
    plan = _launch_plan(in_tmux(), provider, model, effort, cwd)

    if getattr(args, "dry_run", False):
        tag = f"{provider}" + (f"/{model}" if model else "")
        if plan["mode"] == "exec":
            print(f"launch: {tag} in this tmux pane (lead chat)")
        else:
            print(f"launch: {tag} in tmux session 'teamctl'")
        print("  " + " ".join(shlex.quote(a) for a in plan["argv"]))
        return 0

    _maybe_spawn_update_check()
    _ensure_lead_mode(provider)

    if plan["mode"] == "new-session" and shutil.which("tmux") is None:
        print("teamctl: tmux is not installed — the lead session needs it. "
              "Install tmux, or run your provider CLI directly.",
              file=sys.stderr)
        return 2
    try:
        os.execvp(plan["argv"][0], plan["argv"])
    except OSError as exc:                         # pragma: no cover - exec
        print(f"teamctl: could not launch {provider}: {exc}", file=sys.stderr)
        return 2


# --------------------------------------------------------------------------
# `teamctl doctor` — one-shot environment health check. Each check returns
# ("ok" | "warn" | "fail", detail); the worst status sets the exit code
# (ok 0, warn 1, fail 2). The check functions are pure enough to test with
# a sandboxed HOME + monkeypatched `which`.
# --------------------------------------------------------------------------

def wsl_environment(osrelease: str = "/proc/sys/kernel/osrelease",
                    version: str = "/proc/version") -> str | None:
    """'WSL2 (Ubuntu)' / 'WSL (Ubuntu)' / 'WSL2' / None.

    WSL presents as Linux and teamctl is SUPPORTED there — this is
    awareness (doctor's environment line, the installer's greeting),
    never gating. Signal: /proc/sys/kernel/osrelease and /proc/version
    carry 'microsoft' ('…-microsoft-standard-WSL2' on WSL2,
    '…-Microsoft' on WSL1 — the documented kernel strings).
    WSL_DISTRO_NAME only NAMES the distro; a stray env var alone must
    never claim WSL. The paths are parameters purely as a test seam."""
    text = ""
    for p in (osrelease, version):
        try:
            text += Path(p).read_text()
        except OSError:
            continue
    low = text.lower()
    if "microsoft" not in low:
        return None
    tag = "WSL2" if "wsl2" in low else "WSL"
    distro = os.environ.get("WSL_DISTRO_NAME", "").strip()
    return f"{tag} ({distro})" if distro else tag


def _check_environment() -> tuple[str, str]:
    """Where teamctl is running. WSL runs as Linux and is supported; its
    one genuine rough edge — provider browser sign-ins from a GUI-less
    shell — gets pre-empted here."""
    wsl = wsl_environment()
    if wsl:
        return "ok", (f"{wsl} — supported, runs as Linux. Provider "
                      "browser sign-ins open via Windows interop; if one "
                      "stalls, copy the printed URL into a Windows "
                      "browser yourself")
    return "ok", sys.platform


def _tmux_version() -> str | None:
    if shutil.which("tmux") is None:
        return None
    try:
        out = subprocess.run(["tmux", "-V"], capture_output=True, text=True,
                             timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"(\d+\.\d+[a-z]?)", out.stdout)
    return m.group(1) if m else None


def _check_python() -> tuple[str, str]:
    v = sys.version_info
    label = f"{v.major}.{v.minor}.{v.micro}"
    if v >= (3, 11):
        return "ok", f"{label} (tomllib present)"
    return "fail", f"{label} — teamctl needs 3.11+ (tomllib)"


def _check_tmux() -> tuple[str, str]:
    ver = _tmux_version()
    if ver is None:
        if shutil.which("tmux") is None:
            return "fail", "not installed — teamctl needs tmux"
        return "warn", "installed but `tmux -V` did not report a version"
    # known-quirk learnings encoded as advice, not failures — teamctl
    # already works around both (per-pane @options for labels; the
    # read-write tty fd in the installer):
    #  - some 3.x builds don't execute #() in status formats (we use
    #    @role/@model user options, so labels render regardless)
    num = re.match(r"(\d+)\.(\d+)", ver)
    if num and (int(num.group(1)), int(num.group(2))) < (2, 9):
        return "warn", (f"{ver} — old; `resize-window` is a no-op pre-2.9, "
                        "so test panes may be cramped")
    return "ok", f"{ver}"


def _check_providers() -> tuple[str, str]:
    states = {p: provider_state(p)[0] for p in routable_providers()}
    usable = [p for p, s in states.items() if s in ("ready", "quiet")]
    locked = [p for p, s in states.items() if s == "locked out"]
    if usable:
        parts = [f"{p} {states[p]}" for p in states
                 if states[p] != "not installed"]
        return "ok", "; ".join(parts) or ", ".join(usable)
    if locked:
        return "warn", (f"installed but signed out: {', '.join(locked)} — "
                        "sign one in")
    return "fail", "no provider installed and signed in"


def _check_config() -> tuple[str, str]:
    path = config_path()
    if not path.exists():
        return "warn", "no config yet — run `teamctl init`"
    if tomllib is None:
        return "warn", "cannot parse (Python < 3.11)"
    try:
        data = tomllib.loads(path.read_text())
    except (OSError, ValueError) as exc:
        return "fail", f"does not parse: {exc}"
    # schema sanity: known enums / ranges
    problems = []
    checks = [
        (("lead", "delegation"), ("ask", "always", "manual")),
        (("output", "verbosity"), ("normal", "terse", "detailed")),
        (("update", "mode"), ("prompt", "auto", "off")),
        (("routing", "strategy"), ("headroom", "preference")),
        (("worktree", "cleanup"), ("auto", "keep")),
    ]
    for (sec, key), allowed in checks:
        v = (data.get(sec) or {}).get(key)
        if v is not None and v not in allowed:
            problems.append(f"{sec}.{key}={v!r} not in {'/'.join(allowed)}")
    lw = (data.get("layout") or {}).get("lead_width")
    if isinstance(lw, int) and not (20 <= lw <= 80):
        problems.append(f"layout.lead_width={lw} outside 20-80 (clamped)")
    if problems:
        return "warn", "; ".join(problems)
    return "ok", f"parses, schema sane ({_tilde(path)})"


def _check_statusline() -> tuple[str, str]:
    if shutil.which("claude") is None:
        return "ok", "n/a (Claude Code not installed)"
    sp = Path.home() / ".claude" / "settings.json"
    if not sp.exists():
        return "warn", "Claude Code has no settings.json — `teamctl init` "\
                       "wires the statusline"
    try:
        data = json.loads(sp.read_text())
    except (OSError, json.JSONDecodeError):
        return "warn", f"{_tilde(sp)} is not parseable JSON"
    sl = data.get("statusLine")
    cmd = sl.get("command") if isinstance(sl, dict) else None
    if cmd == STATUSLINE_ENTRY["command"] or cmd == \
            str(Path.home() / ".local" / "bin" / "teamctl") + " statusline":
        return "ok", "wired to `teamctl statusline`"
    if cmd in _legacy_statusline_commands():
        return "warn", "wired to the pre-v0.4.0 script — `teamctl update` "\
                       "migrates it"
    if cmd:
        return "ok", "a non-teamctl statusLine is set (left alone)"
    return "warn", "not wired — `teamctl init` adds it"


def _check_install_meta() -> tuple[str, str]:
    if load_install_meta() is not None:
        return "ok", "recorded — `teamctl update` knows the source"
    return "warn", "missing — re-run install.sh so `teamctl update` works"


def _check_lost() -> tuple[str, str]:
    """Teammates lost to a crash/reboot, waiting for `teamctl resurrect`."""
    lost = load_state().get("lost") or {}
    if lost:
        names = ", ".join(sorted(lost)[:4]) + ("…" if len(lost) > 4 else "")
        return "warn", (f"{len(lost)} lost teammate(s) ({names}) — "
                        "rebuild with `teamctl resurrect`")
    return "ok", "none"


def _check_worktrees() -> tuple[str, str]:
    """Orphaned teamctl worktrees (owner gone, work possibly un-landed)."""
    reg = load_worktree_registry()
    if not reg:
        return "ok", "none"
    try:
        state = load_state()
    except Exception:
        state = {"teammates": {}}
    owned = {i.get("worktree", {}).get("path")
             for i in state["teammates"].values() if i.get("worktree")}
    orphans = [e.get("role", "?") for p, e in reg.items() if p not in owned]
    if orphans:
        return "warn", (f"{len(orphans)} orphaned worktree(s) "
                        f"({', '.join(sorted(orphans)[:4])}"
                        f"{'…' if len(orphans) > 4 else ''}) — "
                        "`teamctl worktree list`, land or prune")
    return "ok", f"{len(reg)} active, none orphaned"


def _check_state_dir() -> tuple[str, str]:
    d = state_path().parent
    try:
        d.mkdir(parents=True, exist_ok=True)
        probe = d / ".doctor-write-probe"
        probe.write_text("x")
        probe.unlink()
        return "ok", f"writable ({_tilde(d)})"
    except OSError as exc:
        return "fail", f"not writable: {exc}"


_DOCTOR_CHECKS = (
    ("environment", _check_environment),
    ("python", _check_python),
    ("tmux", _check_tmux),
    ("providers", _check_providers),
    ("config", _check_config),
    ("statusline", _check_statusline),
    ("install source", _check_install_meta),
    ("state dir", _check_state_dir),
    ("worktrees", _check_worktrees),
    ("lost teammates", _check_lost),
)


def doctor_report() -> list[tuple[str, str, str]]:
    """Run every check; list of (name, status, detail). Pure enough to test
    against a sandboxed HOME."""
    out = []
    for name, fn in _DOCTOR_CHECKS:
        try:
            status, detail = fn()
        except Exception as exc:                   # a check must never crash
            status, detail = "warn", f"check errored: {exc}"
        out.append((name, status, detail))
    return out


def cmd_doctor(args: argparse.Namespace) -> int:
    rows = doctor_report()
    g = _out_glyphs()
    mark = {"ok": ("ok", g["dot"]), "warn": ("warn", "!"),
            "fail": ("bad", g["chev"])}
    print(_fg("accent", "teamctl doctor") + _fg("dim", "  · environment "
                                                "health"))
    print()
    for name, status, detail in rows:
        role, glyph = mark.get(status, ("dim", "?"))
        print("  " + _fg(role, f"{glyph} {status:<4}")
              + _fg("primary", f" {name:<15}") + _fg("dim", detail))
    worst = "ok"
    for _n, status, _d in rows:
        if status == "fail":
            worst = "fail"
            break
        if status == "warn":
            worst = "warn"
    print()
    if worst == "ok":
        print("  " + _fg("ok", "all good."))
        return 0
    if worst == "warn":
        print("  " + _fg("warn", "usable, with advisories above."))
        return 1
    print("  " + _fg("bad", "something is broken — see the failures above."))
    return 2


# --------------------------------------------------------------------------
# `teamctl config` — show and adjust ~/.config/agent-team/config.toml
# --------------------------------------------------------------------------

_MISSING = object()

CONFIG_HEADER = [
    "# agent-team configuration (managed by `teamctl init` / `teamctl config`)",
    "# Delete this file to fall back to each provider CLI's own defaults.",
]


def _toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_value(x) for x in v) + "]"
    return f'"{_toml_escape(str(v))}"'


def _toml_key(k: str) -> str:
    if k and all(c.isalnum() or c in "-_" for c in k):
        return k
    return f'"{_toml_escape(k)}"'


def _dump_toml(data: dict, prefix: str = "") -> list[str]:
    """Render a nested dict as TOML lines (strings, numbers, bools, lists)."""
    lines = []
    for k, v in data.items():
        if not isinstance(v, dict):
            lines.append(f"{_toml_key(k)} = {_toml_value(v)}")
    for k, v in data.items():
        if isinstance(v, dict):
            name = f"{prefix}.{_toml_key(k)}" if prefix else _toml_key(k)
            # A [header] is only needed when the table holds direct values
            # (or is empty and would otherwise vanish); a table that only
            # groups sub-tables is implied by their [a.b] headers.
            if any(not isinstance(x, dict) for x in v.values()) or not v:
                lines.append("")
                lines.append(f"[{name}]")
            lines.extend(_dump_toml(v, name))
    return lines


def _flatten_config(data: dict, prefix: str = "") -> list[tuple[str, object]]:
    out = []
    for k, v in data.items():
        dk = f"{prefix}.{k}" if prefix else k
        if isinstance(v, dict):
            out.extend(_flatten_config(v, dk))
        else:
            out.append((dk, v))
    return out


def _get_dotted(data: dict, dotted: str):
    cur = data
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return _MISSING
        cur = cur[part]
    return cur


def _set_dotted(data: dict, dotted: str, value) -> None:
    parts = [p for p in dotted.split(".") if p]
    if not parts:
        raise TeamctlError("empty config key")
    cur = data
    for i, part in enumerate(parts[:-1]):
        nxt = cur.get(part)
        if nxt is None:
            nxt = cur[part] = {}
        if not isinstance(nxt, dict):
            raise TeamctlError(
                f"config key '{'.'.join(parts[:i + 1])}' holds a value, not a "
                f"table; cannot set '{dotted}' beneath it")
        cur = nxt
    leaf = parts[-1]
    if isinstance(cur.get(leaf), dict):
        raise TeamctlError(
            f"'{dotted}' is a table, not a value; set one of its keys instead "
            f"(e.g. {dotted}.model)")
    cur[leaf] = value


def _parse_config_value(key: str, raw: str):
    """CLI string -> config value. Comma-separated (or routing.preference)
    becomes a list of strings; true/false a bool; a bare integer an int
    (e.g. layout.lead_width); everything else a string."""
    raw = raw.strip()
    if key == "routing.preference" or "," in raw:
        return [s.strip() for s in raw.split(",") if s.strip()]
    if raw.lower() in ("true", "false"):
        return raw.lower() == "true"
    if raw.isdigit() or (raw.startswith("-") and raw[1:].isdigit()):
        return int(raw)
    return raw


def _load_config_strict(path: Path) -> dict:
    """Parse config.toml, refusing (not silently discarding) on bad TOML."""
    if tomllib is None:
        raise TeamctlError("config support needs Python 3.11+ (tomllib)")
    try:
        return tomllib.loads(path.read_text())
    except OSError as exc:
        raise TeamctlError(f"could not read {path}: {exc}")
    except ValueError as exc:  # tomllib.TOMLDecodeError subclasses ValueError
        raise TeamctlError(
            f"could not parse {path}: {exc}. Fix the file or re-run "
            "`teamctl init` to rewrite it.")


def _write_config_file(data: dict) -> Path | None:
    """Rewrite config.toml from `data`, backing up any existing file first.
    Returns the backup path, or None if there was nothing to back up. The
    write is atomic (tmp + replace) so a crash mid-write can never leave a
    truncated config."""
    path = config_path()
    bak = None
    if path.exists():
        bak = path.with_name("config.toml.bak-teamctl")
        shutil.copy2(path, bak)
    path.parent.mkdir(parents=True, exist_ok=True)
    body = "\n".join(CONFIG_HEADER + _dump_toml(data)).rstrip("\n") + "\n"
    tmp = path.with_suffix(".toml.tmp")
    tmp.write_text(body)
    tmp.replace(path)   # atomic: readers/crashes never see a partial file
    return bak


# enum-valued config keys the rich menu can cycle with Left/Right; anything
# else gets a free-text edit (parsed exactly like `teamctl config k v`).
_MENU_ENUMS: dict[str, tuple[str, ...]] = {
    "lead.delegation": ("ask", "always", "manual"),
    "output.verbosity": ("normal", "terse", "detailed"),
    "update.mode": ("prompt", "auto", "off"),
    "routing.strategy": ("headroom", "preference"),
    "worktree.cleanup": ("auto", "keep"),
}


def _menu_choices(key: str, val) -> list | None:
    """Cycle options for a config key, or None for free-text editing."""
    if key in _MENU_ENUMS:
        return list(_MENU_ENUMS[key])
    if key.startswith("providers.") and key.endswith(".effort"):
        return list(EFFORT_CHOICES)
    if key == "routing.preference" and isinstance(val, list) \
            and 1 < len(val) <= 3:
        return [list(p) for p in itertools.permutations(val)]
    if isinstance(val, bool):
        return [True, False]
    return None


def _config_menu_curses(path: Path) -> int | None:
    """Arrow-key settings editor; returns an exit code, or None when curses
    could not run (caller falls back to the numbered line menu)."""
    data = _load_config_strict(path)
    dirty = False

    def run(stdscr):
        nonlocal dirty
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        _curses_colors()
        g = _ui_glyphs()
        sel = 0
        while True:
            flat = _flatten_config(data)
            if not flat:
                return "empty"
            sel = max(0, min(sel, len(flat) - 1))
            h, w = stdscr.getmaxyx()
            if h < len(flat) + 7 or w < 64:
                raise _RichUnusable("terminal too small")
            stdscr.erase()
            box_w = min(w - 3, 92)
            box_h = len(flat) + 3
            try:
                curses.textpad.rectangle(stdscr, 1, 1, 1 + box_h, 1 + box_w)
            except curses.error:
                pass
            _addstr(stdscr, 1, 3, f" teamctl settings · {path} ",
                    _pair(1) | curses.A_BOLD)
            for i, (key, val) in enumerate(flat):
                sel_here = (i == sel)
                marker = g["sel"] if sel_here else "  "
                left = f"{marker}{key:<28}"
                _addstr(stdscr, 3 + i, 4, left,
                        curses.A_REVERSE if sel_here else curses.A_NORMAL)
                _addstr(stdscr, 3 + i, 4 + len(left), _toml_value(val),
                        (curses.A_REVERSE | curses.A_BOLD) if sel_here
                        else _pair(2))
            cyc = _menu_choices(*flat[sel]) is not None
            _addstr(stdscr, 1 + box_h + 1, 3,
                    ("Left/Right cycle · " if cyc else "")
                    + "Enter/e edit · s save · q cancel"
                    + ("   (unsaved changes)" if dirty else ""),
                    curses.A_DIM)
            stdscr.refresh()

            ch = stdscr.getch()
            key, val = flat[sel]
            if ch in (curses.KEY_UP, ord("k")):
                sel -= 1
            elif ch in (curses.KEY_DOWN, ord("j"), 9):
                sel += 1
            elif ch in (curses.KEY_LEFT, curses.KEY_RIGHT, ord("h"),
                        ord("l"), ord(" ")):
                choices = _menu_choices(key, val)
                if choices:
                    delta = -1 if ch in (curses.KEY_LEFT, ord("h")) else 1
                    try:
                        cur = choices.index(val)
                    except ValueError:
                        cur = -delta  # unknown current value -> first/last
                    _set_dotted(data, key,
                                choices[(cur + delta) % len(choices)])
                    dirty = True
            elif ch in (10, 13, curses.KEY_ENTER, ord("e")):
                txt = _curses_prompt(stdscr, f"{key} =")
                if txt:
                    _set_dotted(data, key, _parse_config_value(key, txt))
                    dirty = True
            elif ch == ord("s"):
                return "save"
            elif ch in (27, ord("q")):
                return "quit"

    try:
        import locale
        locale.setlocale(locale.LC_ALL, "")
    except Exception:
        pass
    try:
        outcome = curses.wrapper(run)
    except (_RichUnusable, curses.error):
        return None
    except Exception:
        return None
    if outcome == "empty":
        print("  (empty config)")
        return 0
    if outcome == "save" and dirty:
        bak = _write_config_file(data)
        print(f"wrote {path}" + (f" (backup: {bak})" if bak else ""))
    else:
        print("nothing changed")
    return 0


def _config_menu() -> int:
    path = config_path()
    if not path.exists():
        print(f"no config at {path} — run `teamctl init` to create one.")
        return 1
    if _use_rich_ui():
        rc = _config_menu_curses(path)
        if rc is not None:
            return rc
        print("(rich UI unavailable — using the numbered menu instead)")
    return _config_menu_line(path)


def _config_menu_line(path: Path) -> int:
    data = _load_config_strict(path)
    dirty = False
    while True:
        flat = _flatten_config(data)
        print(f"\ncurrent settings ({path}):")
        if not flat:
            print("  (empty config)")
        for i, (key, val) in enumerate(flat, 1):
            print(f"  {i:>2}. {key} = {_toml_value(val)}")
        raw = _ask("setting to change (number, blank to finish): ")
        if not raw:
            break
        try:
            n = int(raw)
            if n < 1:
                raise IndexError
            key, cur = flat[n - 1]
        except (ValueError, IndexError):
            print(f"  no setting numbered '{raw}'")
            continue
        newv = _ask(f"new value for {key} [{_toml_value(cur)}]: ")
        if not newv:
            print("  unchanged")
            continue
        _set_dotted(data, key, _parse_config_value(key, newv))
        dirty = True
    if dirty:
        bak = _write_config_file(data)
        print(f"wrote {path}" + (f" (backup: {bak})" if bak else ""))
    else:
        print("nothing changed")
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    path = config_path()

    if args.menu:
        if args.key or args.value:
            print("teamctl: --menu takes no key/value arguments.", file=sys.stderr)
            return 2
        return _config_menu()

    if args.key is None:  # bare: pretty-print current settings
        if not path.exists():
            print(f"no config at {path} — run `teamctl init` to create one.")
            return 1
        flat = _flatten_config(_load_config_strict(path))
        print(f"# {path}")
        if not flat:
            print("(empty config)")
            return 0
        for key, val in flat:
            print(f"{key} = {_toml_value(val)}")
        return 0

    if args.value is None:  # read one key
        if not path.exists():
            print(f"no config at {path} — run `teamctl init` to create one.")
            return 1
        val = _get_dotted(_load_config_strict(path), args.key)
        if val is _MISSING:
            print(f"teamctl: '{args.key}' is not set.", file=sys.stderr)
            return 1
        if isinstance(val, dict):
            for k, v in _flatten_config(val, args.key):
                print(f"{k} = {_toml_value(v)}")
        else:
            print(_toml_value(val))
        return 0

    # set one key, preserving everything else
    data = _load_config_strict(path) if path.exists() else {}
    value = _parse_config_value(args.key, args.value)
    _set_dotted(data, args.key, value)
    bak = _write_config_file(data)
    print(f"set {args.key} = {_toml_value(value)} in {path}"
          + (f" (backup: {bak})" if bak else ""))
    return 0


# --------------------------------------------------------------------------
# `teamctl settings` — the re-runnable settings cockpit: a curated,
# section-grouped editor over the SAME config.toml `teamctl config` writes.
# init is the first-run wizard; settings is its human face for later edits.
#
# The MODEL layer (settings_catalog / _settings_cycle / _settings_plain) is
# pure and headless-testable; the curses VIEW reuses the cockpit palette and
# glyphs. No TTY / no curses → the plain degrade prints current values plus
# the matching `teamctl config <key> <value>` one-liners (same philosophy as
# the installer's plain path).
# --------------------------------------------------------------------------

# The default a key falls back to when absent from config — mirrors the
# code's own defaults so the cockpit shows the effective value, not a blank.
_SETTINGS_DEFAULTS = {
    "output.verbosity": "normal",
    "lead.delegation": "ask",
    "update.check": True,
    "update.mode": "prompt",
    "layout.lead_width": 50,
    "layout.keep_finished": True,
    "usage.probe_stale_minutes": 30,
    "lead.chat_provider": "",
    "lead.chat_model": "",
    "lead.chat_effort": "",
    "routing.strategy": "headroom",
    "worktree.enabled": True,
    "worktree.cleanup": "auto",
}

# (key, section, label) for the fixed settings, in display order. Per-
# provider model/effort rows are appended dynamically. `kind`/`choices`
# come from _menu_choices (shared with `config --menu`) so the two editors
# never disagree about what a key accepts.
_SETTINGS_ROWS = (
    ("lead.chat_provider", "default chat", "provider (bare `teamctl`)"),
    ("lead.chat_model", "default chat", "model"),
    ("lead.chat_effort", "default chat", "effort"),
    ("routing.preference", "routing", "provider order"),
    ("routing.strategy", "routing", "strategy (headroom/preference)"),
    ("worktree.enabled", "worktree", "isolate teammates in worktrees"),
    ("worktree.cleanup", "worktree", "cleanup at shutdown"),
    ("lead.delegation", "posture", "delegation"),
    ("output.verbosity", "posture", "voice"),
    ("layout.lead_width", "layout", "lead pane width %"),
    ("layout.keep_finished", "layout", "keep finished panes"),
    ("usage.probe_stale_minutes", "usage", "probe staleness (min)"),
    ("update.check", "updates", "daily update check"),
    ("update.mode", "updates", "update mode"),
)


def _settings_value(data: dict, key: str):
    """Effective value for a key: the configured value, else its default.
    Per-provider model/effort default to '' (the CLI's own default)."""
    v = _get_dotted(data, key)
    if v is not _MISSING:
        return v
    if key in _SETTINGS_DEFAULTS:
        return _SETTINGS_DEFAULTS[key]
    return ""   # per-provider model/effort: unset means the CLI's default


def settings_catalog(data: dict) -> list[dict]:
    """The full settings model: one row per user-facing key, each with its
    section, label, effective value, and cycle choices (None = free text).
    Pure — drives both the curses view and the plain degrade."""
    rows: list[dict] = []
    for key, section, label in _SETTINGS_ROWS:
        val = _settings_value(data, key)
        rows.append({"key": key, "section": section, "label": label,
                     "value": val, "choices": _menu_choices(key, val)})
    # per-provider model + effort, only for providers the user actually has
    # configured (init writes a [providers.<p>] block per ready provider).
    # "custom" is the [providers.custom.*] table, not a provider itself;
    # an effort row is omitted when the CLI has no effort control.
    for prov in sorted((data.get("providers") or {})):
        if prov == "custom":
            continue
        for leaf, lbl in (("model", "model"), ("effort", "effort")):
            if leaf == "effort" and not provider_supports_effort(prov):
                continue
            key = f"providers.{prov}.{leaf}"
            val = _settings_value(data, key)
            rows.append({"key": key, "section": f"{prov}", "label": lbl,
                         "value": val, "choices": _menu_choices(key, val)})
    return rows


def _settings_cycle(row: dict, delta: int):
    """Next/previous value for a cycleable row; unchanged if not cycleable."""
    choices = row["choices"]
    if not choices:
        return row["value"]
    try:
        cur = choices.index(row["value"])
    except ValueError:
        cur = -delta
    return choices[(cur + delta) % len(choices)]


def _settings_plain(data: dict) -> list[str]:
    """No-TTY degrade: current values + the `teamctl config` one-liner that
    changes each — the scriptable path spelled out."""
    lines = [f"# {config_path()}",
             "# current settings — change any with the command shown:"]
    section = None
    for row in settings_catalog(data):
        if row["section"] != section:
            section = row["section"]
            lines.append(f"\n[{section}]")
        val = _toml_value(row["value"])
        v = row["value"]
        if isinstance(v, list):
            example = ",".join(str(x) for x in v)
        elif isinstance(v, bool):
            example = "true" if v else "false"
        else:
            example = v
        lines.append(f"  {row['label']:<26} {val}")
        lines.append(f"    teamctl config {row['key']} "
                     f"{shlex.quote(str(example))}")
    return lines


def _settings_curses(data: dict) -> int | None:
    """Arrow-key settings cockpit. Returns an exit code, or None when curses
    could not run (caller falls back to the plain degrade)."""
    dirty = [False]

    def run(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        _curses_colors()
        g = _ui_glyphs()
        sel = 0
        while True:
            catalog = settings_catalog(data)
            sel = max(0, min(sel, len(catalog) - 1))
            # a flat list of (kind, payload) render rows: section headers +
            # items, so the focusable index maps back to catalog entries
            render: list[tuple] = []
            last_section = None
            for i, row in enumerate(catalog):
                if row["section"] != last_section:
                    last_section = row["section"]
                    render.append(("header", row["section"]))
                render.append(("item", i, row))
            h, w = stdscr.getmaxyx()
            if h < len(render) + 5 or w < 64:
                raise _RichUnusable("terminal too small for settings")
            stdscr.erase()
            _addstr(stdscr, 0, 1, "teamctl", _cattr("primary") | curses.A_BOLD)
            _addstr(stdscr, 0, 9, f"{g['dot']}  settings", _cattr("accent"))
            _addstr(stdscr, 1, 1, str(config_path()), _cattr("dim"))
            y = 3
            bar_w = min(w - 4, 84)
            for r in render:
                if r[0] == "header":
                    _addstr(stdscr, y, 1, r[1], _cattr("soft") | curses.A_BOLD)
                    y += 1
                    continue
                _idx, row = r[1], r[2]
                focused = (_idx == sel)
                val = _toml_value(row["value"])
                label = f"  {row['label']:<26} {val}"
                if focused:
                    _addstr(stdscr, y, 2, (g["sel"] + label).ljust(bar_w),
                            _cattr("select"))
                else:
                    _addstr(stdscr, y, 2, "  " + row["label"].ljust(26),
                            _cattr("primary"))
                    _addstr(stdscr, y, 30, val, _cattr("ok"))
                y += 1
            cyc = catalog[sel]["choices"] is not None
            foot = ("↑↓ move   "
                    + ("←/→ or space cycle   " if cyc else "space toggle   ")
                    + "enter edit   s save   q quit"
                    + ("   (unsaved)" if dirty[0] else ""))
            _addstr(stdscr, h - 1, 1, foot, _cattr("dim"))
            stdscr.refresh()

            ch = stdscr.getch()
            row = catalog[sel]
            if ch in (curses.KEY_UP, ord("k")):
                sel -= 1
            elif ch in (curses.KEY_DOWN, ord("j"), 9):
                sel += 1
            elif ch in (curses.KEY_LEFT, curses.KEY_RIGHT, ord("h"),
                        ord("l"), ord(" ")):
                if row["choices"]:
                    delta = -1 if ch in (curses.KEY_LEFT, ord("h")) else 1
                    _set_dotted(data, row["key"], _settings_cycle(row, delta))
                    dirty[0] = True
            elif ch in (10, 13, curses.KEY_ENTER, ord("e")):
                txt = _curses_prompt(stdscr, f"{row['key']} =")
                if txt:
                    _set_dotted(data, row["key"],
                                _parse_config_value(row["key"], txt))
                    dirty[0] = True
            elif ch == ord("s"):
                return "save"
            elif ch in (27, ord("q")):
                if not dirty[0]:
                    return "quit"
                ans = _curses_prompt(stdscr, "quit without saving? [y/N]")
                if ans.lower().startswith("y"):
                    return "quit"

    try:
        import locale
        locale.setlocale(locale.LC_ALL, "")
    except Exception:
        pass
    try:
        outcome = curses.wrapper(run)
    except (_RichUnusable, curses.error):
        return None
    except Exception:
        return None
    if outcome == "save" and dirty[0]:
        bak = _write_config_file(data)
        print(f"wrote {config_path()}" + (f" (backup: {bak})" if bak else ""))
    else:
        print("nothing changed")
    return 0


def cmd_settings(args: argparse.Namespace) -> int:
    """Open the settings cockpit (or its plain degrade). Works even with no
    config yet — it edits the effective defaults and writes them on save."""
    path = config_path()
    data = _load_config_strict(path) if path.exists() else {}
    if _use_rich_ui():
        rc = _settings_curses(data)
        if rc is not None:
            return rc
        print("(rich UI unavailable — showing current settings)\n")
    for line in _settings_plain(data):
        print(line)
    if not path.exists():
        print("\n(no config yet — run `teamctl init`, or set any key above "
              "to create one)")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="teamctl", description=__doc__)
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    ip = sub.add_parser(
        "init",
