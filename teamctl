def _snap(value: str, allowed: tuple, default: str) -> str:
    v = value.strip().lower()
    if v in allowed:
        return v
    if v and v != default:
        print(f"  snapped to {default}")
    return default


def _plain_init(args: argparse.Namespace) -> int:
    rows = _detect_providers()
    ready = sorted(_usable(rows))
    print("teamctl init — plain path")
    print()
    for prov, state in rows:
        print(f"  {prov:<7} {state}")
    print()

    models: dict[str, str] = {}
    if ready:
        print("  model per provider [enter = cli default]")
        for prov in ready:
            models[prov] = _ask(f"  {prov}: ")
        print()
    effort = _snap(_ask("  effort [high]: ", "high"), EFFORT_CHOICES, "high")
    voice = _snap(_ask("  voice  [normal]: ", "normal"), VOICE_CHOICES,
                  "normal")
    lead = _snap(_ask("  lead   [ask]: ", "ask"), LEAD_CHOICES, "ask")
    route = list(ready)
    if len(ready) > 1:
        raw = _ask(f"  route  [{','.join(route)}]: ")
        if raw:
            chosen = [p.strip() for p in raw.split(",") if p.strip()]
            picked = [p for p in chosen if p in ready]
            if picked:                   # unknowns dropped silently (§6.3)
                route = picked
    print()

    cfg_path = Path.home() / ".config" / "agent-team" / "config.toml"
    if not _ask_yn(f"  write {_tilde(cfg_path)}? [Y/n] ", default=True):
        print("  nothing written.")
        return 0
    providers_cfg = {p: {"model": models.get(p, ""), "effort": effort}
                     for p in ready}
    changes: list[tuple[str, str]] = []
    path, backed_up = _write_wizard_config(providers_cfg, voice, route, lead,
                                           changes)
    g = _out_glyphs()
    print(f"  wrote {_tilde(path)}"
          + (f"  (prior {g['arrow']} config.toml.bak-teamctl)"
             if backed_up else ""))

    if os.environ.get("TEAMCTL_INIT_EXTRAS") == "1":
        if _ask_yn("  add tmux pane-border block? [y/N] "):
            _install_tmux_block(changes)
        if _ask_yn("  install claude statusline? [y/N] "):
            _install_statusline(changes)
        if _ask_yn("  install lead mode? [y/N] "):
            _install_lead(changes, want_hook=_ask_yn(
                "  with per-prompt hook? [Y/n] ", default=True))
    else:
        print(f"  extras (tmux borders {g['dot']} statusline {g['dot']} lead "
              "mode): teamctl init --custom, or teamctl lead on")
    return 0


