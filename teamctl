                      "passed through)")
            else:
                print("  could not run `grok models` (not installed, not "
                      "logged in, or the command failed)")
        elif prov == "codex":
            cached = _codex_models_cache()
            if cached:
                models, fetched = cached
                for m in models:
                    slug = m.get("slug") or "?"
                    efforts = "/".join(
                        str(lv["effort"])
                        for lv in (m.get("supported_reasoning_levels") or [])
                        if isinstance(lv, dict) and lv.get("effort"))
                    extra = ", ".join(x for x in (
                        str(m.get("display_name") or ""),
                        f"efforts: {efforts}" if efforts else "") if x)
                    print(f"  {slug}" + (f"  ({extra})" if extra else ""))
                print(f"  (source: ~/.codex/models_cache.json, fetched "
                      f"{fetched} — an observed cache, not a documented "
                      "interface)")
            else:
                print("  no local model list found; any model id is accepted "
                      "(the codex CLI validates it)")
        elif prov == "claude":
            print("  the claude CLI has no model-listing command; --model "
                  "takes a documented")
            print("  alias (sonnet, opus, haiku, fable) or a full model name. "
                  "Inside a session,")
            print("  /model opens the interactive picker.")
        print()
    print("model ids pass through to the provider CLI verbatim — new models "
          "work without updating teamctl.")
    return 0


# --------------------------------------------------------------------------
# hidden usage probes — run a provider TUI's own usage command inside a
# detached background tmux session (never the user's window) and scrape the
# numbers. TUI output is OBSERVED-ONLY text: parse defensively, degrade
# gracefully, and tear the TUI down with the same process-tree-verified kill
# used for teammates.
# --------------------------------------------------------------------------

PROBE_SESSION = "teamctl-probe"

# provider -> how to ask its TUI for usage. claude is deliberately absent:
# its statusline rate_limits feed (claude-usage.json) is the documented and
# cheaper source. `command` is typed into the TUI followed by Enter;
# extra_enters presses Enter again if no numbers appear (menu confirmation).
PROBES: dict[str, dict] = {
    "grok": {"argv": ["grok"], "command": "/usage", "extra_enters": 1},
    "codex": {"argv": ["codex"], "command": "/status", "extra_enters": 1},
}


def _capture_pane(pane_id: str) -> str:
    try:
        return tmux("capture-pane", "-p", "-t", pane_id).stdout
    except subprocess.CalledProcessError:
        return ""


def _probe_session_exists() -> bool:
    return tmux("has-session", "-t", f"={PROBE_SESSION}",
                check=False).returncode == 0


def _open_probe_pane(launch_line: str) -> str:
    """A window inside the detached probe session (created on demand):
    nothing ever appears in the user's own session or window."""
    if _probe_session_exists():
        return tmux("new-window", "-d", "-t", PROBE_SESSION, "-P", "-F",
                    "#{pane_id}", launch_line).stdout.strip()
    return tmux("new-session", "-d", "-s", PROBE_SESSION, "-x", "220",
                "-y", "50", "-P", "-F", "#{pane_id}",
                launch_line).stdout.strip()


def _wait_settled(pane_id: str, timeout: float) -> bool:
    """True once the pane shows non-empty content stable across two polls."""
    prev = None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        cur = _capture_pane(pane_id).strip()
        if cur and cur == prev:
            return True
        prev = cur
        time.sleep(0.4)
    return False


def parse_probe_text(text: str) -> dict:
    """Scrape usage numbers out of TUI text. Formats are OBSERVED-ONLY (e.g.
    grok: 'Weekly limit: 18%', 'Next reset: July 13, 11:33 PT'; codex
    /status output is explicitly unstable), so every field is optional:
    percentage lines become windows, reset-ish lines are kept verbatim."""
    windows: dict[str, dict] = {}
    notes: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        low = line.lower()
        m = re.search(r"(\d{1,3}(?:\.\d+)?)\s*%", line)
        if m and any(k in low for k in ("limit", "usage", "used", "quota")):
            pct = float(m.group(1))
            # codex /status phrases these as "N% left" (remaining, not used)
            if "left" in low or "remaining" in low:
                pct = max(0.0, 100.0 - pct)
            if any(k in low for k in ("week", "7d", "7-day", "seven")):
                label = "weekly"
            elif any(k in low for k in ("5h", "5-hour", "session", "hour")):
                label = "5h"
            else:
                label = (low.split(":", 1)[0].strip()[:24] or "usage")
            windows.setdefault(label, {"used_percent": pct})
        elif "reset" in low and ":" in line:
            notes.append(line)
    return {"windows": windows, "reset_notes": notes[:4]}


def probe_provider(provider: str, spec: dict, timeout: float = 40.0
                   ) -> tuple[dict | None, str]:
    """Run one hidden probe; returns (result, "") or (None, reason). The
    probe pane is always torn down, verified, before returning."""
    pane_id = ""
    try:
        launch = " ".join(shlex.quote(a) for a in spec["argv"])
        pane_id = _open_probe_pane(launch)
        if not pane_id:
            return None, "could not open a probe pane"
        if not _wait_settled(pane_id, timeout / 2):
            return None, "the TUI never settled"
        tmux("send-keys", "-t", pane_id, "-l", "--", spec["command"],
             check=False)
        tmux("send-keys", "-t", pane_id, "C-m", check=False)
        enters_left = int(spec.get("extra_enters", 0))
        deadline = time.monotonic() + timeout / 2
        while time.monotonic() < deadline:
            time.sleep(1.0)
            parsed = parse_probe_text(_capture_pane(pane_id))
            if parsed["windows"]:
                return parsed, ""
            if enters_left > 0:  # e.g. a menu needing a confirming Enter
                tmux("send-keys", "-t", pane_id, "C-m", check=False)
                enters_left -= 1
        return None, "no usage numbers appeared before the timeout"
    except TeamctlError as exc:
        return None, str(exc)
    finally:
        # verified teardown; tmux removes the probe session automatically
        # once its last window dies.
        if pane_id and not _close_pane(pane_id):
            print(f"teamctl: warning: probe pane {pane_id} did not shut "
                  "down cleanly", file=sys.stderr)


def _save_probe_result(provider: str, result: dict) -> None:
    cache = state_path().parent / "probe-usage.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    entry = {"captured_at": time.time(), "source": "probe"}
    entry.update(result)
    data[provider] = entry
    cache.parent.mkdir(parents=True, exist_ok=True)
    tmp = cache.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(cache)


def load_probe_cache() -> dict:
    cache = state_path().parent / "probe-usage.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def probe_stale_minutes() -> int:
    raw = (load_config().get("usage") or {}).get("probe_stale_minutes", 30)
    try:
        val = int(raw)
    except (TypeError, ValueError):
        val = 30
    return max(1, val)


def _run_probes(which: str) -> int:
    """Handle `usage --probe [provider|all]`. Returns 2 on a bad target."""
    if which == "claude":
        print("claude: probe skipped — the statusline cache is the "
              "documented, cheaper source (install it via `teamctl init`).")
        return 0
    if which == "all":
        targets = [p for p in PROBES if shutil.which(p)]
        if not targets:
            print("no probe-able provider CLI installed.", file=sys.stderr)
    elif which in PROBES:
        if shutil.which(which):
            targets = [which]
        else:
            targets = []
            print(f"{which}: not installed — probe skipped.", file=sys.stderr)
    else:
        print(f"teamctl: no probe defined for provider '{which}'.",
              file=sys.stderr)
        return 2
    for prov in targets:
        print(f"probing {prov} in hidden tmux session '{PROBE_SESSION}'…")
        result, err = probe_provider(prov, PROBES[prov])
        if result:
            _save_probe_result(prov, result)
            wins = ", ".join(f"{k} {v['used_percent']:.0f}%"
                             for k, v in result["windows"].items())
            print(f"{prov}: probe ok — {wins}")
        else:
            print(f"{prov}: probe failed ({err})")
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    """Real provider usage %/reset where the provider exposes it locally,
    gated by the provider state lattice — residual artifacts left by an
    uninstalled CLI are flagged, never rendered as a live provider. Also
    refreshes routing signals: a live provider at 100% on its 5h window is
    marked exhausted so `route` skips it until it resets."""
    if getattr(args, "probe", ""):
        rc = _run_probes(args.probe)
        if rc:
            return rc
    now = time.time()

    states = {prov: provider_state(prov) for prov in ROUTABLE}
    live = {prov for prov, (st, _n) in states.items()
            if st in ("ready", "quiet")}

    codex = _known_windows("codex") if "codex" in live else {}
    pw = codex.get("5h") or {}
    if (pw.get("used_percent") or 0) >= 100 and (pw.get("resets_at") or 0) > now:
        _record_provider_signal("codex", "exhausted",
                                resets_at=pw.get("resets_at"))

    claude = _known_windows("claude") if "claude" in live else {}
    claude_captured = None
    if claude:
        cu = claude_usage()
        if cu:
            claude_captured = cu.get("captured_at")
        fh = claude.get("5h") or {}
        if (fh.get("used_percent") or 0) >= 100 \
                and (fh.get("resets_at") or 0) > now:
            _record_provider_signal("claude", "exhausted",
                                    resets_at=fh.get("resets_at"))

    probes = load_probe_cache()
    stale_after = probe_stale_minutes() * 60

    if args.json:
        claude_json = None
        if claude:
            claude_json = dict(claude)
            claude_json["captured_at"] = claude_captured
        print(json.dumps({
            "codex": codex or None,
            "claude": claude_json,
            "grok": None,
            "probes": probes or None,
            "states": {prov: {"state": st, "note": note or None}
                       for prov, (st, note) in states.items()},
        }, indent=2))
        return 0

    def _stale_note(age_seconds: float) -> str:
        if age_seconds > stale_after:
            return " — stale, consider `teamctl usage --probe`"
        return ""

    native = {"codex": codex, "claude": claude}
    print(f"{'PROVIDER':<8}  USAGE")
    for prov in ROUTABLE:
        state, note = states[prov]
        if state == "not installed":
            print(f"{prov:<8}  not installed"
                  + (f" — {note}" if note else ""))
            continue
        if state == "locked out":
            print(f"{prov:<8}  locked out — sign in: "
                  f"`{LOGIN_HINTS.get(prov, prov + ' login')}`")
            continue
        if state == "unknown":
            print(f"{prov:<8}  unknown — {note or 'auth state unreadable'}")
            continue
        wins = native.get(prov, {})
        if wins:
            for label, w in wins.items():
                print(f"{prov:<8}  {label}: {w['used_percent']:.0f}% used, "
                      f"resets {_fmt_reset(w['resets_at'], now)}")
            if prov == "claude":
                if isinstance(claude_captured, (int, float)):
                    age = (_fmt_age(now - claude_captured)
                           + _stale_note(now - claude_captured))
                else:
                    age = "age unknown"
                print(f"{prov:<8}  (source: statusline cache, {age})")
        elif state == "ready":       # numbers live in the probe cache below
            print(f"{prov:<8}  ready — probe data below")
        else:
            print(f"{prov:<8}  quiet — signed in, no usage data yet "
                  f"({WAKE_HINTS.get(prov, 'use it once')})")

    # cached probe results — but never for an uninstalled provider (its
    # residue is already flagged above, and it is not a live provider)
    probes = {prov: entry for prov, entry in probes.items()
              if states.get(prov, ("", ""))[0] != "not installed"}
    if probes:
        print(f"\n{'PROBE':<8}  (TUI-scraped, observed-only formats)")
        for prov in sorted(probes):
            entry = probes[prov]
            if not isinstance(entry, dict):
                continue
            cap = entry.get("captured_at")
            age = (_fmt_age(now - cap) + _stale_note(now - cap)
                   if isinstance(cap, (int, float)) else "age unknown")
            windows = entry.get("windows") or {}
            for label, w in windows.items():
                if isinstance(w, dict) and w.get("used_percent") is not None:
                    print(f"{prov:<8}  {label}: {w['used_percent']:.0f}% used "
                          f"({age})")
            for note in entry.get("reset_notes") or []:
                print(f"{prov:<8}  {note}")
    _maybe_spawn_update_check()
    _print_update_notice()
    return 0


def cmd_providers(args: argparse.Namespace) -> int:
    """One lattice state per provider (see provider_state), with usage
    numbers on ready providers and cached credit/auth signals appended."""
    cached = _cached_signals()
    now = time.time()

    rows: list[tuple[str, str, str]] = []
    for prov in ROUTABLE:
        state, note = provider_state(prov)
        details: list[str] = []
        if state == "ready":
            summary = _usage_summary(prov)
            if summary:
                details.append(summary)
        elif state == "quiet":
            details.append("signed in, no usage data yet — "
                           + WAKE_HINTS.get(prov, "use it once"))
        elif state == "locked out":
            details.append("sign in: "
                           f"`{LOGIN_HINTS.get(prov, prov + ' login')}`")
        if note:
            details.append(note if state == "not installed" else f"({note})")
        sig_entry = cached.get(prov, {})
        sig = _live_signal(sig_entry)
        if state in ("ready", "quiet") and sig == "exhausted":
            d = f"usage limit hit (last seen {sig_entry.get('at', '?')})"
            ra = sig_entry.get("resets_at")
            if ra:
                d += f", resets {_fmt_reset(ra, now)}"
            details.append(d)
        elif state in ("ready", "quiet") and sig == "auth-error":
            details.append(f"auth error at last use "
                           f"({sig_entry.get('at', '?')}) — it may have "
                           "signed out; try it once")
        rows.append((prov, state, " · ".join(details)))

    if args.json:
        print(json.dumps({p: {"state": s, "detail": d or None}
                          for p, s, d in rows}, indent=2))
        return 0
    print(f"{'PROVIDER':<8}  STATE")
    for prov, state, detail in rows:
        print(f"{prov:<8}  {state}" + (f" — {detail}" if detail else ""))
    _maybe_spawn_update_check()
    _print_update_notice()
    return 0


ROUTABLE = ("claude", "codex", "grok")


def _cached_signals() -> dict:
    cache = state_path().parent / "providers.json"
    try:
        return json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}


def route_select(requested: list[str] | None = None
                 ) -> tuple[str | None, list[str], dict[str, str]]:
    """Pick the best available provider.

    Returns (selected, preference, exclusions) where exclusions maps each
    rejected candidate to a reason: unknown / not installed / locked out /
    auth unknown / exhausted / auth-error. selected is None when no
    candidate survives.
    """
    candidates = requested if requested else list(ROUTABLE)
    cached = _cached_signals()
    exclusions: dict[str, str] = {}
    survivors: list[str] = []
    for prov in candidates:
        if prov not in ROUTABLE:
            exclusions[prov] = "unknown"
            continue
        if shutil.which(prov) is None:
            exclusions[prov] = "not installed"
            continue
        auth = provider_auth_state(prov)[0]
        if auth != "signed-in":
            exclusions[prov] = ("locked out" if auth == "signed-out"
                                else "auth unknown")
            continue
        signal = _live_signal(cached.get(prov))
        if signal in ("exhausted", "auth-error"):
            exclusions[prov] = signal
            continue
        survivors.append(prov)

    preference = (load_config().get("routing") or {}).get("preference")
    if not isinstance(preference, list) or not preference:
        preference = list(ROUTABLE)
    ranked = sorted(
        survivors,
        key=lambda p: (preference.index(p) if p in preference else len(preference),
                       survivors.index(p)),
    )
    return (ranked[0] if ranked else None), preference, exclusions


def cmd_route(args: argparse.Namespace) -> int:
    requested = [p.strip() for p in args.providers.split(",") if p.strip()] \
        if args.providers else None
    selected, preference, exclusions = route_select(requested)

    if selected is None:
        print("teamctl: route found no available provider:", file=sys.stderr)
        for prov, reason in exclusions.items():
            print(f"  {prov}: {reason}", file=sys.stderr)
        return 1

    configured = (load_config().get("routing") or {}).get("preference")
    if isinstance(configured, list) and configured:
        reason = f"first available in your preference {'>'.join(preference)}"
    else:
        reason = (f"first available in alphabetical order "
                  f"{'>'.join(preference)} — an arbitrary order, not a "
                  "recommendation; set yours with `teamctl config "
                  "routing.preference ...`")
    if exclusions:
        skipped = ", ".join(f"{p}: {r}" for p, r in exclusions.items())
        reason += f"; skipped {skipped}"
    print(f"route: selected {selected} ({reason})")

    if args.dry_run:
        cwd, model, effort, task = _resolve_dispatch(
            selected, args.task, "", args.model, args.effort, args.cwd)
        argv = headless_argv(selected, task, model, effort)
        print("dry-run: " + " ".join(shlex.quote(a) for a in argv))
        return 0

    return _do_dispatch(args.role, selected, args.task, "",
                        args.model, args.effort, args.cwd)


# --------------------------------------------------------------------------
# `teamctl init` — onboarding wizard
# --------------------------------------------------------------------------

TMUX_MARKER_BEGIN = "# --- BEGIN teamctl ---"
TMUX_MARKER_END = "# --- END teamctl ---"
TMUX_BLOCK = TMUX_MARKER_BEGIN + """
# Added by `teamctl init`. Reversible: delete this block (including the
# BEGIN/END marker lines) and run `tmux source-file ~/.tmux.conf`.
#
# Sticky per-pane border label showing a teammate pane's "role · model",
# read from the @role/@model per-pane user options teamctl sets at spawn.
# Panes teamctl didn't spawn have no @model and get an empty label.
# User options are used because provider CLIs overwrite pane titles, and
# some tmux builds do not execute #() shell commands in status formats.
set-option -g pane-border-status top
set-option -g pane-border-format '#{?#{@model}, #{@role} · #{@model} ,}'
# Append the active pane's "role · model" to the status bar. Guarded so
# re-sourcing this file does not append the segment a second time.
if-shell -F '#{?@teamctl_status_added,0,1}' {
  set-option -g @teamctl_status_added 1
  set-option -ga status-right ' #{?#{@model},│ #{@role} · #{@model} ,}'
}
""" + TMUX_MARKER_END + "\n"

STATUSLINE_ENTRY = {"type": "command", "command": "~/.local/bin/claude-statusline"}


def _input(prompt: str) -> str:
    """Thin wrapper around input() so tests can script wizard answers."""
    return input(prompt)


def _ask(prompt: str, default: str = "") -> str:
    # EOFError: real stdin ran dry (non-tty). StopIteration: a scripted
    # _input (tests) ran out of answers — same meaning, same default.
    try:
        raw = _input(prompt).strip()
    except (EOFError, StopIteration):
        return default
    return raw or default


def _ask_yn(prompt: str, default: bool = False) -> bool:
    raw = _ask(prompt).lower()
    if not raw:
        return default
    return raw in ("y", "yes")


def _toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _detect_providers() -> list[tuple[str, str]]:
    """(provider, lattice state) for every routable provider. A provider is
    usable for config/routing when signed in — state `quiet` or `ready`
    (usage data changes the word, not the eligibility)."""
    return [(prov, provider_state(prov)[0]) for prov in ROUTABLE]


def _usable(rows: list[tuple[str, str]]) -> list[str]:
    """The signed-in providers from a _detect_providers() listing."""
    return [prov for prov, state in rows if state in ("quiet", "ready")]


def _render_config(providers_cfg: dict[str, dict[str, str]], verbosity: str,
                   preference: list[str] | None = None,
                   delegation: str = "ask") -> str:
    lines = [
        "# agent-team configuration (written by `teamctl init`)",
        "# Delete this file to fall back to each provider CLI's own defaults.",
        "",
        "[output]",
        f'verbosity = "{_toml_escape(verbosity)}"',
        "",
        "[lead]",
        "# how a lead agent decides to delegate: ask | always | manual",
        f'delegation = "{_toml_escape(delegation)}"',
    ]
    # the wizard never asks about updates, so re-running it must not reset
    # the user's choice: carry the settings currently in force forward
    upd_check, upd_mode = update_settings()
    lines += [
        "",
        "[update]",
        "# once-a-day background version check; mode: prompt | auto | off",
        f"check = {'true' if upd_check else 'false'}",
        f'mode = "{upd_mode}"',
    ]
    if preference:
        lines += [
            "",
            "[routing]",
            "# your auto-routing order (also the --provider default);",
            "# reorder any time: teamctl config routing.preference \"a,b,c\"",
            f"preference = {_toml_value(list(preference))}",
        ]
    for prov, vals in providers_cfg.items():
        lines += ["", f"[providers.{prov}]"]
        wrote = False
        for key in ("model", "effort"):
            if vals.get(key):
                lines.append(f'{key} = "{_toml_escape(vals[key])}"')
                wrote = True
        if not wrote:
            lines.append(f'# model = ""   # unset: {prov} uses its own defaults')
            lines.append('# effort = ""')
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------
# setup experience — three paths, one config schema. Canonical design:
# docs/design/installer-spec.md ("teamctl Setup Experience", Grok 4.5).
#
#   express (default `init`)  zero questions; wordmark frame; sane defaults
#   custom  (`init --custom`) 3-screen curses cockpit: models → posture → seal
#   plain   (degrade / `p`)   short prompts, Express defaults on blank
#
# The cockpit degrades to the plain path whenever curses cannot run: no real
# tty on stdin/stdout (scripted runs, CI, pipes), a dumb TERM, curses
# missing, or TEAMCTL_UI=plain. The scripted-stdin test seams (tc._input)
# therefore keep working — redirected stdio is never a tty.
# --------------------------------------------------------------------------

# claude has no model-listing command; these are its documented --model
# aliases. codex/grok lists come from discover_models() (cache / CLI).
CLAUDE_MODEL_ALIASES = ("sonnet", "opus", "haiku", "fable")

EFFORT_CHOICES = ("low", "medium", "high", "xhigh")

VOICE_CHOICES = ("terse", "normal", "detailed")

LEAD_CHOICES = ("ask", "always", "manual")

LEAD_GLOSS = {"ask": "check once per session",
              "always": "hand off non-trivial work",
              "manual": "only when told"}

# spec §1.1 — 256-color palette; background stays the terminal's own.
_PALETTE = (("accent", 51), ("ok", 114), ("warn", 180), ("dim", 240),
            ("soft", 44), ("primary", 252), ("border", 238), ("bad", 167),
            ("mute", 236))
_ROLE_PAIR = {name: i for i, (name, _) in enumerate(_PALETTE, start=1)}
_SELECT_PAIR = 10          # fg 232 on bg 51 (spec: selection bar)
_HAS_256 = False


class _RichUnusable(Exception):
    """The curses UI cannot run here (raised mid-flight, e.g. tiny term)."""


def _use_rich_ui() -> bool:
    """True when the arrow-key curses UI should be attempted."""
    ui = os.environ.get("TEAMCTL_UI", "").strip().lower()
    if ui in ("plain", "line", "never", "0"):
        return False
    if curses is None:
        return False
    try:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return False
    except (AttributeError, ValueError):
        return False
    term = os.environ.get("TERM", "")
    if not term or term in ("dumb", "unknown"):
        return False
    return True


def _ansi_ok() -> bool:
    """Color for the non-curses frames (express, post-write)."""
    if os.environ.get("NO_COLOR") or os.environ.get("TEAMCTL_PLAIN") == "1":
        return False
    try:
        if not sys.stdout.isatty():
            return False
    except (AttributeError, ValueError):
        return False
    term = os.environ.get("TERM", "")
    return bool(term) and term != "dumb"


def _fg(role: str, s: str) -> str:
    """256-color ANSI tint for print()-based frames; plain when unsuitable."""
    if not _ansi_ok():
        return s
    return f"\033[38;5;{dict(_PALETTE)[role]}m{s}\033[0m"


def _out_glyphs() -> dict[str, str]:
    """Unicode accents when stdout can encode them, ASCII otherwise."""
    enc = (getattr(sys.stdout, "encoding", "") or "").upper()
    if "UTF" in enc:
        return {"rule": "━", "chev": "›", "dot": "·", "arrow": "→",
                "dash": "—"}
    return {"rule": "=", "chev": ">", "dot": "*", "arrow": "->", "dash": "--"}


def _tilde(p) -> str:
    home = str(Path.home())
    s = str(p)
    return "~" + s[len(home):] if s.startswith(home) else s


def _model_choices(provider: str) -> list[str]:
    """Model ids offered as picks. Ids always pass through to the CLI
    verbatim, so the 'custom…' escape hatch accepts anything."""
    if provider == "claude":
        return list(CLAUDE_MODEL_ALIASES)
    return discover_models(provider)


def _ui_glyphs() -> dict[str, str]:
    """Unicode accents for curses when the locale can render them."""
    try:
        import locale
        utf = "UTF" in (locale.nl_langinfo(locale.CODESET) or "").upper()
    except (ImportError, AttributeError, ValueError):
        utf = False
    if utf:
        return {"sel": "› ", "on": "●", "off": "○", "l": "‹ ", "r": " ›",
                "sep": " › ", "dot": "·", "dash": "—", "more": "…"}
    return {"sel": "> ", "on": "*", "off": "o", "l": "< ", "r": " >",
            "sep": " > ", "dot": "*", "dash": "--", "more": "..."}


def _addstr(win, y: int, x: int, s: str, attr: int = 0) -> None:
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass  # clipped at a screen edge — cosmetic only
    except (UnicodeEncodeError, ValueError):
        # a non-UTF-8 locale can't encode a fancy glyph: draw ASCII instead
        try:
            win.addstr(y, x, s.encode("ascii", "replace").decode(), attr)
        except curses.error:
            pass


def _curses_colors() -> None:
    """Palette init shared by the cockpit and the config menu; sets 256-color
    pairs when the terminal has them, else the drawing code degrades to
    reverse-video / dim attributes (spec §1.1 degrade rule)."""
    global _HAS_256
    _HAS_256 = False
    try:
        curses.start_color()
        curses.use_default_colors()
        if getattr(curses, "COLORS", 0) >= 256:
            for i, (_name, code) in enumerate(_PALETTE, start=1):
                curses.init_pair(i, code, -1)
            curses.init_pair(_SELECT_PAIR, 232, 51)
            _HAS_256 = True
    except curses.error:
        _HAS_256 = False


def _cattr(role: str) -> int:
    if not _HAS_256:
        if role == "select":
            return curses.A_REVERSE
        if role in ("dim", "mute", "border"):
            return curses.A_DIM
        if role in ("accent", "soft", "ok", "warn"):
            return curses.A_BOLD
        return curses.A_NORMAL
    if role == "select":
        return curses.color_pair(_SELECT_PAIR)
    return curses.color_pair(_ROLE_PAIR[role])


def _pair(n: int) -> int:
    """Legacy pair accessor used by the config menu (1 accent, 2 ok, 3 warn)."""
    try:
        return curses.color_pair(n)
    except curses.error:
        return 0


def _curses_prompt(stdscr, label: str) -> str:
    """One-line text input on the bottom row (custom model ids, menu edits)."""
    h, _ = stdscr.getmaxyx()
    stdscr.move(h - 1, 0)
    stdscr.clrtoeol()
    _addstr(stdscr, h - 1, 0, label, curses.A_BOLD)
    curses.echo()
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        raw = stdscr.getstr(h - 1, len(label) + 1, 80)
    except (curses.error, KeyboardInterrupt):
        raw = b""
    finally:
        curses.noecho()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
    return raw.decode("utf-8", "replace").strip()


# --------------------------------------------------------------------------
# custom cockpit — 3 screens (models → posture → seal), spec §4
# --------------------------------------------------------------------------

_COCKPIT_FOOTERS = {
    1: "↑↓ move   enter choose   tab next provider   n next   p plain   q quit",
    2: "↑↓ section/item   enter choose   n next   b back   p plain   q quit",
    3: "↑↓  space toggle  enter run  b back  p plain  q quit",
}

_COCKPIT_TITLES = {1: "pick a model — or leave the CLI its secrets",
                   2: "how hard · how loud · when to hand off",
                   3: "seal it"}

_EXTRAS_ROWS = (
    ("tmux", "tmux borders", "pane labels · role · model"),
    ("statusline", "claude statusline", "model · effort · ctx%"),
    ("lead", "lead mode", "manager identity for agent CLIs"),
    ("hook", "lead hook", "per-prompt reminder (claude only)"),
)


def _cockpit_rows(screen: int, state: dict, ready: list[str],
                  discovered: dict[str, list[str]]) -> list[dict]:
    g = _ui_glyphs()
    rows: list[dict] = [{"kind": "title", "text": _COCKPIT_TITLES[screen]},
                        {"kind": "blank"}]
    if screen == 1:
        # cap visible discoveries so three provider blocks still fit the
        # spec's 100×30 canvas; the tail collapses into a "… N more" row
        # that jumps to the custom editor (spec §4.3).
        cap = {1: 8, 2: 5}.get(len(ready), 3)
        for prov in ready:
            rows.append({"kind": "header", "text": prov})
            rows.append({"kind": "choice", "group": ("model", prov),
                         "value": "", "label": "(provider default)"})
            found = discovered.get(prov) or []
            for m in found[:cap]:
                rows.append({"kind": "choice", "group": ("model", prov),
                             "value": m, "label": m})
            if len(found) > cap:
                rows.append({"kind": "more", "prov": prov,
                             "label": f"{g['more']} {len(found) - cap} more"})
            custom_val = state["models"].get(prov, "")
            is_custom = custom_val and custom_val not in found[:cap]
            rows.append({"kind": "custom", "prov": prov,
                         "label": (f"custom:  {custom_val}" if is_custom
                                   else f"custom{g['more']}")})
            rows.append({"kind": "blank"})
        rows.append({"kind": "info",
                     "text": f"{g['dot']} discovered via teamctl models "
                             f"{g['dot']} ids pass through verbatim"})
    elif screen == 2:
        rows.append({"kind": "header", "text": "effort",
                     "note": "[global for all ready]"})
        efforts = ["high", "medium", "low"]
        if "codex" in ready:
            efforts.append("xhigh")
        for e in efforts:
            rows.append({"kind": "choice", "group": ("effort",),
                         "value": e, "label": e})
        rows.append({"kind": "blank"})
        rows.append({"kind": "header", "text": "voice"})
        for v in VOICE_CHOICES:
            rows.append({"kind": "choice", "group": ("voice",),
                         "value": v, "label": v})
        rows.append({"kind": "blank"})
        rows.append({"kind": "header", "text": "lead"})
        for d in LEAD_CHOICES:
            rows.append({"kind": "choice", "group": ("lead",), "value": d,
                         "label": f"{d:<12} {g['dash']} {LEAD_GLOSS[d]}"})
        if len(ready) > 1:
            rows.append({"kind": "blank"})
            rows.append({"kind": "header", "text": "route"})
            for i, prov in enumerate(state["route"], start=1):
                rows.append({"kind": "route", "prov": prov,
                             "label": f"{i}  {prov}"})
            rows.append({"kind": "info",
                         "text": f"{g['dot']} h/l or </> swap {g['dot']} "
                                 "order is yours, not ours"})
    else:
        rows.append({"kind": "header", "text": "review"})
        route_txt = g["sep"].join(state["route"]) if state["route"] else "—"
        rows.append({"kind": "review", "key": "route", "val": route_txt})
        for prov in ready:
            model = state["models"].get(prov) or "(cli default)"
            rows.append({"kind": "review", "key": prov,
                         "val": f"{model} {g['dot']} {state['effort']}"})
        rows.append({"kind": "review", "key": "voice", "val": state["voice"]})
        rows.append({"kind": "review", "key": "lead", "val": state["lead"]})
        rows.append({"kind": "blank"})
        rows.append({"kind": "header", "text": "extras",
                     "note": "[off by default]"})
        for key, label, gloss in _EXTRAS_ROWS:
            rows.append({"kind": "check", "key": key, "label": label,
                         "gloss": gloss})
        rows.append({"kind": "blank"})
        rows.append({"kind": "action", "act": "write", "label": "write config"})
        rows.append({"kind": "action", "act": "abort", "label": "abort"})
        rows.append({"kind": "blank"})
        rows.append({"kind": "info",
                     "text": f"{g['dot']} backups first {g['dot']} extras "
                             f"default off {g['dot']} re-run anytime"})
    return rows


_FOCUSABLE = ("choice", "custom", "more", "route", "check", "action")


def _paint_cockpit(stdscr, screen: int, rows: list[dict], sel: int,
                   state: dict) -> None:
    g = _ui_glyphs()
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    if h < len(rows) + 4 or w < 70:
        raise _RichUnusable("terminal too small for the cockpit")
    _addstr(stdscr, 0, 0, "teamctl", _cattr("primary") | curses.A_BOLD)
    _addstr(stdscr, 0, 7, f"  {g['dot']}  ", _cattr("dim"))
    _addstr(stdscr, 0, 12, "custom", _cattr("accent"))
    x = 0
    for i, name in enumerate(("1 models", "2 posture", "3 seal"), start=1):
        role = "accent" if i == screen else ("ok" if i < screen else "dim")
        _addstr(stdscr, 1, x, name, _cattr(role))
        x += len(name)
        if i < 3:
            _addstr(stdscr, 1, x, " ── ", _cattr("mute"))
            x += 4
    y = 3
    bar_w = min(w - 4, 96)
    for i, r in enumerate(rows):
        kind = r["kind"]
        if kind == "blank":
            y += 1
            continue
        if kind == "title":
            _addstr(stdscr, y, 2, r["text"], _cattr("primary"))
        elif kind == "header":
            _addstr(stdscr, y, 2, r["text"], _cattr("soft") | curses.A_BOLD)
            if r.get("note"):
                _addstr(stdscr, y, 50, r["note"], _cattr("dim"))
        elif kind == "info":
            _addstr(stdscr, y, 2, r["text"], _cattr("dim"))
        elif kind == "review":
            _addstr(stdscr, y, 4, f"{r['key']:<10}", _cattr("dim"))
            _addstr(stdscr, y, 14, r["val"], _cattr("primary"))
        else:
            focused = (i == sel)
            if kind == "choice":
                committed = _cockpit_get(state, r["group"]) == r["value"]
                label = r["label"]
            elif kind == "check":
                committed = state["extras"][r["key"]]
                label = f"{'[x]' if committed else '[ ]'}  {r['label']:<20} "
            elif kind == "custom":
                committed = r["label"].startswith("custom: ")
                label = r["label"]
            else:
                committed = False
                label = r["label"]
            if focused:
                _addstr(stdscr, y, 2, (g["sel"] + label).ljust(bar_w),
                        _cattr("select"))
                if kind == "check":
                    _addstr(stdscr, y, 2 + len(g["sel"]) + len(label),
                            r["gloss"], _cattr("select"))
            else:
                attr = _cattr("ok") if committed else (
                    _cattr("dim") if kind in ("more", "info") else
                    _cattr("primary"))
                _addstr(stdscr, y, 2, "  " + label, attr)
                if kind == "check":
                    _addstr(stdscr, y, 4 + len(label), r["gloss"],
                            _cattr("dim"))
        y += 1
    _addstr(stdscr, h - 1, 1, _COCKPIT_FOOTERS[screen], _cattr("dim"))
    stdscr.refresh()


def _cockpit_get(state: dict, group: tuple):
    if group[0] == "model":
        return state["models"].get(group[1], "")
    return state[group[0]]


def _cockpit_set(state: dict, group: tuple, value) -> None:
    if group[0] == "model":
        state["models"][group[1]] = value
    else:
        state[group[0]] = value
    state["dirty"] = True


def _edit_custom_model(stdscr, state: dict, prov: str) -> None:
    txt = _curses_prompt(stdscr, f"custom model id for {prov}:")
    state["models"][prov] = txt          # empty = provider default (spec §6.3)
    state["dirty"] = True


def _run_cockpit():
    """Drive the 3-screen cockpit. Returns (state, ready) on write, or one
    of 'abort' | 'cancel' | 'plain', or None when curses cannot run."""
    try:
        import locale
        locale.setlocale(locale.LC_ALL, "")
    except Exception:
        pass
    ready = _usable(_detect_providers())
    discovered = {p: _model_choices(p) for p in ready}
    state = {
        "models": {p: "" for p in ready},
        "effort": "high", "voice": "normal", "lead": "ask",
        "route": sorted(ready),
        "extras": {k: False for k, _l, _g in _EXTRAS_ROWS},
        "dirty": False,
    }

    def run(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        _curses_colors()
        screen = 1 if ready else 2       # nothing to pick without providers
        focus: dict[int, int | None] = {1: None, 2: None, 3: None}
        while True:
            rows = _cockpit_rows(screen, state, ready, discovered)
            focusables = [i for i, r in enumerate(rows)
                          if r["kind"] in _FOCUSABLE]
            if not focusables:
                raise _RichUnusable("nothing to focus")
            if focus[screen] is None:
                if screen == 3:          # fast path: write pre-focused
                    focus[screen] = next(i for i, r in enumerate(rows)
                                         if r.get("act") == "write")
                else:
                    focus[screen] = focusables[0]
            if focus[screen] not in focusables:
                focus[screen] = focusables[0]
            sel = focus[screen]
            _paint_cockpit(stdscr, screen, rows, sel, state)

            ch = stdscr.getch()
            r = rows[sel]
            if ch in (curses.KEY_UP, ord("k")):
                pos = focusables.index(sel)
                focus[screen] = focusables[max(0, pos - 1)]
            elif ch in (curses.KEY_DOWN, ord("j")):
                pos = focusables.index(sel)
                focus[screen] = focusables[min(len(focusables) - 1, pos + 1)]
            elif ch == 9 and screen == 1:        # Tab: next provider block
                headers = [i for i, row in enumerate(rows)
                           if row["kind"] == "header"]
                nxt = next((i for i in headers if i > sel), None)
                if nxt is None and headers:
                    nxt = headers[0]
                if nxt is not None:
                    focus[screen] = next(i for i in focusables if i > nxt)
            elif ch in (10, 13, curses.KEY_ENTER, ord(" ")):
                if r["kind"] == "choice":
                    _cockpit_set(state, r["group"], r["value"])
                elif r["kind"] in ("custom", "more"):
                    _edit_custom_model(stdscr, state, r["prov"])
                elif r["kind"] == "check":
                    state["extras"][r["key"]] = not state["extras"][r["key"]]
                    state["dirty"] = True
                elif r["kind"] == "action" and ch != ord(" "):
                    return r["act"]
            elif ch == ord("e") and r["kind"] in ("custom", "more"):
                _edit_custom_model(stdscr, state, r["prov"])
            elif (ch in (ord("h"), ord("l"), ord("<"), ord(">"))
                  and r["kind"] == "route"):
                order = state["route"]
                idx = order.index(r["prov"])
                delta = -1 if ch in (ord("h"), ord("<")) else 1
                j = idx + delta
                if 0 <= j < len(order):
                    order[idx], order[j] = order[j], order[idx]
                    state["dirty"] = True
                    # follow the moved provider with the focus
                    focus[screen] = sel + delta
            elif ch in (ord("n"), curses.KEY_NPAGE):
                if screen < 3:
                    screen += 1
            elif ch in (ord("b"), curses.KEY_PPAGE):
                if screen > (1 if ready else 2):
                    screen -= 1
            elif ch == 27:                      # Esc: back, or quit from 1st
                if screen > (1 if ready else 2):
                    screen -= 1
                elif _confirm_quit(stdscr, state):
                    return "cancel"
            elif ch == ord("p"):
                return "plain"
            elif ch == ord("q"):
                if _confirm_quit(stdscr, state):
                    return "cancel"
            # anything else (incl. KEY_RESIZE): repaint

    def _confirm_quit(stdscr, st) -> bool:
        if not st["dirty"]:
            return True
        ans = _curses_prompt(stdscr, "quit without writing? [y/N]")
        return ans.lower().startswith("y")

    try:
        outcome = curses.wrapper(run)
    except (_RichUnusable, curses.error):
        return None
    except Exception:
        return None
    if outcome == "write":
        return (state, ready)
    return outcome


def _apply_cockpit(state: dict, ready: list[str]) -> int:
    g = _out_glyphs()
    providers_cfg = {p: {"model": state["models"].get(p, ""),
                         "effort": state["effort"]} for p in ready}
    changes: list[tuple[str, str]] = []
    cfg_path, backed_up = _write_wizard_config(
        providers_cfg, state["voice"], list(state["route"]), state["lead"],
        changes)
    ex = state["extras"]
    if ex["tmux"]:
        _install_tmux_block(changes)
    if ex["statusline"]:
        _install_statusline(changes)
    if ex["lead"]:
        _install_lead(changes, want_hook=ex["hook"])
    elif ex["hook"]:
        _lead_install_hook(changes)

    print()
    print("  " + _fg("ok", "wrote the map"))
    print("    " + _fg("dim", _tilde(cfg_path)))
    if backed_up:
        print("    " + _fg("dim",
                           f"prior config {g['arrow']} config.toml.bak-teamctl"))
    print()
    print("  from here")
    spawn_prov = state["route"][0] if state["route"] else "claude"
    for cmd_line in ("teamctl providers",
                     f"teamctl spawn reviewer --provider {spawn_prov}",
                     "teamctl config --menu"):
        print("    " + _fg("primary", cmd_line))
    installed = [("tmux block", "source: tmux source-file ~/.tmux.conf")
                 if ex["tmux"] else None,
                 ("statusline", "~/.local/bin/claude-statusline")
                 if ex["statusline"] else None,
                 ("lead mode", "teamctl lead status")
                 if ex["lead"] else None]
    installed = [x for x in installed if x]
    if installed:
        print()
        for name, note in installed:
            print(f"  + {name:<14} {note}")
        print("  " + _fg("dim", f"revert notes: teamctl lead off {g['dot']} "
                                "backups *.bak-teamctl"))
    return 0


