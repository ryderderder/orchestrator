                     choices=[*LEAD_BLOCK_FILES, "all"],
                     help="which CLI's identity to manage (default: every "
                          "detected CLI for on; everything for off)")
    lp2.add_argument("--hook", action="store_true",
                     help="with 'on': install the per-prompt reminder hook "
                          "(Claude Code) without asking")
    lp2.set_defaults(func=cmd_lead)

    lnp = sub.add_parser(
        "launch",
        help="open the default lead session (also what bare `teamctl` does "
             "on a terminal): the default chat provider, in the teamctl "
             "tmux session, with lead mode on")
    lnp.add_argument("--dry-run", action="store_true",
                     help="print the launch plan without starting anything")
    lnp.set_defaults(func=cmd_launch)

    stp = sub.add_parser(
        "settings",
        help="interactive settings cockpit (dark-room curses UI over the "
             "same config; degrades to current values + `teamctl config` "
             "one-liners without a TTY)")
