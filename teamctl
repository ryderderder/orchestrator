    fp = sub.add_parser("followup", help="send another turn to the same teammate session")
    fp.add_argument("role")
    fp.add_argument("--task", required=True, help="the follow-up task")
    fp.set_defaults(func=cmd_followup)

    rsp = sub.add_parser(
        "resurrect",
        help="rebuild teammates lost to a crash/reboot: fresh respawn "
             "with the recorded provider/model/effort/cwd/worktree "
             "(interactive context is honestly NOT restored; dispatch "
             "mates resume exactly via followup instead)")
    rsp.add_argument("roles", nargs="*",
                     help="lost roles to rebuild (default: all)")
    rsp.add_argument("--dry-run", action="store_true",
                     help="print the plan; change nothing")
    rsp.add_argument("--json", action="store_true",
                     help="with --dry-run: the plan as JSON")
    rsp.add_argument("--yes", action="store_true",
                     help="respawn without the confirmation prompt")
    rsp.set_defaults(func=cmd_resurrect)

    ld = sub.add_parser(
        "land",
        help="land a teammate's worktree branch: review the diff, "
             "checkpoint uncommitted work (with consent), merge into "
             "your checked-out branch, clean up")
    ld.add_argument("role", help="role whose worktree to land (works "
                                 "after shutdown/reboot too)")
    ld.add_argument("--into", default="",
                    help="assert the target branch (must already be "
                         "checked out — teamctl never switches branches)")
    ld.add_argument("--checkpoint-only", action="store_true",
                    dest="checkpoint_only",
                    help="commit uncommitted work on the teammate's "
                         "branch and stop (no merge)")
    ld.add_argument("--keep", action="store_true",
                    help="keep the worktree and branch after landing")
    ld.add_argument("--yes", action="store_true",
                    help="checkpoint without asking")
    ld.add_argument("--dry-run", action="store_true",
                    help="print the land plan (diffstat, counts) and exit")
    ld.add_argument("--json", action="store_true",
                    help="machine-readable plan/result")
    ld.set_defaults(func=cmd_land)

    wp = sub.add_parser(
        "worktree",
        help="list or prune teamctl-created worktrees (the audit/recovery "
             "surface — never removes anything with un-landed work)")
    wp.add_argument("action", choices=["list", "prune"])
    wp.add_argument("--json", action="store_true",
                    help="machine-readable output (list)")
    wp.add_argument("--dry-run", action="store_true",
                    help="prune: show what would be removed, remove nothing")
    wp.set_defaults(func=cmd_worktree)

    rt = sub.add_parser("route", help="pick the best available provider and dispatch")
    rt.add_argument("role")
    rt.add_argument("--task", required=True, help="the task/instruction")
    rt.add_argument("--providers", default="",
                    help="comma-separated candidate providers (default: every "
                         "routable provider; ranked by your [routing] "
                         "preference/strategy)")
    rt.add_argument("--model", default="", help="override model")
    rt.add_argument("--effort", default="", help="override effort/reasoning level")
    rt.add_argument("--cwd", default="", help="working directory for the teammate")
    rt.add_argument("--worktree", action=argparse.BooleanOptionalAction,
                    default=None,
                    help="isolate the teammate in its own git worktree "
                         "(default: [worktree] enabled — on)")
    rt.add_argument("--dry-run", action="store_true",
                    help="print selection + launch line without opening a pane")
    rt.set_defaults(func=cmd_route)

    pp = sub.add_parser("providers", help="show provider install/auth/credit status")
    pp.add_argument("--json", action="store_true")
    pp.set_defaults(func=cmd_providers)

    ud = sub.add_parser(
        "update",
        help="update teamctl from its recorded install source "
             "(--check: just compare versions)")
    ud.add_argument("--check", action="store_true",
                    help="print installed vs latest and exit; change nothing")
    ud.add_argument("--refresh-cache", action="store_true",
                    dest="refresh_cache", help=argparse.SUPPRESS)
    ud.set_defaults(func=cmd_update)

    up = sub.add_parser("usage", help="show real provider usage %%/reset where exposed")
    up.add_argument("--json", action="store_true")
    up.add_argument("--probe", nargs="?", const="all", default="",
                    metavar="PROVIDER",
                    help="first refresh usage by running the provider TUI's own "
                         "usage command in a hidden background tmux session "
                         "(grok /usage, codex /status; claude uses the "
                         "statusline cache instead). Default: all probe-able")
    up.set_defaults(func=cmd_usage)

    mo = sub.add_parser("models",
                        help="best-effort model discovery per provider (ids "
                             "always pass through verbatim — new models need "
                             "no teamctl update)")
    mo.add_argument("provider", nargs="?", default="",
                    help="any routable provider (default: all)")
    mo.set_defaults(func=cmd_models)

    slp = sub.add_parser(
        "statusline",
        help="Claude Code statusLine command: reads session JSON on stdin, "
             "prints 'model · effort · ctx N%%' (wired by `teamctl init`)")
    slp.set_defaults(func=lambda _a: cmd_statusline())

    unp = sub.add_parser(
        "uninstall",
        help="remove teamctl's binary, tmux block, statusLine wiring and "
             "metadata (config/state kept; lead mode via `teamctl lead off`)")
    unp.add_argument("--yes", action="store_true",
                     help="do not ask for confirmation")
    unp.set_defaults(func=cmd_uninstall)

    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:]) if argv is None else list(argv)
    # hot path: the statusline runs on every Claude Code render — skip
    # argparse construction entirely (it exists as a subparser only so
    # `--help` documents it)
    if argv[:1] == ["statusline"]:
        return cmd_statusline()
    # bare `teamctl` on a real terminal is the front door: open the default
    # lead session. Piped/CI (no tty) keeps the usage text unchanged, so
    # scripts and `teamctl | cat` behave exactly as before.
    if not argv:
        try:
            interactive = sys.stdin.isatty() and sys.stdout.isatty()
        except (AttributeError, ValueError):
            interactive = False
        if interactive:
            argv = ["launch"]
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except TeamctlError as exc:
        print(f"teamctl: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
