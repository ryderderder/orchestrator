# plain path — spec §5: few prompts, Express defaults on blank
# --------------------------------------------------------------------------

def _snap(value: str, allowed: tuple, default: str) -> str:
    v = value.strip().lower()
    if v in allowed:
        return v
    if v and v != default:
        print(f"  snapped to {default}")
    return default


def _plain_init(args: argparse.Namespace) -> int:
    rows = _detect_providers()
    ready = sorted(_usable(rows))
    print("teamctl init — plain path")
    print()
    for prov, state in rows:
        print(f"  {prov:<7} {state}")
    print()

    models: dict[str, str] = {}
    if ready:
        print("  model per provider [enter = cli default]")
        for prov in ready:
            models[prov] = _ask(f"  {prov}: ")
        print()
    effort = _snap(_ask("  effort [high]: ", "high"), EFFORT_CHOICES, "high")
    voice = _snap(_ask("  voice  [normal]: ", "normal"), VOICE_CHOICES,
                  "normal")
    lead = _snap(_ask("  lead   [ask]: ", "ask"), LEAD_CHOICES, "ask")
    route = list(ready)
    if len(ready) > 1:
        raw = _ask(f"  route  [{','.join(route)}]: ")
        if raw:
            chosen = [p.strip() for p in raw.split(",") if p.strip()]
            picked = [p for p in chosen if p in ready]
            if picked:                   # unknowns dropped silently (§6.3)
                route = picked
    print()

    cfg_path = Path.home() / ".config" / "agent-team" / "config.toml"
    if not _ask_yn(f"  write {_tilde(cfg_path)}? [Y/n] ", default=True):
        print("  nothing written.")
        return 0
    providers_cfg = {p: {"model": models.get(p, ""),
                         "effort": (effort if provider_supports_effort(p)
                                    else "")}
                     for p in ready}
    changes: list[tuple[str, str]] = []
    path, backed_up = _write_wizard_config(providers_cfg, voice, route, lead,
                                           changes)
    g = _out_glyphs()
    print(f"  wrote {_tilde(path)}"
          + (f"  (prior {g['arrow']} config.toml.bak-teamctl)"
             if backed_up else ""))

    if os.environ.get("TEAMCTL_INIT_EXTRAS") == "1":
        if _ask_yn("  add tmux pane-border block? [y/N] "):
            _install_tmux_block(changes)
        if _ask_yn("  install claude statusline? [y/N] "):
            _install_statusline(changes)
        if _ask_yn("  install lead mode? [y/N] "):
            _install_lead(changes, want_hook=_ask_yn(
                "  with per-prompt hook? [Y/n] ", default=True))
    else:
        print(f"  extras (tmux borders {g['dot']} statusline {g['dot']} lead "
              "mode): teamctl init --custom, or teamctl lead on")
    return 0


# --------------------------------------------------------------------------
# express — spec §3: zero questions, one frame
# --------------------------------------------------------------------------

def _init_express(args: argparse.Namespace) -> int:
    """Zero-question setup: detect providers, lock sane defaults, write the
    config, print one frame (spec §3.3–3.8). `--yes` keeps its scripted
    contract: same writes, no chrome."""
    # session-start update line — evaluated BEFORE the config write, so the
    # [update] settings in force when this session started decide it
    upd_line = None if getattr(args, "yes", False) else _session_update_line()
    rows = _detect_providers()
    ready = _usable(rows)
    # a provider with no effort control (gemini) gets no effort key — an
    # unusable setting must not be written just to be ignored later
    providers_cfg = {p: {"model": "",
                         "effort": ("high" if provider_supports_effort(p)
                                    else "")}
                     for p in ready}
    preference = sorted(ready)
    changes: list[tuple[str, str]] = []
    cfg_path, backed_up = _write_wizard_config(
        providers_cfg, "normal", preference, "ask", changes)

    if getattr(args, "yes", False):      # scripted: machine-readable, no chrome
        print(f"wrote {cfg_path}"
              + (" (backup: config.toml.bak-teamctl)" if backed_up else ""))
        return 0

    g = _out_glyphs()
    word_role = {"ready": "ok", "quiet": "soft", "locked out": "warn",
                 "not installed": "dim", "unknown": "dim"}
    out = [""]
    out.append("            " + _fg("accent", "t e a m c t l"))
    out.append("         " + _fg("border", g["rule"] * 17))
    out.append("")
    for prov, state in rows:
        line = ("  " + _fg("dim", g["dot"]) + f" {prov:<12}"
                + _fg(word_role.get(state, "dim"), state))
        if state == "quiet":
            line += _fg("dim", f" {g['dash']} signed in, wakes on first use")
        out.append(line)
    out.append("")
    out.append("  " + _fg("primary", "defaults locked"))
    route_val = (_fg("primary", f" {g['chev']} ".join(preference))
                 if preference else _fg("dim", g["dash"]))
    for key, val in (("route", route_val),
                     ("model", _fg("primary", "(cli default)")),
                     ("effort", _fg("primary", "high")),
                     ("voice", _fg("primary", "normal")),
                     ("lead", _fg("primary", "ask"))):
        out.append("    " + _fg("dim", f"{key:<10}") + val)
    out.append("")
    out.append("  " + _fg("ok", "wrote") + "  " + _fg("dim", _tilde(cfg_path)))
    if backed_up:
        out.append("  " + _fg("dim", f"prior config {g['arrow']} "
                                     "config.toml.bak-teamctl"))
    if not ready:
        if any(state == "locked out" for _p, state in rows):
            out.append("  " + _fg("dim", "log a provider in, then re-run"))
        else:
            out.append("  " + _fg("dim",
                                  "install a provider CLI, then re-run"))
    out.append("")
    out.append("  " + _fg("dim", f"customize {g['arrow']}  ")
               + _fg("soft", "teamctl init --custom"))
    if upd_line:
        out.append("  " + _fg("dim", f"{g['dot']} {upd_line}"))
    # installer first-run (A2): the curl|bash path lands the user inside
    # tmux with the pitch's headline feature — a lead + teammates — dark.
    # So the very first landing actually ENABLES lead mode (reversible; it
    # is just the manager identity in each CLI's instructions file, not a
    # running/billable session) and the frame shows the moves. Gated to the
    # installer (TEAMCTL_FIRST_RUN) so a standalone `teamctl init` keeps its
    # tight spec-§7 frame and never enables lead mode behind the user.
    if os.environ.get("TEAMCTL_FIRST_RUN") == "1":
        lead_clis = _enable_lead_mode_quiet() if ready else []
        out.extend(_first_run_orientation(preference, lead_clis, g))
    # A3: the installer's "$BIN_DIR not on PATH" warning is wiped by the
    # tmux takeover — re-print it durably inside the frame when the
    # installer flags it (TEAMCTL_PATH_NOTE=<dir>).
    path_note = os.environ.get("TEAMCTL_PATH_NOTE", "")
    if path_note:
        out.append("")
        out.append("  " + _fg("warn", f"{path_note} is not on your PATH"))
        out.append("    " + _fg("dim", 'add it: export PATH="'
                                + path_note + ':$PATH"'))
    print("\n".join(out))
    return 0


def _enable_lead_mode_quiet() -> list[str]:
    """Install lead mode for every detected CLI, suppressing the per-file
    chatter (the express frame prints its own one-line summary). Returns
    the CLIs that now carry the lead identity. Idempotent and reversible
    (`teamctl lead off`); no interactive hook prompt."""
    selected = _lead_selected_clis("")
    changes: list[tuple[str, str]] = []
    buf = io.StringIO()
    saved = sys.stdout
    sys.stdout = buf
    try:
        if "claude" in selected:
            _lead_install_skill(changes)
        for cli in selected:
            _lead_install_block(cli, changes)
    except Exception:            # lead mode is a bonus; never break init
        pass
    finally:
        sys.stdout = saved
    return selected


def _first_run_orientation(preference: list[str], lead_clis: list[str],
                           g: dict) -> list[str]:
    """The 'you're in tmux — here's your first move' block for the curl|bash
    first run (A2). Lead mode is already ENABLED by the caller, so this tells
    the user to just type `teamctl` to open the lead chat, shows one real
    spawn example, and orients them in tmux. Provider-agnostic."""
    prov = preference[0] if preference else "<provider>"
    lines = ["",
             "  " + _fg("soft", "you're in tmux") + _fg("dim",
                       " — your team tiles into the panes on the right")]
    lines.append("    " + _fg("dim", "talk to your lead  ")
                 + _fg("primary", "teamctl")
                 + _fg("dim", "   (opens your lead chat right here)"))
    if preference:
        lines.append("    " + _fg("dim", "or spawn one now   ")
                     + _fg("primary",
                           f"teamctl spawn reviewer --provider {prov}"))
    else:
        lines.append("    " + _fg("dim", "sign a provider in, then  ")
                     + _fg("primary", "teamctl"))
    if lead_clis:
        pretty = ", ".join(lead_clis)
        lines.append("  " + _fg("ok", "lead mode on")
                     + _fg("dim", f"  {pretty}  {g['dot']}  reverse: "
                                  "teamctl lead off"))
    return lines


def _init_custom(args: argparse.Namespace) -> int:
    if not _use_rich_ui():
        print("no tty. plain path.")
        print()
        return _plain_init(args)
    outcome = _run_cockpit()
    if outcome == "plain":
        print()
        return _plain_init(args)
    if outcome == "cancel":
        print("cancelled — nothing was written.")
        return 1
    if outcome == "abort":
        print("left without writing.")
        return 0
    if isinstance(outcome, tuple):
        state, ready = outcome
        return _apply_cockpit(state, ready)
    # curses blew up mid-flight: degrade, still functional
    print("no tty. plain path.")
    print()
    return _plain_init(args)


def cmd_init(args: argparse.Namespace) -> int:
    _maybe_spawn_update_check()          # detached + cached; never blocks
    if getattr(args, "custom", False):
        return _init_custom(args)
    return _init_express(args)


def _write_wizard_config(providers_cfg: dict[str, dict[str, str]],
                         verbosity: str, preference: list[str],
                         delegation: str,
                         changes: list[tuple[str, str]]) -> tuple[Path, bool]:
    """Back up + write config.toml; returns (path, backed_up). Shared by the
    express, line-prompt, and curses init paths so all three write the exact
    same schema."""
    cfg_path = Path.home() / ".config" / "agent-team" / "config.toml"
    backed_up = False
    if cfg_path.exists():
        shutil.copy2(cfg_path, cfg_path.with_name("config.toml.bak-teamctl"))
        backed_up = True
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text(
        _render_config(providers_cfg, verbosity, preference, delegation))
    changes.append((
        f"wrote {cfg_path}",
        f"rm {cfg_path}"
        + (f"  (or restore {cfg_path.with_name('config.toml.bak-teamctl')})"
           if backed_up else ""),
    ))
    return cfg_path, backed_up


def _install_tmux_block(changes: list[tuple[str, str]]) -> None:
    home = Path.home()
    conf = home / ".tmux.conf"
    text = conf.read_text() if conf.exists() else ""
    if TMUX_MARKER_BEGIN in text:
        print(f"{conf} already contains the teamctl block — skipping.")
        return
    if conf.exists():
        bak = home / ".tmux.conf.bak-teamctl"
        shutil.copy2(conf, bak)
        print(f"backed up {conf} to {bak}")
    with open(conf, "a") as fh:
        if text and not text.endswith("\n"):
            fh.write("\n")
        fh.write("\n" + TMUX_BLOCK)
    print(f"appended teamctl block to {conf}")
    print("apply it now with: tmux source-file ~/.tmux.conf")
    changes.append((
        f"appended a marker-guarded block to {conf}",
        "delete the block between the '# --- BEGIN teamctl ---' and "
        f"'# --- END teamctl ---' lines (or restore {home / '.tmux.conf.bak-teamctl'}), "
        "then reset the live options: tmux set-option -gu pane-border-status; "
        "tmux set-option -gu pane-border-format; tmux set-option -gu status-right; "
        "tmux set-option -gu @teamctl_status_added",
    ))


def _install_statusline(changes: list[tuple[str, str]]) -> None:
    """Wire Claude Code's statusLine to `teamctl statusline` (since the
    v0.4.0 fold there is no separate file to copy — the statusline is a
    teamctl subcommand). Legacy wirings/files are migrated first."""
    for note in _migrate_legacy_statusline():
        print(note)
