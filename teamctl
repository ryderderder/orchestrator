        if not isinstance(data, dict):
            print(f"could not parse {settings_path} — leaving it untouched.")
            print('add this key yourself:  "statusLine": '
                  + json.dumps(STATUSLINE_ENTRY))
        elif isinstance(data.get("statusLine"), dict) \
                and data["statusLine"].get("command") \
                in _our_statusline_commands():
