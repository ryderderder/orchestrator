TMUX_MARKER_BEGIN = "# --- BEGIN teamctl ---"
TMUX_MARKER_END = "# --- END teamctl ---"
TMUX_BLOCK = TMUX_MARKER_BEGIN + """
# Added by `teamctl init`. Reversible: delete this block (including the
# BEGIN/END marker lines) and run `tmux source-file ~/.tmux.conf`.
#
# Sticky per-pane border label showing a teammate pane's "role · model",
# read from the @role/@model per-pane user options teamctl sets at spawn.
# Panes teamctl didn't spawn have no @model and get an empty label.
# User options are used because provider CLIs overwrite pane titles, and
# some tmux builds do not execute #() shell commands in status formats.
set-option -g pane-border-status top
set-option -g pane-border-format '#{?#{@model}, #{@role} · #{@model} ,}'
# Append the active pane's "role · model" to the status bar. Guarded so
# re-sourcing this file does not append the segment a second time.
if-shell -F '#{?@teamctl_status_added,0,1}' {
  set-option -g @teamctl_status_added 1
  set-option -ga status-right ' #{?#{@model},│ #{@role} · #{@model} ,}'
}
""" + TMUX_MARKER_END + "\n"

STATUSLINE_ENTRY = {"type": "command", "command": "~/.local/bin/claude-statusline"}


def _input(prompt: str) -> str:
    """Thin wrapper around input() so tests can script wizard answers."""
    return input(prompt)


def _ask(prompt: str, default: str = "") -> str:
    # EOFError: real stdin ran dry (non-tty). StopIteration: a scripted
    # _input (tests) ran out of answers — same meaning, same default.
    try:
        raw = _input(prompt).strip()
    except (EOFError, StopIteration):
        return default
    return raw or default


def _ask_yn(prompt: str, default: bool = False) -> bool:
    raw = _ask(prompt).lower()
    if not raw:
        return default
    return raw in ("y", "yes")


def _toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _detect_providers() -> list[tuple[str, bool, bool]]:
    """(provider, installed, authed) for every routable provider."""
    return [(prov, shutil.which(prov) is not None, provider_authed(prov))
            for prov in ROUTABLE]


def _render_config(providers_cfg: dict[str, dict[str, str]], verbosity: str,
                   preference: list[str] | None = None,
                   delegation: str = "ask") -> str:
    lines = [
        "# agent-team configuration (written by `teamctl init`)",
        "# Delete this file to fall back to each provider CLI's own defaults.",
        "",
        "[output]",
        f'verbosity = "{_toml_escape(verbosity)}"',
        "",
        "[lead]",
        "# how a lead agent decides to delegate: ask | always | manual",
        f'delegation = "{_toml_escape(delegation)}"',
    ]
    if preference:
        lines += [
            "",
            "[routing]",
            "# your auto-routing order (also the --provider default);",
            "# reorder any time: teamctl config routing.preference \"a,b,c\"",
            f"preference = {_toml_value(list(preference))}",
        ]
    for prov, vals in providers_cfg.items():
        lines += ["", f"[providers.{prov}]"]
        wrote = False
        for key in ("model", "effort"):
            if vals.get(key):
                lines.append(f'{key} = "{_toml_escape(vals[key])}"')
                wrote = True
        if not wrote:
            lines.append(f'# model = ""   # unset: {prov} uses its own defaults')
            lines.append('# effort = ""')
    return "\n".join(lines) + "\n"


def cmd_init(args: argparse.Namespace) -> int:
    home = Path.home()
    changes: list[tuple[str, str]] = []

    print("teamctl init — set up defaults and optional integrations.")
    print("A summary of everything changed, with exact revert steps, is")
    print("printed at the end. Optional steps default to 'no'.\n")

    print("Provider CLIs:")
    available: list[str] = []
    for prov, installed, authed in _detect_providers():
        if not installed:
            status = "not installed"
        elif not authed:
            status = "installed, but not logged in (log in, then re-run `teamctl init`)"
        else:
            status = "available"
            available.append(prov)
        print(f"  {prov:<7} {status}")
    print()

    providers_cfg: dict[str, dict[str, str]] = {}
    for prov in available:
        if args.yes:
            providers_cfg[prov] = {"model": "", "effort": ""}
            continue
        print(f"{prov}: choose defaults (leave blank to keep the CLI's own default).")
        known = discover_models(prov)
        if known:
            print(f"  {prov} currently reports: {', '.join(known[:10])}")
        model = _ask(f"  default model for {prov} (any id works — the CLI validates it): ")
        if prov == "grok":
            print("  note: grok has no persistent effort setting of its own;")
            print("  teamctl passes your choice per invocation via --effort.")
        effort = _ask(f"  default effort for {prov} (e.g. low, medium, high): ")
        providers_cfg[prov] = {"model": model, "effort": effort}

    # -- routing order: the user's, never teamctl's -------------------------
    preference: list[str] = []
    if len(available) == 1:
        preference = list(available)
    elif len(available) > 1:
        if args.yes:
            preference = sorted(available)  # alphabetical: arbitrary, documented
        else:
            raw = _ask("Order your providers for auto-routing, best first, "
                       f"comma-separated [detected: {', '.join(available)}]: ")
            if raw:
                chosen = [p.strip() for p in raw.split(",") if p.strip()]
                unknown = [p for p in chosen if p not in available]
                if unknown:
                    print(f"  ignoring unknown/unavailable: {', '.join(unknown)}")
                preference = [p for p in chosen if p in available]
            if not preference:
                preference = sorted(available)
                print("  no order given — using alphabetical "
                      f"({' > '.join(preference)}), which is arbitrary; "
                      "change it any time with `teamctl config routing.preference`.")

    verbosity = "normal"
    if not args.yes:
        v = _ask("Output verbosity — terse / normal / detailed [normal]: ",
                 "normal").lower()
        if v in ("terse", "normal", "detailed"):
            verbosity = v
        else:
            print(f"  unrecognized verbosity '{v}'; using 'normal'")

    delegation = "ask"
    if not args.yes:
        print("Delegation posture — when should a lead agent hand work to")
        print("teamctl teammates? ask = it checks with you once per session;")
        print("always = it delegates non-trivial work by default;")
        print("manual = single-agent unless you explicitly ask.")
        d = _ask("Default delegation posture — ask / always / manual [ask]: ",
                 "ask").lower()
        if d in ("ask", "always", "manual"):
            delegation = d
        else:
            print(f"  unrecognized posture '{d}'; using 'ask'")

    cfg_path = home / ".config" / "agent-team" / "config.toml"
    backed_up = False
    if cfg_path.exists():
        shutil.copy2(cfg_path, cfg_path.with_name("config.toml.bak-teamctl"))
        backed_up = True
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text(
        _render_config(providers_cfg, verbosity, preference, delegation))
    print(f"\nwrote {cfg_path}"
          + (" (previous file backed up to config.toml.bak-teamctl)" if backed_up else ""))
    changes.append((
        f"wrote {cfg_path}",
        f"rm {cfg_path}"
        + (f"  (or restore {cfg_path.with_name('config.toml.bak-teamctl')})"
           if backed_up else ""),
    ))

    # -- optional: tmux pane borders + status-bar segment ------------------
    want_tmux = False if args.yes else _ask_yn(
        "Add teamctl pane-border/status-bar block to ~/.tmux.conf? [y/N] ")
    if want_tmux:
        conf = home / ".tmux.conf"
        text = conf.read_text() if conf.exists() else ""
        if TMUX_MARKER_BEGIN in text:
            print(f"{conf} already contains the teamctl block — skipping.")
        else:
            if conf.exists():
                bak = home / ".tmux.conf.bak-teamctl"
                shutil.copy2(conf, bak)
                print(f"backed up {conf} to {bak}")
            with open(conf, "a") as fh:
                if text and not text.endswith("\n"):
                    fh.write("\n")
                fh.write("\n" + TMUX_BLOCK)
            print(f"appended teamctl block to {conf}")
            print("apply it now with: tmux source-file ~/.tmux.conf")
            changes.append((
                f"appended a marker-guarded block to {conf}",
                "delete the block between the '# --- BEGIN teamctl ---' and "
                f"'# --- END teamctl ---' lines (or restore {home / '.tmux.conf.bak-teamctl'}), "
                "then reset the live options: tmux set-option -gu pane-border-status; "
                "tmux set-option -gu pane-border-format; tmux set-option -gu status-right; "
                "tmux set-option -gu @teamctl_status_added",
            ))

    # -- optional: Claude Code status line ---------------------------------
    want_statusline = False if args.yes else _ask_yn(
        "Install claude-statusline for Claude Code's status line "
        "(shows model · effort · ctx%)? [y/N] ")
    if want_statusline:
        dest = home / ".local" / "bin" / "claude-statusline"
        src: Path | None = Path(__file__).resolve().parent / "claude-statusline"
        if not src.exists():
            found = shutil.which("claude-statusline")
            src = Path(found) if found else None
        if src is None:
            print("could not find claude-statusline next to teamctl or on PATH — "
                  "skipping this step.")
        else:
            dest.parent.mkdir(parents=True, exist_ok=True)
            if src.resolve() != dest.resolve():
                shutil.copy2(src, dest)
            os.chmod(dest, 0o755)
            print(f"installed {dest}")
            changes.append((f"installed {dest}", f"rm {dest}"))

            settings_path = home / ".claude" / "settings.json"
            if settings_path.exists():
                try:
                    data = json.loads(settings_path.read_text())
                except (json.JSONDecodeError, OSError):
                    data = None
                if not isinstance(data, dict):
                    print(f"could not parse {settings_path} — leaving it untouched.")
                    print('add this key yourself:  "statusLine": '
                          + json.dumps(STATUSLINE_ENTRY))
                elif "statusLine" in data:
                    print(f"{settings_path} already has a statusLine key — "
                          "leaving it as is.")
                else:
                    bak = Path(str(settings_path) + ".bak-teamctl")
                    shutil.copy2(settings_path, bak)
                    data["statusLine"] = dict(STATUSLINE_ENTRY)
                    settings_path.write_text(json.dumps(data, indent=2) + "\n")
                    print(f"added statusLine key to {settings_path} (backup: {bak})")
                    changes.append((
                        f"added a statusLine key to {settings_path}",
                        f"restore {bak}, or delete the statusLine key",
                    ))
            else:
                settings_path.parent.mkdir(parents=True, exist_ok=True)
                settings_path.write_text(
                    json.dumps({"statusLine": dict(STATUSLINE_ENTRY)}, indent=2) + "\n")
                print(f"created {settings_path} with a statusLine key")
                changes.append((f"created {settings_path}", f"rm {settings_path}"))

    # -- optional: lead mode (manager identity for a lead agent) ------------
    want_lead = False if args.yes else _ask_yn(
        "Install lead mode for your agent CLIs (teamctl lead on)? [y/N] ")
    if want_lead:
        selected = _lead_selected_clis("")
        if "claude" in selected:
            _lead_install_skill(changes)
        for cli in selected:
            _lead_install_block(cli, changes)
        if "claude" in selected:
            if _lead_status()["hook"] == "installed":
                print("settings.json already has a teamctl-lead hook — skipping.")
            elif _ask_yn("Also install the per-prompt reminder hook (recommended "
                         "— survives context compaction)? [Y/n] ", default=True):
                _lead_install_hook(changes)

    print("\nSummary of changes:")
    for what, revert in changes:
        print(f"  * {what}")
        print(f"    revert: {revert}")
    if not changes:
        print("  nothing was changed")
    _print_controls()
    return 0


# --------------------------------------------------------------------------
# `teamctl lead` — durable manager identity for a Claude Code lead agent.
#
# Three tiers, individually reversible, all marker-guarded or key-guarded:
#   1. skill      ~/.claude/skills/teamctl-lead/SKILL.md — discoverable; Claude
#                 loads it when delegation/teammate topics come up.
#   2. CLAUDE.md  a marker-guarded block — always in context at session start.
#   3. hook       a UserPromptSubmit echo in ~/.claude/settings.json — the
#                 strongest tier: its stdout is re-injected into context on
#                 every prompt, so it survives context compaction (which can
#                 drop the CLAUDE.md text from a long session).
# --------------------------------------------------------------------------

LEAD_MD_BEGIN = "<!-- BEGIN teamctl-lead -->"
LEAD_MD_END = "<!-- END teamctl-lead -->"

LEAD_CLAUDE_BLOCK = LEAD_MD_BEGIN + """
## teamctl lead mode
<!-- Added by `teamctl lead on`; remove with `teamctl lead off`. -->
You are the LEAD of a teamctl agent team (teammates run as tmux panes to
your right). Keep this chat free and responsive for the user's dynamic
tasks: delegate all non-trivial work to teammates via `teamctl
spawn`/`dispatch`/`route`. Before spawning a teammate or planning anything
large, run `teamctl usage` and `teamctl providers`, then choose
provider/model/effort from that live data, the user's preferences
(~/.config/agent-team/config.toml — see `teamctl config`), and task fit.
Use descriptive role names; never point two teammates at the same file;
shut each teammate down (`teamctl shutdown <role>`) the moment its job is
done — zero idle teammates.
Delegation posture: honor `teamctl config lead.delegation` (ask / always /
manual; missing = ask). ask = the FIRST time non-trivial work comes up in
a session, ask once whether to use teamctl agent teams (parallel
teammates; taps the user's other AI subscriptions and uses more, and
different, resources) or stay single-agent; offer to remember the answer
("always" / "never" -> `teamctl config lead.delegation always|manual`)
and do not re-ask that session. manual = single-agent unless the user
asks. Whatever the posture, a genuinely large task (multi-file,
parallelizable, long-running) earns ONE offer per session to spin up a
team — never nag; a no is final for the session. The user's explicit
instructions always override these rules.
""" + LEAD_MD_END + "\n"

LEAD_SKILL_MD = """\
---
name: teamctl-lead
description: Lead-agent discipline for running an agent team with teamctl. Use when delegating work, spawning or shutting down teammates, planning multi-agent or parallel efforts, choosing a provider/model/effort for a task, or checking team capacity, usage, and provider availability.
---

# teamctl lead mode

You are the LEAD agent of a teamctl agent team. Your pane is the user's
main chat; teammates are tmux panes tiled to your right.

## Standing rules

1. **Stay responsive.** Keep this main chat free for the user's dynamic
   tasks. Delegate all non-trivial work to teammates (`teamctl spawn`,
   `teamctl dispatch`, `teamctl route`); handle only trivial replies and
   one-line edits yourself.
2. **Decide capacity from live data, not habit.** Before spawning a
   teammate, planning a multi-agent effort, or dispatching anything large:
   run `teamctl usage` (real usage %/reset times where the provider
   exposes them) and `teamctl providers` (installed / authed / exhausted).
   Pick the provider, model, and effort from that live data, the user's
   preferences (`~/.config/agent-team/config.toml`, adjustable via
   `teamctl config`), and task fit — light/cheap models for mechanical
   work, heavyweight for hard reasoning. `teamctl route` automates the
   pick and `teamctl models` shows what each provider currently offers.
   Keep the numbers fresh: occasionally run `teamctl usage --probe all`
   (each provider's own usage command, in a hidden background tmux
   session the user never sees) — do a check-in before any large
   dispatch wave.
3. **Name teammates by role.** Descriptive role names (`code-reviewer`,
   `api-researcher`), one clear deliverable each.
4. **One owner per file.** Never point two teammates at the same file; use
   extra teammates as reviewers of a single owner's work.
5. **Zero idle teammates.** Shut each teammate down the moment its job is
   done (`teamctl shutdown <role>`). No lingering panes.
6. **The user overrides everything.** The user's explicit instructions
   always take precedence over these rules.

## Command reference

    teamctl spawn <role> --provider claude|codex|grok [--model M] [--effort E] [--prompt TEXT]
    teamctl dispatch <role> --provider P --task "…"   # headless, watchable pane
    teamctl result <role> --wait                      # read the result back
    teamctl followup <role> --task "…"                # another turn, same session
    teamctl route <role> --task "…"                   # auto-pick best provider
    teamctl send <role> "…"                           # type into a live teammate
    teamctl list / teamctl usage / teamctl providers
    teamctl shutdown <role>                           # always, as soon as done

## Delegation posture

Read the user's posture from `teamctl config lead.delegation`
(ask / always / manual; missing or unreadable = ask). The per-prompt hook
also echoes the live value as `delegation=<value>`.

- **always** — delegate non-trivial work to teamctl teammates by default.
- **manual** — work single-agent; use teamctl only when the user asks.
- **ask** — the FIRST time non-trivial or code-executing work comes up in
  a session, ask once, plainly: "Want me to use teamctl agent teams for
  work like this (parallel teammates, can tap your other AI
  subscriptions — uses more, and different, resources), or stick to
  regular single-agent work?" Then offer to make it permanent: "I can
  remember this — say 'always', 'never' (manual), or I'll ask again next
  session." Persist an answer with
  `teamctl config lead.delegation always|manual` and confirm it back.
  One and done — never re-ask in the same session.

**Escalation valve (all postures, including manual):** when a task is
genuinely large — multi-file, parallelizable, long-running, or one that
would block this chat for a long time — you may suggest ONCE per session:
"This is big — want me to spin up a teamctl team for it?" Never nag; a no
is final for that session.

## Chat-based settings menu

When the user asks for the teamctl menu, settings, or preferences:

1. Run `teamctl config` and read the current dotted keys.
2. Present them to the user as a numbered menu in chat.
3. Apply each change with `teamctl config <dotted.key> <value>`
   (comma-separated values become lists), then re-run `teamctl config`
   and confirm the new value back to the user before moving on.

## Lead mode tiers

This identity is installed by `teamctl lead on` in three tiers: this skill
(discoverable), a marker-guarded CLAUDE.md block (always in context), and a
UserPromptSubmit hook (recommended — it re-injects the standing rule on
every prompt, so it keeps firing even after context compaction drops older
text). `teamctl lead status` shows the tiers; `teamctl lead off` removes
all three.
"""

# The hook reads the LIVE delegation posture at fire time (cheap direct
# grep of config.toml; missing config -> "ask"), so the lead knows the
# current mode even after context compaction has dropped everything else.
LEAD_HOOK_COMMAND = (
    "d=$(sed -n 's/^delegation *= *\"\\(.*\\)\"/\\1/p' "
    "~/.config/agent-team/config.toml 2>/dev/null | head -1); "
    "echo \"[teamctl-lead] delegation=${d:-ask} | Standing rule: delegate "
    "non-trivial work to teamctl teammates per the posture - check teamctl "
    "usage and teamctl providers before spawning, and shut each teammate "
    "down the moment it is done.\""
)


def delegation_posture() -> str:
    """[lead] delegation: ask | always | manual (anything else -> ask)."""
    raw = (load_config().get("lead") or {}).get("delegation", "ask")
    return raw if raw in ("ask", "always", "manual") else "ask"


def _lead_hook_entry() -> dict:
    """A fresh UserPromptSubmit hook entry (nested shape per the hooks docs;
    UserPromptSubmit takes no matcher). Its stdout is added to context."""
    return {"hooks": [{"type": "command", "command": LEAD_HOOK_COMMAND}]}


def _print_controls() -> None:
    """The 'how do I drive this later' footer shown after init / lead on /
    lead status — from the shell or from a chat with a lead agent."""
    print("\nControls — adjust teamctl any time:")
    print("  from your shell:  teamctl config --menu      (preferences menu)")
    print("                    teamctl lead on|off|status  (manager identity)")
    print('  from a chat:      tell your lead agent "open the teamctl menu" —')
    print("                    with lead mode on it presents your settings and")
    print("                    applies changes via `teamctl config`.")


def _lead_paths() -> dict[str, Path]:
    home = Path.home()
    skill_dir = home / ".claude" / "skills" / "teamctl-lead"
    return {
        "skill_dir": skill_dir,
        "skill_md": skill_dir / "SKILL.md",
        "claude_md": home / ".claude" / "CLAUDE.md",
        "settings": home / ".claude" / "settings.json",
    }


# Where each CLI reads GLOBAL instructions (all officially documented):
# claude: ~/.claude/CLAUDE.md; codex: ~/.codex/AGENTS.md (global scope, read
# first); grok: ~/.grok/AGENTS.md (global rules, deeper files take
# precedence). The skill and hook tiers are Claude Code mechanisms with no
# codex/grok equivalent — that's parity with what each CLI offers, not bias.
LEAD_BLOCK_FILES: dict[str, tuple[str, str]] = {
    "claude": (".claude", "CLAUDE.md"),
    "codex": (".codex", "AGENTS.md"),
    "grok": (".grok", "AGENTS.md"),
}


def _lead_block_path(cli: str) -> Path:
    d, name = LEAD_BLOCK_FILES[cli]
    return Path.home() / d / name


def _lead_selected_clis(cli_arg: str) -> list[str]:
    """--cli value -> CLIs to manage. Default: every detected CLI (falling
    back to claude when none is on PATH, so `lead on` still does something
    useful on a bare machine)."""
    if cli_arg == "all":
        return list(LEAD_BLOCK_FILES)
    if cli_arg:
        return [cli_arg]
    detected = [c for c in LEAD_BLOCK_FILES if shutil.which(c)]
    return detected or ["claude"]


def _lead_hook_indexes(data: dict) -> list[int]:
    """Indexes of hooks.UserPromptSubmit entries carrying a teamctl-lead hook."""
    entries = (data.get("hooks") or {}).get("UserPromptSubmit")
    if not isinstance(entries, list):
        return []
    found = []
    for i, entry in enumerate(entries):
        if not isinstance(entry, dict):
            continue
        hooks = entry.get("hooks")
        if not isinstance(hooks, list):
            continue
        if any(isinstance(h, dict) and "teamctl-lead" in str(h.get("command", ""))
               for h in hooks):
            found.append(i)
    return found


def _lead_install_skill(changes: list[tuple[str, str]]) -> None:
    skill_md = _lead_paths()["skill_md"]
    if skill_md.exists():
        if skill_md.read_text() == LEAD_SKILL_MD:
            print(f"{skill_md} already installed — skipping.")
            return
        bak = skill_md.with_name("SKILL.md.bak-teamctl")
        shutil.copy2(skill_md, bak)
        skill_md.write_text(LEAD_SKILL_MD)
        print(f"updated {skill_md} (previous version backed up to {bak})")
        changes.append((f"updated {skill_md}",
                        f"restore {bak}, or run `teamctl lead off`"))
        return
    skill_md.parent.mkdir(parents=True, exist_ok=True)
    skill_md.write_text(LEAD_SKILL_MD)
    print(f"installed skill {skill_md}")
    changes.append((f"installed {skill_md}", "teamctl lead off"))


def _extract_lead_block(text: str) -> str:
    """The first BEGIN..END teamctl-lead block in `text`, markers included
    (through to end-of-text if the END marker is missing), or ''."""
    out, inside = [], False
    for line in text.splitlines(keepends=True):
        if line.strip() == LEAD_MD_BEGIN:
            inside = True
        if inside:
            out.append(line)
        if inside and line.strip() == LEAD_MD_END:
            break
    return "".join(out)


def _lead_install_block(cli: str, changes: list[tuple[str, str]]) -> None:
    cm = _lead_block_path(cli)
    text = cm.read_text() if cm.exists() else ""
    if LEAD_MD_BEGIN in text:
        current = _extract_lead_block(text)
        if current.rstrip("\n") == LEAD_CLAUDE_BLOCK.rstrip("\n"):
            print(f"{cm} already contains the current teamctl-lead block "
                  "— skipping.")
            return
        # stale block from an older teamctl: refresh it in place (like the
        # skill file), leaving everything around it untouched
        bak = Path(str(cm) + ".bak-teamctl")
        shutil.copy2(cm, bak)
        replacement = (LEAD_CLAUDE_BLOCK if current.endswith("\n")
                       else LEAD_CLAUDE_BLOCK.rstrip("\n"))
        cm.write_text(text.replace(current, replacement, 1))
        print(f"updated the teamctl-lead block in {cm} (backup: {bak})")
        changes.append((f"updated the teamctl-lead block in {cm}",
                        f"restore {bak}, or run `teamctl lead off`"))
        return
    if cm.exists():
        bak = Path(str(cm) + ".bak-teamctl")
        shutil.copy2(cm, bak)
        print(f"backed up {cm} to {bak}")
    cm.parent.mkdir(parents=True, exist_ok=True)
    with open(cm, "a") as fh:
        if text and not text.endswith("\n"):
            fh.write("\n")
        if text:
            fh.write("\n")
        fh.write(LEAD_CLAUDE_BLOCK)
    print(f"appended teamctl-lead block to {cm}")
    changes.append((
        f"appended a marker-guarded block to {cm}",
        f"run `teamctl lead off`, or delete the block between the "
        f"'{LEAD_MD_BEGIN}' and '{LEAD_MD_END}' lines",
    ))


def _lead_install_hook(changes: list[tuple[str, str]]) -> None:
    sp = _lead_paths()["settings"]
    if not sp.exists():
        sp.parent.mkdir(parents=True, exist_ok=True)
        sp.write_text(json.dumps(
            {"hooks": {"UserPromptSubmit": [_lead_hook_entry()]}}, indent=2) + "\n")
        print(f"created {sp} with a teamctl-lead UserPromptSubmit hook")
        changes.append((f"created {sp}", f"teamctl lead off  (or rm {sp})"))
        return

    try:
        data = json.loads(sp.read_text())
    except (json.JSONDecodeError, OSError):
        data = None
    if not isinstance(data, dict):
        print(f"could not parse {sp} — leaving it untouched.")
        print("add this entry yourself under hooks.UserPromptSubmit:  "
              + json.dumps(_lead_hook_entry()))
        return
    if _lead_hook_indexes(data):
        print(f"{sp} already has a teamctl-lead hook — skipping.")
        return
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        print(f"'hooks' in {sp} has an unexpected shape — leaving it untouched.")
        return
    ups = hooks.setdefault("UserPromptSubmit", [])
    if not isinstance(ups, list):
        print(f"hooks.UserPromptSubmit in {sp} has an unexpected shape — "
              "leaving it untouched.")
        return
    bak = Path(str(sp) + ".bak-teamctl")
    shutil.copy2(sp, bak)
    ups.append(_lead_hook_entry())
    sp.write_text(json.dumps(data, indent=2) + "\n")
    print(f"added teamctl-lead UserPromptSubmit hook to {sp} (backup: {bak})")
    changes.append((f"added a teamctl-lead hook to {sp}",
                    f"restore {bak}, or run `teamctl lead off`"))


def _lead_remove_skill(removed: list[str], left: list[str]) -> None:
    p = _lead_paths()
    sd = p["skill_dir"]
    if not sd.exists():
        left.append(f"skill: {sd} not present")
        return
    # Back up OUTSIDE ~/.claude/skills/ so Claude Code never scans the copy.
    bak = sd.parent.parent / "teamctl-lead-skill.bak-teamctl-off"
    if bak.exists():
        shutil.rmtree(bak)
    shutil.copytree(sd, bak)
    shutil.rmtree(sd)
    removed.append(f"skill dir {sd} (backup: {bak})")


def _lead_remove_block(cli: str, removed: list[str], left: list[str]) -> None:
    cm = _lead_block_path(cli)
    if not cm.exists():
        left.append(f"{cli} block: {cm} not present")
        return
    text = cm.read_text()
    if LEAD_MD_BEGIN not in text:
        left.append(f"{cli} block: no teamctl-lead block in {cm}; left untouched")
        return
    bak = Path(str(cm) + ".bak-teamctl-off")
    shutil.copy2(cm, bak)
    kept, skip = [], False
    for line in text.splitlines(keepends=True):
        if line.strip() == LEAD_MD_BEGIN:
            skip = True
            continue
        if line.strip() == LEAD_MD_END:
            skip = False
            continue
        if not skip:
            kept.append(line)
    remainder = "".join(kept)
    if remainder.strip():
        cm.write_text(remainder.rstrip("\n") + "\n")
        removed.append(f"teamctl-lead block from {cm} "
                       f"(backup: {bak}; other content preserved)")
    else:
        cm.unlink()
        removed.append(f"{cm} (it contained only the teamctl-lead block; "
                       f"backup: {bak})")


def _lead_remove_hook(removed: list[str], left: list[str]) -> None:
    sp = _lead_paths()["settings"]
    if not sp.exists():
        left.append(f"hook: {sp} not present")
        return
    try:
        data = json.loads(sp.read_text())
    except (json.JSONDecodeError, OSError):
        data = None
    if not isinstance(data, dict):
        left.append(f"hook: could not parse {sp}; left untouched")
        return
    idx = _lead_hook_indexes(data)
    if not idx:
        left.append(f"hook: no teamctl-lead hook in {sp}; left untouched")
        return
    bak = Path(str(sp) + ".bak-teamctl-off")
    shutil.copy2(sp, bak)
    ups = data["hooks"]["UserPromptSubmit"]
    data["hooks"]["UserPromptSubmit"] = [e for i, e in enumerate(ups)
                                         if i not in idx]
    if not data["hooks"]["UserPromptSubmit"]:
        del data["hooks"]["UserPromptSubmit"]
    if not data["hooks"]:
        del data["hooks"]
    sp.write_text(json.dumps(data, indent=2) + "\n")
    removed.append(f"teamctl-lead hook from {sp} "
                   f"(backup: {bak}; other settings preserved)")


def _lead_status() -> dict:
    p = _lead_paths()
    skill = "installed" if p["skill_md"].exists() else "not installed"
    blocks: dict[str, str] = {}
    for cli in LEAD_BLOCK_FILES:
        f = _lead_block_path(cli)
        try:
            present = f.exists() and LEAD_MD_BEGIN in f.read_text()
        except OSError:
            present = False
        blocks[cli] = "installed" if present else "not installed"
    sp = p["settings"]
    if not sp.exists():
        hook = "not installed"
    else:
        try:
            data = json.loads(sp.read_text())
        except (json.JSONDecodeError, OSError):
            data = None
        if not isinstance(data, dict):
            hook = "unknown (settings.json is not parseable JSON)"
        else:
            hook = "installed" if _lead_hook_indexes(data) else "not installed"
    return {"skill": skill, "blocks": blocks, "hook": hook}


def cmd_lead(args: argparse.Namespace) -> int:
    p = _lead_paths()

    if args.action == "status":
        st = _lead_status()
        print("lead mode (manager identity) — tier status:")
        print(f"  skill         {st['skill']:<14}  {p['skill_md']} "
              "(Claude Code mechanism)")
        for cli in LEAD_BLOCK_FILES:
            print(f"  {cli + ' block':<12}  {st['blocks'][cli]:<14}  "
                  f"marker block in {_lead_block_path(cli)}")
        print(f"  hook          {st['hook']:<14}  UserPromptSubmit in "
              f"{p['settings']} (Claude Code mechanism)")
        print(f"\n  delegation posture: {delegation_posture()}   (change: "
              "teamctl config lead.delegation ask|always|manual)")
        _print_controls()
        return 0

    if args.action == "on":
        selected = _lead_selected_clis(args.cli)
        changes: list[tuple[str, str]] = []
        print("teamctl lead on — install the lead-agent identity "
              f"({', '.join(selected)}).\n")
        if "claude" in selected:
            _lead_install_skill(changes)
        for cli in selected:
            _lead_install_block(cli, changes)
        want_hook = False
        if "claude" in selected:
            if _lead_status()["hook"] == "installed":
                print(f"{p['settings']} already has a teamctl-lead hook — "
                      "skipping.")
            elif args.hook:
                want_hook = True
            else:
                print("\nRecommended: a UserPromptSubmit hook echoes a one-line")
                print("reminder into context on every prompt. It is the strongest")
                print("tier because it survives context compaction (compaction can")
                print("drop instruction-file text from a long session; the hook")
                print("re-injects the rule each turn).")
                want_hook = _ask_yn("Install the per-prompt reminder hook? [Y/n] ",
                                    default=True)
        else:
            print("(skill and hook tiers are Claude Code mechanisms; the other "
                  "CLIs have no equivalent — their block is the whole install.)")
        if want_hook:
            _lead_install_hook(changes)

        print("\nSummary of changes:")
        for what, revert in changes:
            print(f"  * {what}")
            print(f"    revert: {revert}")
        if not changes:
            print("  nothing was changed (already installed)")
        print("undo everything any time with: teamctl lead off")
        _print_controls()
        return 0

    # off: remove exactly what `on` installed, tolerating partial installs.
    # Default (and --cli all): clean up everything ever installed.
    selected = ([args.cli] if args.cli and args.cli != "all"
                else list(LEAD_BLOCK_FILES))
    removed: list[str] = []
    left: list[str] = []
    if "claude" in selected:
        _lead_remove_skill(removed, left)
    for cli in selected:
        _lead_remove_block(cli, removed, left)
    if "claude" in selected:
        _lead_remove_hook(removed, left)
    print("teamctl lead off:")
    for line in removed:
        print(f"  removed: {line}")
    for line in left:
        print(f"  left alone: {line}")
    if not removed:
        print("  nothing to remove — lead mode was not installed.")
    return 0


# --------------------------------------------------------------------------
# `teamctl config` — show and adjust ~/.config/agent-team/config.toml
# --------------------------------------------------------------------------

_MISSING = object()

CONFIG_HEADER = [
    "# agent-team configuration (managed by `teamctl init` / `teamctl config`)",
    "# Delete this file to fall back to each provider CLI's own defaults.",
]


def _toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_value(x) for x in v) + "]"
    return f'"{_toml_escape(str(v))}"'


def _toml_key(k: str) -> str:
    if k and all(c.isalnum() or c in "-_" for c in k):
        return k
    return f'"{_toml_escape(k)}"'


def _dump_toml(data: dict, prefix: str = "") -> list[str]:
    """Render a nested dict as TOML lines (strings, numbers, bools, lists)."""
    lines = []
    for k, v in data.items():
        if not isinstance(v, dict):
            lines.append(f"{_toml_key(k)} = {_toml_value(v)}")
    for k, v in data.items():
        if isinstance(v, dict):
            name = f"{prefix}.{_toml_key(k)}" if prefix else _toml_key(k)
            # A [header] is only needed when the table holds direct values
            # (or is empty and would otherwise vanish); a table that only
            # groups sub-tables is implied by their [a.b] headers.
            if any(not isinstance(x, dict) for x in v.values()) or not v:
                lines.append("")
                lines.append(f"[{name}]")
            lines.extend(_dump_toml(v, name))
    return lines


def _flatten_config(data: dict, prefix: str = "") -> list[tuple[str, object]]:
    out = []
    for k, v in data.items():
        dk = f"{prefix}.{k}" if prefix else k
        if isinstance(v, dict):
            out.extend(_flatten_config(v, dk))
        else:
            out.append((dk, v))
    return out


def _get_dotted(data: dict, dotted: str):
    cur = data
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return _MISSING
        cur = cur[part]
    return cur


def _set_dotted(data: dict, dotted: str, value) -> None:
    parts = [p for p in dotted.split(".") if p]
    if not parts:
        raise TeamctlError("empty config key")
    cur = data
    for i, part in enumerate(parts[:-1]):
        nxt = cur.get(part)
        if nxt is None:
            nxt = cur[part] = {}
        if not isinstance(nxt, dict):
            raise TeamctlError(
                f"config key '{'.'.join(parts[:i + 1])}' holds a value, not a "
                f"table; cannot set '{dotted}' beneath it")
        cur = nxt
    leaf = parts[-1]
    if isinstance(cur.get(leaf), dict):
        raise TeamctlError(
            f"'{dotted}' is a table, not a value; set one of its keys instead "
            f"(e.g. {dotted}.model)")
    cur[leaf] = value


def _parse_config_value(key: str, raw: str):
    """CLI string -> config value. Comma-separated (or routing.preference)
    becomes a list of strings; true/false a bool; a bare integer an int
    (e.g. layout.lead_width); everything else a string."""
    raw = raw.strip()
    if key == "routing.preference" or "," in raw:
        return [s.strip() for s in raw.split(",") if s.strip()]
    if raw.lower() in ("true", "false"):
        return raw.lower() == "true"
    if raw.isdigit() or (raw.startswith("-") and raw[1:].isdigit()):
        return int(raw)
    return raw


def _load_config_strict(path: Path) -> dict:
    """Parse config.toml, refusing (not silently discarding) on bad TOML."""
    if tomllib is None:
        raise TeamctlError("config support needs Python 3.11+ (tomllib)")
    try:
        return tomllib.loads(path.read_text())
    except OSError as exc:
        raise TeamctlError(f"could not read {path}: {exc}")
    except ValueError as exc:  # tomllib.TOMLDecodeError subclasses ValueError
        raise TeamctlError(
            f"could not parse {path}: {exc}. Fix the file or re-run "
            "`teamctl init` to rewrite it.")


def _write_config_file(data: dict) -> Path | None:
    """Rewrite config.toml from `data`, backing up any existing file first.
    Returns the backup path, or None if there was nothing to back up."""
    path = config_path()
    bak = None
    if path.exists():
        bak = path.with_name("config.toml.bak-teamctl")
        shutil.copy2(path, bak)
    path.parent.mkdir(parents=True, exist_ok=True)
    body = "\n".join(CONFIG_HEADER + _dump_toml(data)).rstrip("\n") + "\n"
    path.write_text(body)
    return bak


def _config_menu() -> int:
    path = config_path()
    if not path.exists():
        print(f"no config at {path} — run `teamctl init` to create one.")
        return 1
    data = _load_config_strict(path)
    dirty = False
    while True:
        flat = _flatten_config(data)
        print(f"\ncurrent settings ({path}):")
        if not flat:
            print("  (empty config)")
        for i, (key, val) in enumerate(flat, 1):
            print(f"  {i:>2}. {key} = {_toml_value(val)}")
        raw = _ask("setting to change (number, blank to finish): ")
        if not raw:
            break
        try:
            n = int(raw)
            if n < 1:
                raise IndexError
            key, cur = flat[n - 1]
        except (ValueError, IndexError):
            print(f"  no setting numbered '{raw}'")
            continue
        newv = _ask(f"new value for {key} [{_toml_value(cur)}]: ")
        if not newv:
            print("  unchanged")
            continue
        _set_dotted(data, key, _parse_config_value(key, newv))
        dirty = True
    if dirty:
        bak = _write_config_file(data)
        print(f"wrote {path}" + (f" (backup: {bak})" if bak else ""))
    else:
        print("nothing changed")
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    path = config_path()

    if args.menu:
        if args.key or args.value:
            print("teamctl: --menu takes no key/value arguments.", file=sys.stderr)
            return 2
        return _config_menu()

    if args.key is None:  # bare: pretty-print current settings
        if not path.exists():
            print(f"no config at {path} — run `teamctl init` to create one.")
            return 1
        flat = _flatten_config(_load_config_strict(path))
        print(f"# {path}")
        if not flat:
            print("(empty config)")
            return 0
        for key, val in flat:
            print(f"{key} = {_toml_value(val)}")
        return 0

    if args.value is None:  # read one key
        if not path.exists():
            print(f"no config at {path} — run `teamctl init` to create one.")
            return 1
        val = _get_dotted(_load_config_strict(path), args.key)
        if val is _MISSING:
            print(f"teamctl: '{args.key}' is not set.", file=sys.stderr)
            return 1
        if isinstance(val, dict):
            for k, v in _flatten_config(val, args.key):
                print(f"{k} = {_toml_value(v)}")
        else:
            print(_toml_value(val))
        return 0

    # set one key, preserving everything else
    data = _load_config_strict(path) if path.exists() else {}
    value = _parse_config_value(args.key, args.value)
    _set_dotted(data, args.key, value)
    bak = _write_config_file(data)
    print(f"set {args.key} = {_toml_value(value)} in {path}"
          + (f" (backup: {bak})" if bak else ""))
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="teamctl", description=__doc__)
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    ip = sub.add_parser("init", help="onboarding wizard: write config, offer optional integrations")
    ip.add_argument("--yes", action="store_true",
                    help="non-interactive: accept defaults, skip optional integrations")
    ip.set_defaults(func=cmd_init)

    lp2 = sub.add_parser(
        "lead", help="install/remove the lead-agent (manager) identity")
    lp2.add_argument("action", choices=["on", "off", "status"],
                     help="on: install instruction blocks for your CLIs (plus "
                          "skill + optional hook for Claude Code); off: remove "
                          "exactly what on installed; status: report tiers")
    lp2.add_argument("--cli", default="",
                     choices=["claude", "codex", "grok", "all"],
                     help="which CLI's identity to manage (default: every "
                          "detected CLI for on; everything for off)")
    lp2.add_argument("--hook", action="store_true",
                     help="with 'on': install the per-prompt reminder hook "
                          "(Claude Code) without asking")
    lp2.set_defaults(func=cmd_lead)

    cp = sub.add_parser("config", help="show or change agent-team preferences")
    cp.add_argument("key", nargs="?", default=None,
                    help="dotted key, e.g. providers.claude.model")
    cp.add_argument("value", nargs="?", default=None,
                    help="new value (comma-separated becomes a list; true/false a bool)")
    cp.add_argument("--menu", action="store_true",
                    help="interactive numbered menu of current settings")
    cp.set_defaults(func=cmd_config)

    sp = sub.add_parser("spawn", help="open a teammate in a new tmux pane")
    sp.add_argument("role", help="descriptive role name, e.g. code-reviewer")
    sp.add_argument("--provider", default="",
                    help="claude|codex|grok|shell (default: first entry of your "
                         "[routing] preference, or the only detected provider; "
                         "with several providers and no preference you must "
                         "choose)")
    sp.add_argument("--prompt", default="", help="initial prompt seeding the session")
    sp.add_argument("--model", default="", help="model for the teammate")
    sp.add_argument("--effort", default="", help="effort/reasoning level")
    sp.add_argument("--cwd", default="", help="working directory for the teammate")
    sp.add_argument("--dry-run", action="store_true", help="print the launch line only")
    sp.set_defaults(func=cmd_spawn)

    lp = sub.add_parser("list", help="show active teammates")
    lp.add_argument("--json", action="store_true", help="machine-readable output")
    lp.set_defaults(func=cmd_list)

    dp = sub.add_parser("shutdown", help="cleanly stop a teammate and close its pane")
    dp.add_argument("role", help="role name to shut down")
    dp.set_defaults(func=cmd_shutdown)

    mp = sub.add_parser("send", help="send an instruction to a running teammate")
    mp.add_argument("role", help="role name of the teammate to instruct")
    mp.add_argument("message", help="instruction text to type into the teammate")
    mp.add_argument("--no-enter", action="store_true",
                    help="type the text without pressing Enter")
    mp.set_defaults(func=cmd_send)

    dsp = sub.add_parser("dispatch", help="hand a teammate a task headlessly (watchable)")
    dsp.add_argument("role")
    dsp.add_argument("--provider", default="",
                     help="claude|codex|grok|shell (default: first entry of your "
                          "[routing] preference, or the only detected provider)")
    dsp.add_argument("--task", required=True, help="the task/instruction")
    dsp.add_argument("--context-file", default="", help="file whose contents are appended as context")
    dsp.add_argument("--model", default="", help="override model")
    dsp.add_argument("--effort", default="", help="override effort/reasoning level")
    dsp.add_argument("--cwd", default="", help="working directory for the teammate")
    dsp.set_defaults(func=cmd_dispatch)

    rp = sub.add_parser("result", help="read back a dispatched teammate's result")
    rp.add_argument("role")
    rp.add_argument("--wait", action="store_true", help="block until the teammate finishes")
    rp.add_argument("--timeout", type=float, default=600.0, help="max seconds to wait")
    rp.set_defaults(func=cmd_result)

    fp = sub.add_parser("followup", help="send another turn to the same teammate session")
    fp.add_argument("role")
    fp.add_argument("--task", required=True, help="the follow-up task")
    fp.set_defaults(func=cmd_followup)

    rt = sub.add_parser("route", help="pick the best available provider and dispatch")
    rt.add_argument("role")
    rt.add_argument("--task", required=True, help="the task/instruction")
    rt.add_argument("--providers", default="",
                    help="comma-separated candidate providers (default: all three; "
                         "ranked by your [routing] preference — without one the "
                         "order is alphabetical, which is arbitrary, not a "
                         "recommendation)")
    rt.add_argument("--model", default="", help="override model")
    rt.add_argument("--effort", default="", help="override effort/reasoning level")
    rt.add_argument("--cwd", default="", help="working directory for the teammate")
    rt.add_argument("--dry-run", action="store_true",
                    help="print selection + launch line without opening a pane")
    rt.set_defaults(func=cmd_route)

    pp = sub.add_parser("providers", help="show provider install/auth/credit status")
    pp.add_argument("--json", action="store_true")
    pp.set_defaults(func=cmd_providers)

    up = sub.add_parser("usage", help="show real provider usage %%/reset where exposed")
    up.add_argument("--json", action="store_true")
    up.add_argument("--probe", nargs="?", const="all", default="",
                    metavar="PROVIDER",
                    help="first refresh usage by running the provider TUI's own "
                         "usage command in a hidden background tmux session "
                         "(grok /usage, codex /status; claude uses the "
                         "statusline cache instead). Default: all probe-able")
    up.set_defaults(func=cmd_usage)

    mo = sub.add_parser("models",
                        help="best-effort model discovery per provider (ids "
                             "always pass through verbatim — new models need "
                             "no teamctl update)")
    mo.add_argument("provider", nargs="?", default="",
                    help="claude|codex|grok (default: all)")
    mo.set_defaults(func=cmd_models)

    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except TeamctlError as exc:
        print(f"teamctl: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
