#!/usr/bin/env python3
"""teamctl - minimal, provider-agnostic agent-teammate control on tmux.

Usage:

    teamctl init [--yes]
    teamctl lead on|off|status [--hook] [--cli claude|codex|grok|all]
    teamctl config [<dotted.key> [<value>]] [--menu]
    teamctl models [provider]
    teamctl spawn <role> [--provider claude|codex|grok|shell] [--prompt TEXT] [--cwd DIR]
    teamctl list
    teamctl send <role> "<instruction>" [--no-enter]
    teamctl dispatch <role> --provider P --task "…" [--context-file F] [--model M] [--effort E]
    teamctl result <role> [--wait]
    teamctl followup <role> --task "…"
    teamctl route <role> --task "…" [--providers claude,codex,grok] [--dry-run]
    teamctl providers
    teamctl usage [--json] [--probe [provider|all]]
    teamctl shutdown <role>
    teamctl --version

Every teammate is a tmux pane running a provider CLI. The lead (this process)
never edits a teammate's work; it only spawns, lists, and cleanly shuts down.

Providers share one launch shape -- `<cmd> [flags] "<prompt>"` starts an
interactive session seeded with the prompt -- so Claude Code, Codex, and Grok
all get the same tmux + teammate capability.

State lives in a small JSON file (default ~/.local/state/agent-team/state.json,
override with $TEAMCTL_STATE). Access is serialized with an flock so concurrent
`spawn`/`shutdown` calls can't race and orphan a pane. Nothing global or
system-level is touched.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path

try:
    import tomllib  # py3.11+
except ModuleNotFoundError:  # pragma: no cover
    tomllib = None

VERSION = "0.2.0"

# provider -> launch command (as an argv prefix). A positional prompt is
# appended when supplied. `shell` is a real provider used for verification:
# it just holds an interactive shell in the pane, proving the tmux mechanics
# without launching an AI agent.
PROVIDERS: dict[str, list[str]] = {
    "claude": ["claude"],
    "codex": ["codex"],
    "grok": ["grok"],
    "shell": [os.environ.get("SHELL", "/bin/bash")],
}


class TeamctlError(Exception):
    """A user-facing failure; main() renders it to stderr with a clean exit."""


def state_path() -> Path:
    override = os.environ.get("TEAMCTL_STATE")
    if override:
        return Path(override)
    return Path.home() / ".local" / "state" / "agent-team" / "state.json"


def handoff_dir(role: str) -> Path:
    """Per-teammate folder holding task.md, result.json, status, error.log, pid."""
    return state_path().parent / role


# Where each provider stores auth, for the availability probe. These are
# OBSERVED login artifacts (teamctl never touches credentials): claude and
# codex write these files at login; grok's auth.json was observed on a
# logged-in install alongside its other CLI data.
AUTH_PATHS = {
    "claude": Path.home() / ".claude.json",
    "codex": Path.home() / ".codex" / "auth.json",
    "grok": Path.home() / ".grok" / "auth.json",
}

# Signs of real grok CLI use, for the last-resort auth fallback. Bare
# ~/.grok existence is NOT a login signal any more: `teamctl lead on`
# creates that directory (AGENTS.md) on machines that never logged in.
GROK_DIR_MARKERS = ("sessions", "config.toml", "agent_id",
                    "active_sessions.json")


def _grok_auth_fallback(auth_path: Path) -> bool:
    """auth.json is the observed login artifact; if a grok CLI update moves
    it, fall back (last resort) to signs of real CLI use in the same dir —
    never to bare directory existence."""
    d = auth_path.parent
    try:
        return d.is_dir() and any((d / m).exists() for m in GROK_DIR_MARKERS)
    except OSError:
        return False


def provider_authed(provider: str) -> bool:
    path = AUTH_PATHS.get(provider)
    if path is None:
        return False
    if path.exists():
        return True
    if provider == "grok":
        return _grok_auth_fallback(path)
    return False


def config_path() -> Path:
    return Path.home() / ".config" / "agent-team" / "config.toml"


def load_config() -> dict:
    """Preferences written by `teamctl init`; everything works without them."""
    path = config_path()
    if not path.exists() or tomllib is None:
        return {}
    try:
        return tomllib.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def provider_defaults(provider: str) -> tuple[str | None, str | None]:
    prov = (load_config().get("providers") or {}).get(provider) or {}
    return prov.get("model"), prov.get("effort")


def available_providers() -> list[str]:
    """Installed AND logged-in providers, in (arbitrary) alphabetical order."""
    return [p for p in ROUTABLE
            if shutil.which(p) is not None and provider_authed(p)]


def default_provider() -> str | None:
    """Provider used when --provider is omitted. teamctl has no opinion of
    its own: the first entry of the user's [routing] preference wins; with
    no preference configured, the single available provider is used; with
    several (or none), there is NO default — the caller must ask the user."""
    pref = (load_config().get("routing") or {}).get("preference")
    if isinstance(pref, list) and pref:
        return str(pref[0])
    avail = available_providers()
    if len(avail) == 1:
        return avail[0]
    return None


def _provider_or_fail(requested: str) -> str | None:
    """--provider value -> provider, or None after printing why (exit 2).
    Never silently picks among several providers: that choice is the user's."""
    if requested:
        if requested not in PROVIDERS:
            print(f"teamctl: unknown provider '{requested}'.", file=sys.stderr)
            return None
        return requested
    prov = default_provider()
    if prov is not None:
        if prov not in PROVIDERS:
            print(f"teamctl: routing.preference starts with unknown provider "
                  f"'{prov}' — fix it with `teamctl config routing.preference "
                  "...`.", file=sys.stderr)
            return None
        return prov
    avail = available_providers()
    print("teamctl: no --provider given and no default is configured "
          f"(detected: {', '.join(avail) if avail else 'none'}). "
          "Pass --provider, or set your order once with: "
          'teamctl config routing.preference "<first>,<second>,..."',
          file=sys.stderr)
    return None


def headless_argv(provider: str, task: str, model: str, effort: str) -> list[str]:
    """Headless (non-interactive) launch argv for each provider."""
    if provider == "claude":
        a = ["claude", "-p", task, "--output-format", "json"]
        if model:
            a += ["--model", model]
        if effort:
            a += ["--effort", effort]
        return a
    if provider == "grok":
        a = ["grok", "--single", task, "--output-format", "json"]
        if model:
            a += ["-m", model]
        if effort:
            a += ["--effort", effort]
        return a
    if provider == "codex":
        a = ["codex", "exec", task]
        if model:
            a += ["-m", model]
        if effort:
            a += ["-c", f'model_reasoning_effort="{effort}"']
        return a
    if provider == "shell":  # fake provider for tests: task is a shell snippet
        return [os.environ.get("SHELL", "/bin/bash"), "-c", task]
    raise TeamctlError(f"no headless adapter for provider '{provider}'")


def resume_argv(provider: str, task: str, model: str, effort: str,
                session_id: str) -> list[str]:
    """Continue a SPECIFIC provider session. Exact-session only — resuming
    'the most recent session' is banned (wrong session under concurrency).
    Flags verified against each CLI's own help: claude `--resume <id>`,
    grok `-r <id>`, codex `exec resume <SESSION_ID> <prompt>`."""
    if provider == "claude":
        a = ["claude", "-p", task, "--output-format", "json",
             "--resume", session_id]
        if model:
            a += ["--model", model]
        return a
    if provider == "grok":
        a = ["grok", "--single", task, "--output-format", "json",
             "-r", session_id]
        if model:
            a += ["-m", model]
        return a
    if provider == "codex":
        return ["codex", "exec", "resume", session_id, task]
    if provider == "shell":
        return [os.environ.get("SHELL", "/bin/bash"), "-c", task]
    raise TeamctlError(f"no resume adapter for provider '{provider}'")


def classify_output(text: str) -> str:
    """Recognize credit-exhaustion / auth failures in provider output."""
    low = text.lower()
    if any(s in low for s in ("usage limit", "rate limit", "quota", "out of credits",
                              "insufficient credit")):
        return "exhausted"
    if any(s in low for s in ("unauthorized", "not logged in", "authentication",
                              "please log in", "invalid api key")):
        return "auth-error"
    return "ok"


def load_state() -> dict:
    p = state_path()
    if not p.exists():
        return {"teammates": {}}
    try:
        data = json.loads(p.read_text())
    except (json.JSONDecodeError, OSError):
        return {"teammates": {}}
    data.setdefault("teammates", {})
    return data


def save_state(state: dict) -> None:
    p = state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    tmp.replace(p)


@contextmanager
def state_lock():
    """Serialize read-modify-write of the state file across processes."""
    p = state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    lock = p.with_suffix(".lock")
    with open(lock, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def tmux(*args: str, check: bool = True, capture: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["tmux", *args],
            check=check,
            capture_output=capture,
            text=True,
        )
    except FileNotFoundError as exc:  # tmux not installed
        raise TeamctlError(
            "tmux not found on PATH; install tmux or start inside a tmux session."
        ) from exc


def in_tmux() -> bool:
    return bool(os.environ.get("TMUX"))


def live_pane_ids() -> set[str]:
    try:
        out = tmux("list-panes", "-a", "-F", "#{pane_id}").stdout
    except subprocess.CalledProcessError:
        return set()
    return {line.strip() for line in out.splitlines() if line.strip()}


def reconcile(state: dict) -> dict:
    """Keep tracked teammates honest against the live tmux panes.

    Interactive (spawn-mode) teammates ARE their pane: pane gone means the
    teammate is gone, so it is dropped.

    Dispatch-mode teammates are different: their pane runs a wrapper that
    legitimately exits (closing the pane) when the task finishes, while the
    completed result/session live on in the handoff dir. A dispatch teammate
    whose pane is gone is therefore FINISHED (or died mid-task), not
    vanished — it stays tracked, with its stale pane id cleared, until an
    explicit `teamctl shutdown <role>` removes it. `result` and `followup`
    keep working from the handoff artifacts indefinitely."""
    live = live_pane_ids()
    survivors: dict[str, dict] = {}
    changed = False
    for role, info in state["teammates"].items():
        pane = info.get("pane_id")
        if pane and pane in live:
            survivors[role] = info
            continue
        if info.get("mode") == "dispatch":
            if pane:
                info = dict(info)
                info["pane_id"] = ""
                changed = True
            survivors[role] = info
            continue
        changed = True  # interactive teammate without a pane is gone
    if changed:
        state["teammates"] = survivors
        save_state(state)
    return state


def _mate_state(role: str, info: dict, live: set[str]) -> str:
    """Human-readable lifecycle state for `list`.

    interactive: active (a dead one is dropped by reconcile).
    dispatch:    running / done / failed(rc) / died — derived from the pane
                 and the handoff status file, never stored, so it is always
                 current."""
    if info.get("mode") != "dispatch":
        return "active"
    hd = Path(info.get("handoff") or handoff_dir(role))
    status, rc = _read_status(hd)
    if status == "running":
        if info.get("pane_id") in live or _teammate_alive(info, hd):
            return "running"
        return "died"
    if rc == 0:
        return "done"
    return f"failed({rc if rc is not None else '?'})"


def interactive_flags(provider: str, model: str, effort: str) -> list[str]:
    """Model/effort flags for an interactive launch."""
    f: list[str] = []
    if provider == "claude":
        if model:
            f += ["--model", model]
        if effort:
            f += ["--effort", effort]
    elif provider == "grok":
        if model:
            f += ["-m", model]
        if effort:
            f += ["--effort", effort]
    elif provider == "codex":
        if model:
            f += ["-m", model]
        if effort:
            f += ["-c", f'model_reasoning_effort="{effort}"']
    return f


def build_launch_line(provider: str, prompt: str, cwd: str,
                      model: str = "", effort: str = "") -> str:
    """The shell command a teammate pane runs. All values are shell-quoted."""
    launch = list(PROVIDERS[provider]) + interactive_flags(provider, model, effort)
    if prompt:
        launch.append(prompt)
    return f"cd {shlex.quote(cwd)} && exec {' '.join(shlex.quote(a) for a in launch)}"


def _pane_size(pane_id: str) -> tuple[int, int]:
    try:
        out = tmux("display-message", "-p", "-t", pane_id,
                   "#{pane_width} #{pane_height}").stdout.split()
        return int(out[0]), int(out[1])
    except (subprocess.CalledProcessError, ValueError, IndexError):
        return 0, 0


def _window_panes(lead: str) -> list[str]:
    """All pane ids in the window containing `lead`."""
    try:
        out = tmux("list-panes", "-t", lead, "-F", "#{pane_id}").stdout
    except subprocess.CalledProcessError:
        return []
    return [line.strip() for line in out.splitlines() if line.strip()]


def _split_candidates(lead: str | None, existing: list[str]) -> list[str]:
    """Panes a new teammate may split: every pane in the lead's window except
    the lead itself — so teammates fold into the right-hand grid even when
    non-teamctl panes (e.g. native agent panes) already occupy it, instead of
    carving slivers off the lead. Falls back to the tracked-teammate list,
    then (empty) to splitting the lead."""
    if lead:
        panes = [p for p in _window_panes(lead) if p != lead]
        if panes:
            return panes
    live = live_pane_ids()
    return [p for p in existing if p in live]


def lead_width_percent() -> int:
    """Configured lead-pane width share ([layout] lead_width, % of the
    window), clamped to 20–80. Default 50."""
    raw = (load_config().get("layout") or {}).get("lead_width", 50)
    try:
        pct = int(raw)
    except (TypeError, ValueError):
        pct = 50
    return max(20, min(80, pct))


def _enforce_lead_width() -> None:
    """Re-assert the lead pane's width after layout changes: every spawn and
    shutdown re-tiles the window, and without this the lead pane gradually
    loses (or hoards) columns."""
    lead = os.environ.get("TMUX_PANE")
    if not lead:
        return
    tmux("resize-pane", "-t", lead, "-x", f"{lead_width_percent()}%",
         check=False)


def _open_pane(cmd: str, existing: list[str]) -> str:
    """Open a teammate as a PANE in the lead's window, keeping the lead on the
    left and teammates in a grid of squares to its right.

    The first teammate splits the lead pane horizontally (taking the right
    half). Each later teammate splits the largest other pane in the window
    (teamctl-tracked or not, so foreign panes fold into the same grid),
    choosing the split direction that keeps panes square-looking (a terminal
    cell is ~2x taller than wide, so a pane reads as square when width is
    about twice its height). Four teammates thus form a 2x2 grid beside the
    lead; the lead pane itself is never re-split after the first, and its
    width is re-pinned to the configured [layout] lead_width share."""
    lead = os.environ.get("TMUX_PANE")
    candidates = _split_candidates(lead, existing)

    if not candidates:
        target, flag = lead, "-h"
    else:
        target, best_area, w, h = None, -1, 0, 0
        for p in candidates:
            pw, ph = _pane_size(p)
            if pw * ph > best_area:
                target, best_area, w, h = p, pw * ph, pw, ph
        if target is None:
            target = lead
            flag = "-h"
        else:
            flag = "-h" if w >= 2 * h else "-v"

    # -d: never move focus to the new pane — spawning a teammate must not
    # steal the user's cursor from whatever pane they are working in.
    argv = ["split-window", flag, "-d", "-P", "-F", "#{pane_id}"]
    if target:
        argv += ["-t", target]
    argv.append(cmd)
    pane_id = tmux(*argv).stdout.strip()
    # pin the lead's width back to its configured share of the window
    _enforce_lead_width()
    return pane_id


def _set_pane_title(pane_id: str, role: str, model: str = "") -> None:
    """Tag a teammate pane with its role/model so tmux can show a sticky
    per-pane label. Uses per-pane user options @role/@model (which the
    provider CLI can't clobber, unlike the pane title) — the tmux
    pane-border-format / status bar read these. Also sets the title for the
    benefit of other tools. Not rendered via #() shell commands, which some
    tmux builds do not execute in status formats."""
    title = f"{role} · {model}" if model else role
    for opt, val in (("@role", role), ("@model", model)):
        try:
            tmux("set-option", "-p", "-t", pane_id, opt, val, check=False)
        except subprocess.CalledProcessError:
            pass
    try:
        tmux("select-pane", "-t", pane_id, "-T", title)
    except subprocess.CalledProcessError:
        pass  # pane titles are cosmetic


def cmd_spawn(args: argparse.Namespace) -> int:
    provider = _provider_or_fail(args.provider)
    if provider is None:
        return 2
    args.provider = provider

    cwd = os.path.abspath(os.path.expanduser(args.cwd)) if args.cwd else os.getcwd()
    d_model, d_effort = provider_defaults(args.provider)
    model = args.model or d_model or ""
    effort = args.effort or d_effort or ""
    inner = build_launch_line(args.provider, args.prompt, cwd, model, effort)

    # dry-run is a pure preview: no tmux and no state needed.
    if args.dry_run:
        print(inner)
        return 0

    if not in_tmux():
        print("teamctl: not inside a tmux session; start one first.", file=sys.stderr)
        return 2

    with state_lock():
        state = reconcile(load_state())
        if args.role in state["teammates"]:
            print(
                f"teamctl: teammate '{args.role}' already exists "
                f"(pane {state['teammates'][args.role]['pane_id']}). "
                "Refusing to run two on the same role.",
                file=sys.stderr,
            )
            return 1

        existing = [i.get("pane_id", "") for i in state["teammates"].values()]
        pane_id = _open_pane(inner, existing)
        _set_pane_title(pane_id, args.role, model)

        state["teammates"][args.role] = {
            "provider": args.provider,
            "pane_id": pane_id,
            "cwd": cwd,
            "model": model,
            "effort": effort,
            "prompt": args.prompt or "",
            "mode": "interactive",
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
        save_state(state)

    print(f"spawned teammate '{args.role}' ({args.provider}"
          f"{'/' + model if model else ''}) in pane {pane_id}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
    mates = state["teammates"]
    live = live_pane_ids()
    if args.json:
        annotated = {role: {**info, "state": _mate_state(role, info, live)}
                     for role, info in mates.items()}
        print(json.dumps(annotated, indent=2, sort_keys=True))
        return 0
    if not mates:
        print("no active teammates")
        return 0
    width = max(len(r) for r in mates)
    print(f"{'ROLE'.ljust(width)}  PROVIDER  PANE     STATE        CREATED")
    for role in sorted(mates):
        i = mates[role]
        st = _mate_state(role, i, live)
        print(
            f"{role.ljust(width)}  {i['provider']:<8}  "
            f"{i.get('pane_id') or '-':<7}  {st:<11}  {i.get('created_at', '')}"
        )
    return 0


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _descendants(pid: int) -> list[int]:
    """All descendant PIDs of pid (portable via pgrep -P)."""
    out, stack = [], [pid]
    while stack:
        parent = stack.pop()
        res = subprocess.run(["pgrep", "-P", str(parent)],
                             capture_output=True, text=True)
        for line in res.stdout.split():
            try:
                child = int(line)
            except ValueError:
                continue
            out.append(child)
            stack.append(child)
    return out


def _kill_tree(pid: int) -> bool:
    """TERM then KILL a process and all descendants; True once all are gone."""
    pids = [pid] + _descendants(pid)
    for p in pids:
        try:
            os.kill(p, 15)
        except (ProcessLookupError, PermissionError):
            pass
    for _ in range(10):
        if not any(_pid_alive(p) for p in pids):
            return True
        time.sleep(0.15)
    # escalate
    for p in pids:
        if _pid_alive(p):
            try:
                os.kill(p, 9)
            except (ProcessLookupError, PermissionError):
                pass
    for _ in range(4):
        if not any(_pid_alive(p) for p in pids):
            return True
        time.sleep(0.15)
    return not any(_pid_alive(p) for p in pids)


def _pane_pid(pane_id: str) -> int | None:
    try:
        out = tmux("display-message", "-p", "-t", pane_id, "#{pane_pid}").stdout.strip()
        return int(out) if out else None
    except (subprocess.CalledProcessError, ValueError):
        return None


def _close_pane(pane_id: str) -> bool:
    """Cleanly end a teammate: kill its whole process tree (not just the pane),
    verify the process is gone, then close the pane. Returns True on success.

    Killing a pane alone can orphan a shell-wrapped provider process, so the
    process tree is terminated and death confirmed before the pane closes."""
    if pane_id not in live_pane_ids():
        return True
    # graceful interrupt first, so the CLI can close its provider session
    tmux("send-keys", "-t", pane_id, "C-c", check=False)
    pid = _pane_pid(pane_id)
    for _ in range(6):
        if pane_id not in live_pane_ids():
            break
        time.sleep(0.15)
    # kill the process tree and verify no survivors
    if pid is not None and _pid_alive(pid):
        if not _kill_tree(pid):
            return False
    # now close the (possibly still-open) pane
    if pane_id in live_pane_ids():
        tmux("kill-pane", "-t", pane_id, check=False)
    for _ in range(4):
        pane_gone = pane_id not in live_pane_ids()
        proc_gone = pid is None or not _pid_alive(pid)
        if pane_gone and proc_gone:
            return True
        time.sleep(0.15)
    return (pane_id not in live_pane_ids()) and (pid is None or not _pid_alive(pid))


def cmd_shutdown(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
        if not info:
            print(f"teamctl: no active teammate '{args.role}'.", file=sys.stderr)
            return 1
        pane_id = info.get("pane_id") or ""
        if pane_id and not _close_pane(pane_id):
            print(
                f"teamctl: failed to close pane {pane_id}; leaving '{args.role}' tracked.",
                file=sys.stderr,
            )
            return 1
        del state["teammates"][args.role]
        save_state(state)

    # a dispatch teammate's handoff dir is part of its lifetime: shutdown is
    # the explicit removal point, so clear the artifacts with the state.
    if info.get("mode") == "dispatch":
        hd = Path(info.get("handoff") or handoff_dir(args.role))
        if hd.is_dir() and hd != state_path().parent:
            shutil.rmtree(hd, ignore_errors=True)

    _enforce_lead_width()
    if pane_id:
        print(f"shut down teammate '{args.role}' (pane {pane_id})")
    else:
        print(f"cleared finished teammate '{args.role}' (state and handoff)")
    return 0


def cmd_send(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
        if not info:
            print(f"teamctl: no active teammate '{args.role}'.", file=sys.stderr)
            return 1
        pane_id = info["pane_id"]

    if pane_id not in live_pane_ids():
        print(
            f"teamctl: teammate '{args.role}' pane {pane_id} is gone.",
            file=sys.stderr,
        )
        return 1

    # `-l` sends the text literally (no key-name interpretation, no shell),
    # then a separate C-m presses Enter so the teammate's CLI submits it.
    typed = tmux("send-keys", "-t", pane_id, "-l", "--", args.message, check=False)
    if typed.returncode != 0:
        print(f"teamctl: failed to send to pane {pane_id}.", file=sys.stderr)
        return 1
    if not args.no_enter:
        tmux("send-keys", "-t", pane_id, "C-m", check=False)

    print(f"sent to '{args.role}' (pane {pane_id})")
    return 0


def _dispatch_pane(role: str, hd: Path, argv: list[str], cwd: str,
                   provider: str, model: str) -> str:
    """Run a headless provider in a watchable pane.

    stdout -> result.json (the parseable source of truth). stderr goes
    STRAIGHT to error.log (durable: no intermediary process that can lose
    buffered output when the pane closes) and a background `tail -f` mirrors
    it into the pane so the run stays watchable. The old
    `2> >(tee error.log >&2)` process substitution was verified to LOSE any
    stderr written after the pane closed (tmux HUPs the tee), and on a
    provider killed at exec it left an empty error.log with no explanation.

    The status file records the exit code AND, for rc > 128, the signal name
    (e.g. `DONE 137 SIGKILL`) so a killed provider is distinguishable from a
    failed one. The wrapper's PID is recorded for teardown."""
    hcmd = " ".join(shlex.quote(a) for a in argv)
    q = shlex.quote
    pid_f = q(str(hd / "pid"))
    res_f = q(str(hd / "result.json"))
    err_f = q(str(hd / "error.log"))
    sta_f = q(str(hd / "status"))
    banner = f"[teamctl] {provider} {model or ''} :: {role} — working…"
    script = (
        f"echo $$ > {pid_f}; "
        f"cd {q(cwd)} || exit 97; "
        f"echo {q(banner)}; "
        f": > {err_f}; "
        f"tail -f {err_f} >&2 & tailpid=$!; "
        f"{hcmd} > {res_f} 2> {err_f}; "
        "rc=$?; cause=''; "
        "if [ \"$rc\" -gt 128 ]; then "
        "cause=$(kill -l $((rc-128)) 2>/dev/null); fi; "
        f"printf 'DONE %s%s\\n' \"$rc\" \"${{cause:+ SIG$cause}}\" > {sta_f}; "
        f"echo \"[teamctl] {role} finished rc=$rc${{cause:+ (SIG$cause)}}\"; "
        "sleep 2; kill $tailpid 2>/dev/null"
    )
    outer = "bash -c " + shlex.quote(script)
    existing = [i.get("pane_id", "") for i in load_state()["teammates"].values()]
    return _open_pane(outer, existing)


def _resolve_dispatch(provider: str, task: str, context_file: str, model_arg: str,
                      effort_arg: str, cwd_arg: str) -> tuple[str, str, str, str]:
    """Resolve (cwd, model, effort, task) exactly the way dispatch does."""
    cwd = os.path.abspath(os.path.expanduser(cwd_arg)) if cwd_arg else os.getcwd()
    d_model, d_effort = provider_defaults(provider)
    model = model_arg or d_model or ""
    effort = effort_arg or d_effort or ""
    if context_file:
        ctx = Path(os.path.expanduser(context_file)).read_text()
        task = f"{task}\n\n--- context ---\n{ctx}"
    return cwd, model, effort, task


def _do_dispatch(role: str, provider: str, task: str, context_file: str,
                 model_arg: str, effort_arg: str, cwd_arg: str) -> int:
    """Shared dispatch body used by `dispatch` and `route`."""
    if not in_tmux():
        print("teamctl: not inside a tmux session; start one first.", file=sys.stderr)
        return 2

    cwd, model, effort, task = _resolve_dispatch(
        provider, task, context_file, model_arg, effort_arg, cwd_arg)
    argv = headless_argv(provider, task, model, effort)

    with state_lock():
        state = reconcile(load_state())
        existing_info = state["teammates"].get(role)
        if existing_info:
            if (existing_info.get("mode") == "dispatch"
                    and not existing_info.get("pane_id")):
                print(f"teamctl: finished teammate '{role}' still holds this "
                      f"role — read it with `teamctl result {role}`, continue "
                      f"it with `teamctl followup {role}`, or clear it with "
                      f"`teamctl shutdown {role}`.", file=sys.stderr)
            else:
                print(f"teamctl: teammate '{role}' already exists.",
                      file=sys.stderr)
            return 1

        hd = handoff_dir(role)
        hd.mkdir(parents=True, exist_ok=True)
        (hd / "task.md").write_text(task)
        # "session" too: a fresh dispatch is a NEW conversation — a stale
        # session id from a previous holder of this role must never leak
        # into this teammate's follow-ups.
        for stale in ("status", "result.json", "error.log", "pid", "session"):
            (hd / stale).unlink(missing_ok=True)

        pane_id = _dispatch_pane(role, hd, argv, cwd, provider, model)
        _set_pane_title(pane_id, role, model)

        state["teammates"][role] = {
            "provider": provider,
            "pane_id": pane_id,
            "cwd": cwd,
            "model": model,
            "effort": effort,
            "mode": "dispatch",
            "handoff": str(hd),
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
        save_state(state)

    print(f"dispatched '{role}' ({provider}"
          f"{'/' + model if model else ''}) in pane {pane_id}")
    return 0


def cmd_dispatch(args: argparse.Namespace) -> int:
    provider = _provider_or_fail(args.provider)
    if provider is None:
        return 2
    return _do_dispatch(args.role, provider, args.task, args.context_file,
                        args.model, args.effort, args.cwd)


def _read_status(hd: Path) -> tuple[str, int | None]:
    sta = hd / "status"
    if not sta.exists():
        return "running", None
    raw = sta.read_text().strip()
    parts = raw.split()
    # "DONE <rc>" or "DONE <rc> <signal-cause>" (e.g. "DONE 137 SIGKILL")
    if len(parts) >= 2 and parts[0] == "DONE":
        try:
            return "done", int(parts[1])
        except ValueError:
            pass
    return "done", None


def _status_cause(hd: Path) -> str | None:
    """The signal cause the wrapper recorded (e.g. 'SIGKILL'), if any."""
    sta = hd / "status"
    try:
        parts = sta.read_text().split()
    except OSError:
        return None
    return parts[2] if len(parts) >= 3 else None


def _wrapper_pid(hd: Path) -> int | None:
    """PID recorded by the dispatch wrapper, if present and parseable."""
    pid_f = hd / "pid"
    if not pid_f.exists():
        return None
    try:
        return int(pid_f.read_text().strip())
    except (OSError, ValueError):
        return None


_UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")


def _extract_session_id(provider: str, hd: Path,
                        since: float | None = None) -> str | None:
    """Best-effort provider session id from a dispatch's artifacts, for
    exact-session follow-ups.

    codex: `codex exec` prints `session id: <uuid>` on stderr (OBSERVED
    banner; live-verified — the same uuid appears in the rollout log
    filename, which is the fallback: newest rollout created after the
    dispatch started whose name ends in a uuid). claude: the documented
    session_id field of the --output-format json result. grok: the
    sessionId field of its json result (observed; parsed defensively)."""
    def _read(name: str) -> str:
        f = hd / name
        try:
            return f.read_text() if f.exists() else ""
        except OSError:
            return ""

    if provider == "codex":
        m = re.search(r"session id:\s*(\S+)", _read("error.log"))
        if m and _UUID_RE.fullmatch(m.group(1)):
            return m.group(1)
        base = Path.home() / ".codex" / "sessions"
        if base.exists():
            logs = sorted(base.glob("*/*/*/rollout-*.jsonl"),
                          key=lambda p: p.stat().st_mtime, reverse=True)
            for log in logs[:8]:
                if since is not None and log.stat().st_mtime < since:
                    continue
                tail = log.stem[-36:]
                if _UUID_RE.fullmatch(tail):
                    return tail
        return None

    key = {"claude": "session_id", "grok": "sessionId"}.get(provider)
    if key is None:
        return None
    try:
        data = json.loads(_read("result.json"))
    except (json.JSONDecodeError, ValueError):
        return None
    sid = _find_key(data, key)
    return str(sid) if sid else None


def _dispatch_started_at(info: dict) -> float | None:
    try:
        return time.mktime(time.strptime(info.get("created_at", ""),
                                         "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, OverflowError):
        return None


def _capture_session_id(info: dict, hd: Path) -> str | None:
    """Parse and persist the teammate's session id (hd/session). Refreshed
    whenever newer artifacts yield one — a resumed run can mint a new id.
    Returns the current best id, falling back to the persisted one."""
    sid = _extract_session_id(info.get("provider", ""), hd,
                              _dispatch_started_at(info))
    sf = hd / "session"
    if sid:
        try:
            sf.write_text(sid + "\n")
        except OSError:
            pass
        return sid
    try:
        if sf.exists():
            return sf.read_text().strip() or None
    except OSError:
        pass
    return None


def _teammate_alive(info: dict, hd: Path) -> bool:
    """True if the teammate pane still exists and/or the wrapper pid is live.

    Status is only written when the wrapper exits normally, so a killed pane
    or process would otherwise leave `result --wait` spinning until timeout.
    """
    pane_id = info.get("pane_id")
    if pane_id and pane_id in live_pane_ids():
        return True
    pid = _wrapper_pid(hd)
    if pid is not None and _pid_alive(pid):
        return True
    return False


def cmd_result(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
    if not info:
        print(f"teamctl: no teammate '{args.role}'.", file=sys.stderr)
        return 1
    hd = Path(info.get("handoff") or handoff_dir(args.role))

    status, rc = _read_status(hd)
    if status == "running" and args.wait:
        deadline = args.timeout
        waited = 0.0
        while waited < deadline:
            status, rc = _read_status(hd)
            if status != "running":
                break
            if not _teammate_alive(info, hd):
                # Race: wrapper may have written status on the way out.
                status, rc = _read_status(hd)
                if status != "running":
                    break
                print(
                    f"{args.role}: failed (teammate died before writing status)",
                    file=sys.stderr,
                )
                return 1
            time.sleep(0.3)
            waited += 0.3

    # keep the exact-session id current whenever artifacts allow it
    _capture_session_id(info, hd)

    if status == "running":
        if not _teammate_alive(info, hd):
            print(f"{args.role}: failed (teammate died before writing "
                  "status)", file=sys.stderr)
            return 1
        print(f"{args.role}: running")
        return 0

    result_txt = ""
    res_f = hd / "result.json"
    if res_f.exists():
        result_txt = res_f.read_text()
    err_txt = (hd / "error.log").read_text() if (hd / "error.log").exists() else ""

    signal = classify_output(result_txt + "\n" + err_txt)
    if signal != "ok":
        _record_provider_signal(info["provider"], signal)

    if rc == 0:
        print(f"{args.role}: done")
        try:
            print(json.dumps(json.loads(result_txt), indent=2))
        except (json.JSONDecodeError, ValueError):
            print(result_txt.rstrip())
        if signal != "ok":
            print(f"[teamctl] note: provider signal = {signal}", file=sys.stderr)
        return 0

    cause = _status_cause(hd)
    print(f"{args.role}: failed (rc={rc}{', ' + cause if cause else ''}, "
          f"signal={signal})", file=sys.stderr)
    if err_txt.strip():
        print(err_txt.rstrip()[-2000:], file=sys.stderr)
    elif not result_txt.strip():
        # nothing on stdout OR stderr: the provider died before producing a
        # single byte — explain what that shape usually means instead of
        # leaving the user staring at two empty files.
        prov = info.get("provider", "the provider")
        print(
            f"[teamctl] no output captured: result.json and error.log are "
            f"both empty — {prov} died before writing anything.", file=sys.stderr)
        if rc is not None and rc > 128:
            print(
                f"[teamctl] rc={rc} means it was killed by a signal"
                f"{' (' + cause + ')' if cause else ''}. Common causes: an "
                "out-of-memory kill, or macOS killing a broken/unsigned "
                f"binary at exec. Check the CLI itself: run `{prov} "
                f"--version` in a shell, and on macOS "
                f"`codesign -v \"$(which {prov})\"`.", file=sys.stderr)
    return 1


def cmd_followup(args: argparse.Namespace) -> int:
    with state_lock():
        state = reconcile(load_state())
        info = state["teammates"].get(args.role)
    if not info:
        print(f"teamctl: no teammate '{args.role}'.", file=sys.stderr)
        return 1
    if not in_tmux():
        print("teamctl: not inside a tmux session.", file=sys.stderr)
        return 2

    provider = info["provider"]
    cwd = info.get("cwd") or os.getcwd()
    model = info.get("model") or ""
    effort = info.get("effort") or ""
    hd = Path(info.get("handoff") or handoff_dir(args.role))
    hd.mkdir(parents=True, exist_ok=True)

    # refuse to stack a follow-up on a run that is still in flight: the two
    # wrappers would race on the same handoff files.
    status, _ = _read_status(hd)
    if status == "running" and _teammate_alive(info, hd):
        print(f"teamctl: '{args.role}' is still running — wait for "
              f"`teamctl result {args.role} --wait` first.", file=sys.stderr)
        return 1

    # exact-session only: capture the id from the previous turn's artifacts
    # BEFORE they are cleared. Without one, refuse — never resume "the most
    # recent session", which grabs the wrong one under concurrency.
    session_id = ""
    if provider != "shell":
        session_id = _capture_session_id(info, hd) or ""
        if not session_id:
            print(f"teamctl: no session id captured for '{args.role}' — "
                  "cannot resume its exact session (teamctl never guesses "
                  "'most recent'). Re-dispatch instead.", file=sys.stderr)
            return 1
    argv = resume_argv(provider, args.task, model, effort, session_id)
    for stale in ("status", "result.json", "error.log", "pid"):
        (hd / stale).unlink(missing_ok=True)

    with state_lock():
        state = reconcile(load_state())
        pane_id = _dispatch_pane(args.role, hd, argv, cwd, provider, model)
        _set_pane_title(pane_id, args.role, model)
        state["teammates"][args.role]["pane_id"] = pane_id
        save_state(state)
    print(f"follow-up sent to '{args.role}' in pane {pane_id}")
    return 0


def _record_provider_signal(provider: str, signal: str,
                            resets_at: float | None = None) -> None:
    """Cache a provider signal. Routing is not codified policy: the caller
    decides at spawn time. A signal with a known resets_at auto-expires at
    that moment so a stale 'exhausted' can never outlive the real window."""
    cache = state_path().parent / "providers.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        data = {}
    entry = {"signal": signal, "at": time.strftime("%Y-%m-%dT%H:%M:%S")}
    if resets_at:
        entry["resets_at"] = resets_at
    data[provider] = entry
    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(data, indent=2, sort_keys=True))


def _live_signal(entry: dict | None) -> str | None:
    """The cached signal, unless its reset time has already passed."""
    if not entry:
        return None
    resets_at = entry.get("resets_at")
    if resets_at and resets_at <= time.time():
        return None
    return entry.get("signal")


def _find_key(obj, key):
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        for v in obj.values():
            r = _find_key(v, key)
            if r is not None:
                return r
    elif isinstance(obj, list):
        for v in obj:
            r = _find_key(v, key)
            if r is not None:
                return r
    return None


def codex_usage() -> dict | None:
    """Latest {primary, secondary} rate-limit windows from Codex session logs.
    Codex records real usage in `token_count` events: each window has
    used_percent, window_minutes, and a resets_at unix timestamp."""
    base = Path.home() / ".codex" / "sessions"
    if not base.exists():
        return None
    logs = sorted(base.glob("*/*/*/*.jsonl"), key=lambda p: p.stat().st_mtime,
                  reverse=True)
    for log in logs[:8]:
        last = None
        try:
            with open(log) as fh:
                for line in fh:
                    if '"rate_limits"' in line:
                        try:
                            d = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        rl = _find_key(d, "rate_limits")
                        if isinstance(rl, dict):
                            last = rl
        except OSError:
            continue
        if last:
            return last
    return None


def _fmt_reset(resets_at, now) -> str:
    if not resets_at:
        return "?"
    when = time.strftime("%-I:%M %p", time.localtime(resets_at))
    mins = int((resets_at - now) / 60)
    if mins <= 0:
        return f"{when} (now)"
    return f"{when} (in {mins // 60}h{mins % 60:02d}m)"


def _fmt_age(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s ago"
    if s < 3600:
        return f"{s // 60}m ago"
    return f"{s // 3600}h{(s % 3600) // 60:02d}m ago"


def claude_usage() -> dict | None:
    """Claude 5h/weekly windows, cached by the teamctl claude-statusline.

    Claude Code pipes `rate_limits.five_hour/seven_day` (used_percentage,
    resets_at — documented statusLine fields, present for subscribers after
    the first API response) into the status line; ours dumps them to
    claude-usage.json next to the state file. Absent/partial data is normal."""
    path = state_path().parent / "claude-usage.json"
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict) or not isinstance(data.get("rate_limits"), dict):
        return None
    return data


# --------------------------------------------------------------------------
# `teamctl models` — best-effort model discovery. Model ids always pass
# through to the provider CLI verbatim (the CLI is the validator), so new
# models work without updating teamctl; discovery only powers suggestions.
# --------------------------------------------------------------------------

def _grok_models_output() -> str | None:
    """Output of `grok models` (a documented subcommand; its output format is
    not documented, so it is passed through rather than parsed strictly)."""
    if shutil.which("grok") is None:
        return None
    try:
        res = subprocess.run(["grok", "models"], capture_output=True,
                             text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0:
        return None
    return res.stdout


def _codex_models_cache() -> tuple[list[dict], str] | None:
    """(models, fetched_at) from ~/.codex/models_cache.json. OBSERVED-ONLY:
    the shape ({'fetched_at', 'models': [{'slug', 'display_name',
    'supported_reasoning_levels': [{'effort', ...}]}]}) was seen in codex
    0.144 and is not a documented interface — parsed defensively."""
    path = Path.home() / ".codex" / "models_cache.json"
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    models = data.get("models") if isinstance(data, dict) else None
    if not isinstance(models, list):
        return None
    return ([m for m in models if isinstance(m, dict)],
            str(data.get("fetched_at") or "?"))


def discover_models(provider: str) -> list[str]:
    """Best-effort model ids for suggestions; [] whenever unknown."""
    if provider == "codex":
        cached = _codex_models_cache()
        if cached:
            return [str(m["slug"]) for m in cached[0] if m.get("slug")]
    if provider == "grok":
        out = _grok_models_output()
        if out:
            ids = []
            for line in out.splitlines():
                line = line.strip()
                if line.startswith(("*", "-")):
                    parts = line.lstrip("*- ").split()
                    if parts:
                        ids.append(parts[0])
            return ids
    return []


def cmd_models(args: argparse.Namespace) -> int:
    providers = [args.provider] if args.provider else list(ROUTABLE)
    for prov in providers:
        if prov not in ROUTABLE:
            print(f"teamctl: unknown provider '{prov}'.", file=sys.stderr)
            return 2
    for prov in providers:
        print(f"{prov}:")
        if prov == "grok":
            out = _grok_models_output()
            if out:
                for line in out.rstrip().splitlines():
                    print(f"  {line}")
                print("  (source: `grok models` — documented command, output "
                      "passed through)")
            else:
                print("  could not run `grok models` (not installed, not "
                      "logged in, or the command failed)")
        elif prov == "codex":
            cached = _codex_models_cache()
            if cached:
                models, fetched = cached
                for m in models:
                    slug = m.get("slug") or "?"
                    efforts = "/".join(
                        str(lv["effort"])
                        for lv in (m.get("supported_reasoning_levels") or [])
                        if isinstance(lv, dict) and lv.get("effort"))
                    extra = ", ".join(x for x in (
                        str(m.get("display_name") or ""),
                        f"efforts: {efforts}" if efforts else "") if x)
                    print(f"  {slug}" + (f"  ({extra})" if extra else ""))
                print(f"  (source: ~/.codex/models_cache.json, fetched "
                      f"{fetched} — an observed cache, not a documented "
                      "interface)")
            else:
                print("  no local model list found; any model id is accepted "
                      "(the codex CLI validates it)")
        elif prov == "claude":
            print("  the claude CLI has no model-listing command; --model "
                  "takes a documented")
            print("  alias (sonnet, opus, haiku, fable) or a full model name. "
                  "Inside a session,")
            print("  /model opens the interactive picker.")
        print()
    print("model ids pass through to the provider CLI verbatim — new models "
          "work without updating teamctl.")
    return 0


# --------------------------------------------------------------------------
# hidden usage probes — run a provider TUI's own usage command inside a
# detached background tmux session (never the user's window) and scrape the
# numbers. TUI output is OBSERVED-ONLY text: parse defensively, degrade
# gracefully, and tear the TUI down with the same process-tree-verified kill
# used for teammates.
# --------------------------------------------------------------------------

PROBE_SESSION = "teamctl-probe"

# provider -> how to ask its TUI for usage. claude is deliberately absent:
# its statusline rate_limits feed (claude-usage.json) is the documented and
# cheaper source. `command` is typed into the TUI followed by Enter;
# extra_enters presses Enter again if no numbers appear (menu confirmation).
PROBES: dict[str, dict] = {
    "grok": {"argv": ["grok"], "command": "/usage", "extra_enters": 1},
    "codex": {"argv": ["codex"], "command": "/status", "extra_enters": 1},
}


def _capture_pane(pane_id: str) -> str:
    try:
        return tmux("capture-pane", "-p", "-t", pane_id).stdout
    except subprocess.CalledProcessError:
        return ""


def _probe_session_exists() -> bool:
    return tmux("has-session", "-t", f"={PROBE_SESSION}",
                check=False).returncode == 0


def _open_probe_pane(launch_line: str) -> str:
    """A window inside the detached probe session (created on demand):
    nothing ever appears in the user's own session or window."""
    if _probe_session_exists():
        return tmux("new-window", "-d", "-t", PROBE_SESSION, "-P", "-F",
                    "#{pane_id}", launch_line).stdout.strip()
    return tmux("new-session", "-d", "-s", PROBE_SESSION, "-x", "220",
                "-y", "50", "-P", "-F", "#{pane_id}",
                launch_line).stdout.strip()


def _wait_settled(pane_id: str, timeout: float) -> bool:
    """True once the pane shows non-empty content stable across two polls."""
    prev = None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        cur = _capture_pane(pane_id).strip()
        if cur and cur == prev:
            return True
        prev = cur
        time.sleep(0.4)
    return False


def parse_probe_text(text: str) -> dict:
    """Scrape usage numbers out of TUI text. Formats are OBSERVED-ONLY (e.g.
    grok: 'Weekly limit: 18%', 'Next reset: July 13, 11:33 PT'; codex
    /status output is explicitly unstable), so every field is optional:
    percentage lines become windows, reset-ish lines are kept verbatim."""
    windows: dict[str, dict] = {}
    notes: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        low = line.lower()
        m = re.search(r"(\d{1,3}(?:\.\d+)?)\s*%", line)
        if m and any(k in low for k in ("limit", "usage", "used", "quota")):
            pct = float(m.group(1))
            # codex /status phrases these as "N% left" (remaining, not used)
            if "left" in low or "remaining" in low:
                pct = max(0.0, 100.0 - pct)
            if any(k in low for k in ("week", "7d", "7-day", "seven")):
                label = "weekly"
            elif any(k in low for k in ("5h", "5-hour", "session", "hour")):
                label = "5h"
            else:
                label = (low.split(":", 1)[0].strip()[:24] or "usage")
            windows.setdefault(label, {"used_percent": pct})
        elif "reset" in low and ":" in line:
            notes.append(line)
    return {"windows": windows, "reset_notes": notes[:4]}


def probe_provider(provider: str, spec: dict, timeout: float = 40.0
                   ) -> tuple[dict | None, str]:
    """Run one hidden probe; returns (result, "") or (None, reason). The
    probe pane is always torn down, verified, before returning."""
    pane_id = ""
    try:
        launch = " ".join(shlex.quote(a) for a in spec["argv"])
        pane_id = _open_probe_pane(launch)
        if not pane_id:
            return None, "could not open a probe pane"
        if not _wait_settled(pane_id, timeout / 2):
            return None, "the TUI never settled"
        tmux("send-keys", "-t", pane_id, "-l", "--", spec["command"],
             check=False)
        tmux("send-keys", "-t", pane_id, "C-m", check=False)
        enters_left = int(spec.get("extra_enters", 0))
        deadline = time.monotonic() + timeout / 2
        while time.monotonic() < deadline:
            time.sleep(1.0)
            parsed = parse_probe_text(_capture_pane(pane_id))
            if parsed["windows"]:
                return parsed, ""
            if enters_left > 0:  # e.g. a menu needing a confirming Enter
                tmux("send-keys", "-t", pane_id, "C-m", check=False)
                enters_left -= 1
        return None, "no usage numbers appeared before the timeout"
    except TeamctlError as exc:
        return None, str(exc)
    finally:
        # verified teardown; tmux removes the probe session automatically
        # once its last window dies.
        if pane_id and not _close_pane(pane_id):
            print(f"teamctl: warning: probe pane {pane_id} did not shut "
                  "down cleanly", file=sys.stderr)


def _save_probe_result(provider: str, result: dict) -> None:
    cache = state_path().parent / "probe-usage.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    entry = {"captured_at": time.time(), "source": "probe"}
    entry.update(result)
    data[provider] = entry
    cache.parent.mkdir(parents=True, exist_ok=True)
    tmp = cache.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(cache)


def load_probe_cache() -> dict:
    cache = state_path().parent / "probe-usage.json"
    try:
        data = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def probe_stale_minutes() -> int:
    raw = (load_config().get("usage") or {}).get("probe_stale_minutes", 30)
    try:
        val = int(raw)
    except (TypeError, ValueError):
        val = 30
    return max(1, val)


def _run_probes(which: str) -> int:
    """Handle `usage --probe [provider|all]`. Returns 2 on a bad target."""
    if which == "claude":
        print("claude: probe skipped — the statusline cache is the "
              "documented, cheaper source (install it via `teamctl init`).")
        return 0
    if which == "all":
        targets = [p for p in PROBES if shutil.which(p)]
        if not targets:
            print("no probe-able provider CLI installed.", file=sys.stderr)
    elif which in PROBES:
        if shutil.which(which):
            targets = [which]
        else:
            targets = []
            print(f"{which}: not installed — probe skipped.", file=sys.stderr)
    else:
        print(f"teamctl: no probe defined for provider '{which}'.",
              file=sys.stderr)
        return 2
    for prov in targets:
        print(f"probing {prov} in hidden tmux session '{PROBE_SESSION}'…")
        result, err = probe_provider(prov, PROBES[prov])
        if result:
            _save_probe_result(prov, result)
            wins = ", ".join(f"{k} {v['used_percent']:.0f}%"
                             for k, v in result["windows"].items())
            print(f"{prov}: probe ok — {wins}")
        else:
            print(f"{prov}: probe failed ({err})")
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    """Real provider usage %/reset where the provider exposes it locally.
    Also refreshes routing signals: a provider at 100% on its 5h window is
    marked exhausted so `route` skips it until it resets."""
    if getattr(args, "probe", ""):
        rc = _run_probes(args.probe)
        if rc:
            return rc
    now = time.time()
    rl = codex_usage()
    codex = {}
    if rl:
        for key, label in (("primary", "5h"), ("secondary", "weekly")):
            w = rl.get(key) or {}
            if w.get("used_percent") is not None:
                codex[label] = {"used_percent": w["used_percent"],
                                "resets_at": w.get("resets_at")}
        pw = rl.get("primary") or {}
        if (pw.get("used_percent") or 0) >= 100 and (pw.get("resets_at") or 0) > now:
            _record_provider_signal("codex", "exhausted",
                                    resets_at=pw.get("resets_at"))

    cu = claude_usage()
    claude = {}
    claude_captured = None
    if cu:
        claude_captured = cu.get("captured_at")
        for key, label in (("five_hour", "5h"), ("seven_day", "weekly")):
            w = cu["rate_limits"].get(key) or {}
            if isinstance(w, dict) and w.get("used_percentage") is not None:
                claude[label] = {"used_percent": w["used_percentage"],
                                 "resets_at": w.get("resets_at")}
        fh = cu["rate_limits"].get("five_hour") or {}
        if isinstance(fh, dict) and (fh.get("used_percentage") or 0) >= 100 \
                and (fh.get("resets_at") or 0) > now:
            _record_provider_signal("claude", "exhausted",
                                    resets_at=fh.get("resets_at"))

    probes = load_probe_cache()
    stale_after = probe_stale_minutes() * 60

    if args.json:
        claude_json = None
        if claude:
            claude_json = dict(claude)
            claude_json["captured_at"] = claude_captured
        print(json.dumps({
            "codex": codex or None,
            "claude": claude_json,
            "grok": None,
            "probes": probes or None,
        }, indent=2))
        return 0

    def _stale_note(age_seconds: float) -> str:
        if age_seconds > stale_after:
            return " — stale, consider `teamctl usage --probe`"
        return ""

    print(f"{'PROVIDER':<8}  USAGE")
    if codex:
        for label, w in codex.items():
            print(f"{'codex':<8}  {label}: {w['used_percent']:.0f}% used, "
                  f"resets {_fmt_reset(w['resets_at'], now)}")
    else:
        print(f"{'codex':<8}  no local usage data found")
    if claude:
        if isinstance(claude_captured, (int, float)):
            age = _fmt_age(now - claude_captured) + _stale_note(now - claude_captured)
        else:
            age = "age unknown"
        for label, w in claude.items():
            print(f"{'claude':<8}  {label}: {w['used_percent']:.0f}% used, "
                  f"resets {_fmt_reset(w['resets_at'], now)}")
        print(f"{'claude':<8}  (source: statusline cache, {age})")
    else:
        print(f"{'claude':<8}  no data yet — run any Claude Code turn with the "
              "teamctl statusline installed (`teamctl init`)")
    print(f"{'grok':<8}   no local usage data exposed (probe it: "
          "`teamctl usage --probe grok`)")

    if probes:
        print(f"\n{'PROBE':<8}  (TUI-scraped, observed-only formats)")
        for prov in sorted(probes):
            entry = probes[prov]
            if not isinstance(entry, dict):
                continue
            cap = entry.get("captured_at")
            age = (_fmt_age(now - cap) + _stale_note(now - cap)
                   if isinstance(cap, (int, float)) else "age unknown")
            windows = entry.get("windows") or {}
            for label, w in windows.items():
                if isinstance(w, dict) and w.get("used_percent") is not None:
                    print(f"{prov:<8}  {label}: {w['used_percent']:.0f}% used "
                          f"({age})")
            for note in entry.get("reset_notes") or []:
                print(f"{prov:<8}  {note}")
    return 0


def cmd_providers(args: argparse.Namespace) -> int:
    cache = state_path().parent / "providers.json"
    try:
        cached = json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        cached = {}

    rows = []
    for prov in ("claude", "codex", "grok"):
        installed = shutil.which(prov) is not None
        authed = provider_authed(prov)
        if not installed:
            status = "not-installed"
        elif not authed:
            status = "not-authed"
        else:
            status = "available"
            if prov == "grok" and not AUTH_PATHS["grok"].exists():
                status += (" (inferred from ~/.grok CLI data; no auth.json "
                           "— observed heuristic, verify with `grok models`)")
        last = cached.get(prov, {})
        sig = _live_signal(last)
        if sig in ("exhausted", "auth-error"):
            status = f"{sig} (last seen {last.get('at', '?')})"
            ra = last.get("resets_at")
            if ra:
                status += f", resets {_fmt_reset(ra, time.time())}"
        rows.append((prov, status))

    if args.json:
        print(json.dumps({p: s for p, s in rows}, indent=2))
        return 0
    print(f"{'PROVIDER':<8}  STATUS")
    for prov, status in rows:
        print(f"{prov:<8}  {status}")
    return 0


ROUTABLE = ("claude", "codex", "grok")


def _cached_signals() -> dict:
    cache = state_path().parent / "providers.json"
    try:
        return json.loads(cache.read_text()) if cache.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}


def route_select(requested: list[str] | None = None
                 ) -> tuple[str | None, list[str], dict[str, str]]:
    """Pick the best available provider.

    Returns (selected, preference, exclusions) where exclusions maps each
    rejected candidate to a reason: unknown / not-installed / not-authed /
    exhausted / auth-error. selected is None when no candidate survives.
    """
    candidates = requested if requested else list(ROUTABLE)
    cached = _cached_signals()
    exclusions: dict[str, str] = {}
    survivors: list[str] = []
    for prov in candidates:
        if prov not in ROUTABLE:
            exclusions[prov] = "unknown"
            continue
        if shutil.which(prov) is None:
            exclusions[prov] = "not-installed"
            continue
        if not provider_authed(prov):
            exclusions[prov] = "not-authed"
            continue
        signal = _live_signal(cached.get(prov))
        if signal in ("exhausted", "auth-error"):
            exclusions[prov] = signal
            continue
        survivors.append(prov)

    preference = (load_config().get("routing") or {}).get("preference")
    if not isinstance(preference, list) or not preference:
        preference = list(ROUTABLE)
    ranked = sorted(
        survivors,
        key=lambda p: (preference.index(p) if p in preference else len(preference),
                       survivors.index(p)),
    )
    return (ranked[0] if ranked else None), preference, exclusions


def cmd_route(args: argparse.Namespace) -> int:
    requested = [p.strip() for p in args.providers.split(",") if p.strip()] \
        if args.providers else None
    selected, preference, exclusions = route_select(requested)

    if selected is None:
        print("teamctl: route found no available provider:", file=sys.stderr)
        for prov, reason in exclusions.items():
            print(f"  {prov}: {reason}", file=sys.stderr)
        return 1

    configured = (load_config().get("routing") or {}).get("preference")
    if isinstance(configured, list) and configured:
        reason = f"first available in your preference {'>'.join(preference)}"
    else:
        reason = (f"first available in alphabetical order "
                  f"{'>'.join(preference)} — an arbitrary order, not a "
                  "recommendation; set yours with `teamctl config "
                  "routing.preference ...`")
    if exclusions:
        skipped = ", ".join(f"{p}: {r}" for p, r in exclusions.items())
        reason += f"; skipped {skipped}"
    print(f"route: selected {selected} ({reason})")

    if args.dry_run:
        cwd, model, effort, task = _resolve_dispatch(
            selected, args.task, "", args.model, args.effort, args.cwd)
        argv = headless_argv(selected, task, model, effort)
        print("dry-run: " + " ".join(shlex.quote(a) for a in argv))
        return 0

    return _do_dispatch(args.role, selected, args.task, "",
                        args.model, args.effort, args.cwd)


