  set-option -ga status-right ' #{?#{@model},│ #{@role} · #{@model} ,}'
}
""" + TMUX_MARKER_END + "\n"

STATUSLINE_ENTRY = {"type": "command", "command": "~/.local/bin/claude-statusline"}


def _input(prompt: str) -> str:
    """Thin wrapper around input() so tests can script wizard answers."""
    return input(prompt)


def _ask(prompt: str, default: str = "") -> str:
    # EOFError: real stdin ran dry (non-tty). StopIteration: a scripted
    # _input (tests) ran out of answers — same meaning, same default.
    try:
        raw = _input(prompt).strip()
    except (EOFError, StopIteration):
        return default
    return raw or default


def _ask_yn(prompt: str, default: bool = False) -> bool:
    raw = _ask(prompt).lower()
    if not raw:
        return default
    return raw in ("y", "yes")


def _toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _detect_providers() -> list[tuple[str, bool, bool]]:
    """(provider, installed, authed) for every routable provider."""
    return [(prov, shutil.which(prov) is not None, AUTH_PATHS[prov].exists())
            for prov in ROUTABLE]


def _render_config(providers_cfg: dict[str, dict[str, str]], verbosity: str) -> str:
    lines = [
        "# agent-team configuration (written by `teamctl init`)",
        "# Delete this file to fall back to each provider CLI's own defaults.",
        "",
        "[output]",
        f'verbosity = "{_toml_escape(verbosity)}"',
    ]
    for prov, vals in providers_cfg.items():
        lines += ["", f"[providers.{prov}]"]
        wrote = False
        for key in ("model", "effort"):
            if vals.get(key):
                lines.append(f'{key} = "{_toml_escape(vals[key])}"')
                wrote = True
        if not wrote:
            lines.append(f'# model = ""   # unset: {prov} uses its own defaults')
            lines.append('# effort = ""')
    return "\n".join(lines) + "\n"


def cmd_init(args: argparse.Namespace) -> int:
    home = Path.home()
    changes: list[tuple[str, str]] = []

    print("teamctl init — set up defaults and optional integrations.")
    print("A summary of everything changed, with exact revert steps, is")
    print("printed at the end. Optional steps default to 'no'.\n")

    print("Provider CLIs:")
    available: list[str] = []
    for prov, installed, authed in _detect_providers():
        if not installed:
            status = "not installed"
        elif not authed:
            status = "installed, but not logged in (log in, then re-run `teamctl init`)"
        else:
            status = "available"
            available.append(prov)
        print(f"  {prov:<7} {status}")
    print()

    providers_cfg: dict[str, dict[str, str]] = {}
    for prov in available:
        if args.yes:
            providers_cfg[prov] = {"model": "", "effort": ""}
            continue
        print(f"{prov}: choose defaults (leave blank to keep the CLI's own default).")
        model = _ask(f"  default model for {prov}: ")
        if prov == "grok":
            print("  note: grok has no persistent effort setting of its own;")
            print("  teamctl passes your choice per invocation via --effort.")
        effort = _ask(f"  default effort for {prov} (e.g. low, medium, high): ")
        providers_cfg[prov] = {"model": model, "effort": effort}

    verbosity = "normal"
    if not args.yes:
        v = _ask("Output verbosity — terse / normal / detailed [normal]: ",
                 "normal").lower()
        if v in ("terse", "normal", "detailed"):
            verbosity = v
        else:
            print(f"  unrecognized verbosity '{v}'; using 'normal'")

    cfg_path = home / ".config" / "agent-team" / "config.toml"
    backed_up = False
    if cfg_path.exists():
        shutil.copy2(cfg_path, cfg_path.with_name("config.toml.bak-teamctl"))
        backed_up = True
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text(_render_config(providers_cfg, verbosity))
    print(f"\nwrote {cfg_path}"
          + (" (previous file backed up to config.toml.bak-teamctl)" if backed_up else ""))
    changes.append((
        f"wrote {cfg_path}",
        f"rm {cfg_path}"
        + (f"  (or restore {cfg_path.with_name('config.toml.bak-teamctl')})"
           if backed_up else ""),
    ))

    # -- optional: tmux pane borders + status-bar segment ------------------
    want_tmux = False if args.yes else _ask_yn(
        "Add teamctl pane-border/status-bar block to ~/.tmux.conf? [y/N] ")
    if want_tmux:
        conf = home / ".tmux.conf"
        text = conf.read_text() if conf.exists() else ""
        if TMUX_MARKER_BEGIN in text:
            print(f"{conf} already contains the teamctl block — skipping.")
        else:
            if conf.exists():
                bak = home / ".tmux.conf.bak-teamctl"
                shutil.copy2(conf, bak)
                print(f"backed up {conf} to {bak}")
            with open(conf, "a") as fh:
                if text and not text.endswith("\n"):
                    fh.write("\n")
                fh.write("\n" + TMUX_BLOCK)
            print(f"appended teamctl block to {conf}")
            print("apply it now with: tmux source-file ~/.tmux.conf")
            changes.append((
                f"appended a marker-guarded block to {conf}",
                "delete the block between the '# --- BEGIN teamctl ---' and "
                f"'# --- END teamctl ---' lines (or restore {home / '.tmux.conf.bak-teamctl'}), "
                "then reset the live options: tmux set-option -gu pane-border-status; "
                "tmux set-option -gu pane-border-format; tmux set-option -gu status-right; "
                "tmux set-option -gu @teamctl_status_added",
            ))

    # -- optional: Claude Code status line ---------------------------------
    want_statusline = False if args.yes else _ask_yn(
        "Install claude-statusline for Claude Code's status line "
        "(shows model · effort · ctx%)? [y/N] ")
    if want_statusline:
        dest = home / ".local" / "bin" / "claude-statusline"
        src: Path | None = Path(__file__).resolve().parent / "claude-statusline"
        if not src.exists():
            found = shutil.which("claude-statusline")
            src = Path(found) if found else None
        if src is None:
            print("could not find claude-statusline next to teamctl or on PATH — "
                  "skipping this step.")
        else:
            dest.parent.mkdir(parents=True, exist_ok=True)
            if src.resolve() != dest.resolve():
                shutil.copy2(src, dest)
            os.chmod(dest, 0o755)
            print(f"installed {dest}")
            changes.append((f"installed {dest}", f"rm {dest}"))

            settings_path = home / ".claude" / "settings.json"
            if settings_path.exists():
                try:
                    data = json.loads(settings_path.read_text())
                except (json.JSONDecodeError, OSError):
                    data = None
                if not isinstance(data, dict):
                    print(f"could not parse {settings_path} — leaving it untouched.")
                    print('add this key yourself:  "statusLine": '
                          + json.dumps(STATUSLINE_ENTRY))
                elif "statusLine" in data:
                    print(f"{settings_path} already has a statusLine key — "
                          "leaving it as is.")
                else:
                    bak = Path(str(settings_path) + ".bak-teamctl")
                    shutil.copy2(settings_path, bak)
                    data["statusLine"] = dict(STATUSLINE_ENTRY)
                    settings_path.write_text(json.dumps(data, indent=2) + "\n")
                    print(f"added statusLine key to {settings_path} (backup: {bak})")
                    changes.append((
                        f"added a statusLine key to {settings_path}",
                        f"restore {bak}, or delete the statusLine key",
                    ))
            else:
                settings_path.parent.mkdir(parents=True, exist_ok=True)
                settings_path.write_text(
                    json.dumps({"statusLine": dict(STATUSLINE_ENTRY)}, indent=2) + "\n")
                print(f"created {settings_path} with a statusLine key")
                changes.append((f"created {settings_path}", f"rm {settings_path}"))

    # -- optional: lead mode (manager identity for a Claude Code lead) ------
    want_lead = False if args.yes else _ask_yn(
        "Install lead mode for Claude Code (teamctl lead on)? [y/N] ")
    if want_lead:
        _lead_install_skill(changes)
        _lead_install_claude_md(changes)
        if _lead_status()["hook"] == "installed":
            print("settings.json already has a teamctl-lead hook — skipping.")
        elif _ask_yn("Also install the per-prompt reminder hook "
                     "(strongest tier — survives context compaction)? [y/N] "):
            _lead_install_hook(changes)

    print("\nSummary of changes:")
    for what, revert in changes:
        print(f"  * {what}")
        print(f"    revert: {revert}")
    if not changes:
        print("  nothing was changed")
    return 0


