#!/usr/bin/env python3
"""teamctl - deprecated. This tool is now `orchestrator`.

teamctl was renamed Orchestrator on 2026-08-09. This file exists so that a
pre-rename install can still reach the new one: `teamctl update` fetches it
(the old repo path redirects), and running it installs `orchestrator` beside
this shim and hands the command straight through. Once `orchestrator` is on
your PATH you can delete this file — `orchestrator uninstall` also clears it.
"""

VERSION = "0.5.4"

import os
import sys
import urllib.request
from pathlib import Path

SOURCE = ("https://raw.githubusercontent.com/ryderderder/orchestrator/main"
          "/orchestrator")


def main() -> int:
    dest = Path(__file__).resolve().parent / "orchestrator"
    if not dest.exists():
        print("teamctl is now orchestrator — installing it once, then "
              "running your command.", file=sys.stderr)
        try:
            with urllib.request.urlopen(SOURCE, timeout=30) as r:
                text = r.read().decode()
            compile(text, "orchestrator", "exec")   # never install a bad file
        except Exception as exc:                    # noqa: BLE001 - report any
            print(f"could not fetch orchestrator from {SOURCE}: {exc}\n"
                  "install it directly:\n  curl -fsSL https://raw."
                  "githubusercontent.com/ryderderder/orchestrator/main/"
                  "install.sh | bash", file=sys.stderr)
            return 1
        tmp = dest.with_name(dest.name + ".tmp-shim")
        tmp.write_text(text)
        os.chmod(tmp, 0o755)
        tmp.replace(dest)
    print("`teamctl` is deprecated — run `orchestrator` instead.",
          file=sys.stderr)
    os.execv(sys.executable, [sys.executable, str(dest), *sys.argv[1:]])


if __name__ == "__main__":
    sys.exit(main())
