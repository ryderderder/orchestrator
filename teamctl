TMUX_MARKER_BEGIN = "# --- BEGIN teamctl ---"
TMUX_MARKER_END = "# --- END teamctl ---"
TMUX_BLOCK = TMUX_MARKER_BEGIN + """
# Added by `teamctl init`. Reversible: delete this block (including the
# BEGIN/END marker lines) and run `tmux source-file ~/.tmux.conf`.
#
# Sticky per-pane border label showing a teammate pane's "role · model",
# read from the @role/@model per-pane user options teamctl sets at spawn.
# Panes teamctl didn't spawn have no @model and get an empty label.
# User options are used because provider CLIs overwrite pane titles, and
# some tmux builds do not execute #() shell commands in status formats.
set-option -g pane-border-status top
set-option -g pane-border-format '#{?#{@model}, #{@role} · #{@model} ,}'
# Append the active pane's "role · model" to the status bar. Guarded so
# re-sourcing this file does not append the segment a second time.
if-shell -F '#{?@teamctl_status_added,0,1}' {
  set-option -g @teamctl_status_added 1
  set-option -ga status-right ' #{?#{@model},│ #{@role} · #{@model} ,}'
}
""" + TMUX_MARKER_END + "\n"

STATUSLINE_ENTRY = {"type": "command",
                    "command": "~/.local/bin/teamctl statusline"}


def _legacy_statusline_commands() -> tuple[str, ...]:
    """statusLine commands written by pre-v0.4.0 installs (the separate
    claude-statusline script), in both tilde and expanded forms."""
    return ("~/.local/bin/claude-statusline",
            str(Path.home() / ".local" / "bin" / "claude-statusline"))


def _our_statusline_commands() -> set[str]:
    """Every statusLine command teamctl has ever written (for uninstall
    and migration matching)."""
    return set(_legacy_statusline_commands()) | {
        STATUSLINE_ENTRY["command"],
        str(Path.home() / ".local" / "bin" / "teamctl") + " statusline",
    }


def _migrate_legacy_statusline(bin_dir: Path | None = None) -> list[str]:
    """v0.4.0 fold: the statusline became `teamctl statusline`. Rewrite an
    old claude-statusline wiring in settings.json and remove the orphaned
    script. Best-effort; returns human-readable notes ([] = nothing)."""
    notes: list[str] = []
    sp = Path.home() / ".claude" / "settings.json"
    try:
        data = json.loads(sp.read_text()) if sp.exists() else None
    except (json.JSONDecodeError, OSError):
        data = None
    if isinstance(data, dict):
        sl = data.get("statusLine")
        if isinstance(sl, dict) \
                and sl.get("command") in _legacy_statusline_commands():
            bak = Path(str(sp) + ".bak-teamctl")
            try:
                shutil.copy2(sp, bak)
                data["statusLine"] = dict(STATUSLINE_ENTRY)
                sp.write_text(json.dumps(data, indent=2) + "\n")
                notes.append(f"statusLine in {sp} now runs `teamctl "
                             f"statusline` (backup: {bak})")
            except OSError:
                pass
    legacy = Path(bin_dir or Path.home() / ".local" / "bin") \
        / "claude-statusline"
    try:
        if legacy.exists():
            legacy.unlink()
            notes.append(f"removed the orphaned {legacy} (its job moved "
                         "into `teamctl statusline`)")
    except OSError:
        pass
    return notes


def _input(prompt: str) -> str:
    """Thin wrapper around input() so tests can script wizard answers."""
    return input(prompt)


def _ask(prompt: str, default: str = "") -> str:
    # EOFError: real stdin ran dry (non-tty). StopIteration: a scripted
    # _input (tests) ran out of answers — same meaning, same default.
    try:
        raw = _input(prompt).strip()
    except (EOFError, StopIteration):
        return default
    return raw or default


def _ask_yn(prompt: str, default: bool = False) -> bool:
    raw = _ask(prompt).lower()
    if not raw:
        return default
    return raw in ("y", "yes")


def _toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _detect_providers() -> list[tuple[str, str]]:
    """(provider, lattice state) for every routable provider. A provider is
    usable for config/routing when signed in — state `quiet` or `ready`
    (usage data changes the word, not the eligibility)."""
    return [(prov, provider_state(prov)[0]) for prov in routable_providers()]


def _usable(rows: list[tuple[str, str]]) -> list[str]:
    """The signed-in providers from a _detect_providers() listing."""
    return [prov for prov, state in rows if state in ("quiet", "ready")]


def _render_config(providers_cfg: dict[str, dict[str, str]], verbosity: str,
                   preference: list[str] | None = None,
                   delegation: str = "ask") -> str:
    lines = [
        "# agent-team configuration (written by `teamctl init`)",
        "# Delete this file to fall back to each provider CLI's own defaults.",
        "",
        "[output]",
        f'verbosity = "{_toml_escape(verbosity)}"',
        "",
        "[lead]",
        "# how a lead agent decides to delegate: ask | always | manual",
        f'delegation = "{_toml_escape(delegation)}"',
    ]
    # the wizard never asks about updates, so re-running it must not reset
    # the user's choice: carry the settings currently in force forward
    upd_check, upd_mode = update_settings()
    lines += [
        "",
        "[update]",
        "# once-a-day background version check; mode: prompt | auto | off",
        f"check = {'true' if upd_check else 'false'}",
        f'mode = "{upd_mode}"',
    ]
    if preference:
        lines += [
            "",
            "[routing]",
            "# your auto-routing order (also the --provider default);",
            "# reorder any time: teamctl config routing.preference \"a,b,c\"",
            f"preference = {_toml_value(list(preference))}",
            "# strategy: headroom (most remaining quota wins; preference",
            "# breaks ties) | preference (strict order)",
            'strategy = "headroom"',
        ]
    for prov, vals in providers_cfg.items():
        lines += ["", f"[providers.{prov}]"]
        wrote = False
        for key in ("model", "effort"):
            if vals.get(key):
                lines.append(f'{key} = "{_toml_escape(vals[key])}"')
                wrote = True
        if not wrote:
            lines.append(f'# model = ""   # unset: {prov} uses its own defaults')
            lines.append('# effort = ""')
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------
# setup experience — three paths, one config schema. Canonical design:
# docs/design/installer-spec.md ("teamctl Setup Experience", Grok 4.5).
#
#   express (default `init`)  zero questions; wordmark frame; sane defaults
#   custom  (`init --custom`) 3-screen curses cockpit: models → posture → seal
#   plain   (degrade / `p`)   short prompts, Express defaults on blank
#
# The cockpit degrades to the plain path whenever curses cannot run: no real
# tty on stdin/stdout (scripted runs, CI, pipes), a dumb TERM, curses
# missing, or TEAMCTL_UI=plain. The scripted-stdin test seams (tc._input)
# therefore keep working — redirected stdio is never a tty.
# --------------------------------------------------------------------------

# claude has no model-listing command; these are its documented --model
# aliases. codex/grok lists come from discover_models() (cache / CLI).
CLAUDE_MODEL_ALIASES = ("sonnet", "opus", "haiku", "fable")

EFFORT_CHOICES = ("low", "medium", "high", "xhigh")

VOICE_CHOICES = ("terse", "normal", "detailed")

LEAD_CHOICES = ("ask", "always", "manual")

LEAD_GLOSS = {"ask": "check once per session",
              "always": "hand off non-trivial work",
              "manual": "only when told"}

# spec §1.1 — 256-color palette; background stays the terminal's own.
_PALETTE = (("accent", 51), ("ok", 114), ("warn", 180), ("dim", 240),
            ("soft", 44), ("primary", 252), ("border", 238), ("bad", 167),
            ("mute", 236))
_ROLE_PAIR = {name: i for i, (name, _) in enumerate(_PALETTE, start=1)}
_SELECT_PAIR = 10          # fg 232 on bg 51 (spec: selection bar)
_HAS_256 = False


class _RichUnusable(Exception):
    """The curses UI cannot run here (raised mid-flight, e.g. tiny term)."""


def _use_rich_ui() -> bool:
    """True when the arrow-key curses UI should be attempted."""
    ui = os.environ.get("TEAMCTL_UI", "").strip().lower()
    if ui in ("plain", "line", "never", "0"):
        return False
    if curses is None:
        return False
    try:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return False
    except (AttributeError, ValueError):
        return False
    term = os.environ.get("TERM", "")
    if not term or term in ("dumb", "unknown"):
        return False
    return True


def _ansi_ok() -> bool:
    """Color for the non-curses frames (express, post-write)."""
    if os.environ.get("NO_COLOR") or os.environ.get("TEAMCTL_PLAIN") == "1":
        return False
    try:
        if not sys.stdout.isatty():
            return False
    except (AttributeError, ValueError):
        return False
    term = os.environ.get("TERM", "")
    return bool(term) and term != "dumb"


def _fg(role: str, s: str) -> str:
    """256-color ANSI tint for print()-based frames; plain when unsuitable."""
    if not _ansi_ok():
        return s
    return f"\033[38;5;{dict(_PALETTE)[role]}m{s}\033[0m"


def _out_glyphs() -> dict[str, str]:
    """Unicode accents when stdout can encode them, ASCII otherwise."""
    enc = (getattr(sys.stdout, "encoding", "") or "").upper()
    if "UTF" in enc:
        return {"rule": "━", "chev": "›", "dot": "·", "arrow": "→",
                "dash": "—"}
    return {"rule": "=", "chev": ">", "dot": "*", "arrow": "->", "dash": "--"}


def _tilde(p) -> str:
    home = str(Path.home())
    s = str(p)
    return "~" + s[len(home):] if s.startswith(home) else s


def _model_choices(provider: str) -> list[str]:
    """Model ids offered as picks. Ids always pass through to the CLI
    verbatim, so the 'custom…' escape hatch accepts anything."""
    if provider == "claude":
        return list(CLAUDE_MODEL_ALIASES)
    return discover_models(provider)


def _ui_glyphs() -> dict[str, str]:
    """Unicode accents for curses when the locale can render them."""
    try:
        import locale
        utf = "UTF" in (locale.nl_langinfo(locale.CODESET) or "").upper()
    except (ImportError, AttributeError, ValueError):
        utf = False
    if utf:
        return {"sel": "› ", "on": "●", "off": "○", "l": "‹ ", "r": " ›",
                "sep": " › ", "dot": "·", "dash": "—", "more": "…"}
    return {"sel": "> ", "on": "*", "off": "o", "l": "< ", "r": " >",
            "sep": " > ", "dot": "*", "dash": "--", "more": "..."}


def _addstr(win, y: int, x: int, s: str, attr: int = 0) -> None:
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass  # clipped at a screen edge — cosmetic only
    except (UnicodeEncodeError, ValueError):
        # a non-UTF-8 locale can't encode a fancy glyph: draw ASCII instead
        try:
            win.addstr(y, x, s.encode("ascii", "replace").decode(), attr)
        except curses.error:
            pass


def _curses_colors() -> None:
    """Palette init shared by the cockpit and the config menu; sets 256-color
    pairs when the terminal has them, else the drawing code degrades to
    reverse-video / dim attributes (spec §1.1 degrade rule)."""
    global _HAS_256
    _HAS_256 = False
    try:
        curses.start_color()
        curses.use_default_colors()
        if getattr(curses, "COLORS", 0) >= 256:
            for i, (_name, code) in enumerate(_PALETTE, start=1):
                curses.init_pair(i, code, -1)
            curses.init_pair(_SELECT_PAIR, 232, 51)
            _HAS_256 = True
    except curses.error:
        _HAS_256 = False


def _cattr(role: str) -> int:
    if not _HAS_256:
        if role == "select":
            return curses.A_REVERSE
        if role in ("dim", "mute", "border"):
            return curses.A_DIM
        if role in ("accent", "soft", "ok", "warn"):
            return curses.A_BOLD
        return curses.A_NORMAL
    if role == "select":
        return curses.color_pair(_SELECT_PAIR)
    return curses.color_pair(_ROLE_PAIR[role])


def _pair(n: int) -> int:
    """Legacy pair accessor used by the config menu (1 accent, 2 ok, 3 warn)."""
    try:
        return curses.color_pair(n)
    except curses.error:
        return 0


def _curses_prompt(stdscr, label: str) -> str:
    """One-line text input on the bottom row (custom model ids, menu edits)."""
    h, _ = stdscr.getmaxyx()
    stdscr.move(h - 1, 0)
    stdscr.clrtoeol()
    _addstr(stdscr, h - 1, 0, label, curses.A_BOLD)
    curses.echo()
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        raw = stdscr.getstr(h - 1, len(label) + 1, 80)
    except (curses.error, KeyboardInterrupt):
        raw = b""
    finally:
        curses.noecho()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
    return raw.decode("utf-8", "replace").strip()


# --------------------------------------------------------------------------
# custom cockpit — 3 screens (models → posture → seal), spec §4
# --------------------------------------------------------------------------

_COCKPIT_FOOTERS = {
    1: "↑↓ move   enter choose   tab next provider   n next   p plain   q quit",
    2: "↑↓ section/item   enter choose   n next   b back   p plain   q quit",
    3: "↑↓  space toggle  enter run  b back  p plain  q quit",
}

_COCKPIT_TITLES = {1: "pick a model — or leave the CLI its secrets",
                   2: "how hard · how loud · when to hand off",
                   3: "seal it"}

_EXTRAS_ROWS = (
    ("tmux", "tmux borders", "pane labels · role · model"),
    ("statusline", "claude statusline", "model · effort · ctx%"),
    ("lead", "lead mode", "manager identity for agent CLIs"),
    ("hook", "lead hook", "per-prompt reminder (claude only)"),
)


def _cockpit_rows(screen: int, state: dict, ready: list[str],
                  discovered: dict[str, list[str]]) -> list[dict]:
    g = _ui_glyphs()
    rows: list[dict] = [{"kind": "title", "text": _COCKPIT_TITLES[screen]},
                        {"kind": "blank"}]
    if screen == 1:
        # cap visible discoveries so three provider blocks still fit the
        # spec's 100×30 canvas; the tail collapses into a "… N more" row
        # that jumps to the custom editor (spec §4.3).
        cap = {1: 8, 2: 5}.get(len(ready), 3)
        for prov in ready:
            rows.append({"kind": "header", "text": prov})
            rows.append({"kind": "choice", "group": ("model", prov),
                         "value": "", "label": "(provider default)"})
            found = discovered.get(prov) or []
            for m in found[:cap]:
                rows.append({"kind": "choice", "group": ("model", prov),
                             "value": m, "label": m})
            if len(found) > cap:
                rows.append({"kind": "more", "prov": prov,
                             "label": f"{g['more']} {len(found) - cap} more"})
            custom_val = state["models"].get(prov, "")
            is_custom = custom_val and custom_val not in found[:cap]
            rows.append({"kind": "custom", "prov": prov,
                         "label": (f"custom:  {custom_val}" if is_custom
                                   else f"custom{g['more']}")})
            rows.append({"kind": "blank"})
        rows.append({"kind": "info",
                     "text": f"{g['dot']} discovered via teamctl models "
                             f"{g['dot']} ids pass through verbatim"})
    elif screen == 2:
        rows.append({"kind": "header", "text": "effort",
                     "note": "[global for all ready]"})
        efforts = ["high", "medium", "low"]
        if "codex" in ready:
            efforts.append("xhigh")
        for e in efforts:
            rows.append({"kind": "choice", "group": ("effort",),
                         "value": e, "label": e})
        rows.append({"kind": "blank"})
        rows.append({"kind": "header", "text": "voice"})
        for v in VOICE_CHOICES:
            rows.append({"kind": "choice", "group": ("voice",),
                         "value": v, "label": v})
        rows.append({"kind": "blank"})
        rows.append({"kind": "header", "text": "lead"})
        for d in LEAD_CHOICES:
            rows.append({"kind": "choice", "group": ("lead",), "value": d,
                         "label": f"{d:<12} {g['dash']} {LEAD_GLOSS[d]}"})
        if len(ready) > 1:
            rows.append({"kind": "blank"})
            rows.append({"kind": "header", "text": "route"})
            for i, prov in enumerate(state["route"], start=1):
                rows.append({"kind": "route", "prov": prov,
                             "label": f"{i}  {prov}"})
            rows.append({"kind": "info",
                         "text": f"{g['dot']} h/l or </> swap {g['dot']} "
                                 "order is yours, not ours"})
    else:
        rows.append({"kind": "header", "text": "review"})
        route_txt = g["sep"].join(state["route"]) if state["route"] else "—"
        rows.append({"kind": "review", "key": "route", "val": route_txt})
        for prov in ready:
            model = state["models"].get(prov) or "(cli default)"
            rows.append({"kind": "review", "key": prov,
                         "val": f"{model} {g['dot']} {state['effort']}"})
        rows.append({"kind": "review", "key": "voice", "val": state["voice"]})
        rows.append({"kind": "review", "key": "lead", "val": state["lead"]})
        rows.append({"kind": "blank"})
        rows.append({"kind": "header", "text": "extras",
                     "note": "[off by default]"})
        for key, label, gloss in _EXTRAS_ROWS:
            rows.append({"kind": "check", "key": key, "label": label,
                         "gloss": gloss})
        rows.append({"kind": "blank"})
        rows.append({"kind": "action", "act": "write", "label": "write config"})
        rows.append({"kind": "action", "act": "abort", "label": "abort"})
        rows.append({"kind": "blank"})
        rows.append({"kind": "info",
                     "text": f"{g['dot']} backups first {g['dot']} extras "
                             f"default off {g['dot']} re-run anytime"})
    return rows


_FOCUSABLE = ("choice", "custom", "more", "route", "check", "action")


def _paint_cockpit(stdscr, screen: int, rows: list[dict], sel: int,
                   state: dict) -> None:
    g = _ui_glyphs()
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    if h < len(rows) + 4 or w < 70:
        raise _RichUnusable("terminal too small for the cockpit")
    _addstr(stdscr, 0, 0, "teamctl", _cattr("primary") | curses.A_BOLD)
    _addstr(stdscr, 0, 7, f"  {g['dot']}  ", _cattr("dim"))
    _addstr(stdscr, 0, 12, "custom", _cattr("accent"))
    x = 0
    for i, name in enumerate(("1 models", "2 posture", "3 seal"), start=1):
        role = "accent" if i == screen else ("ok" if i < screen else "dim")
        _addstr(stdscr, 1, x, name, _cattr(role))
        x += len(name)
        if i < 3:
            _addstr(stdscr, 1, x, " ── ", _cattr("mute"))
            x += 4
    y = 3
    bar_w = min(w - 4, 96)
    for i, r in enumerate(rows):
        kind = r["kind"]
        if kind == "blank":
            y += 1
            continue
        if kind == "title":
            _addstr(stdscr, y, 2, r["text"], _cattr("primary"))
        elif kind == "header":
            _addstr(stdscr, y, 2, r["text"], _cattr("soft") | curses.A_BOLD)
            if r.get("note"):
                _addstr(stdscr, y, 50, r["note"], _cattr("dim"))
        elif kind == "info":
            _addstr(stdscr, y, 2, r["text"], _cattr("dim"))
        elif kind == "review":
            _addstr(stdscr, y, 4, f"{r['key']:<10}", _cattr("dim"))
            _addstr(stdscr, y, 14, r["val"], _cattr("primary"))
        else:
            focused = (i == sel)
            if kind == "choice":
                committed = _cockpit_get(state, r["group"]) == r["value"]
                label = r["label"]
            elif kind == "check":
                committed = state["extras"][r["key"]]
                label = f"{'[x]' if committed else '[ ]'}  {r['label']:<20} "
            elif kind == "custom":
                committed = r["label"].startswith("custom: ")
                label = r["label"]
            else:
                committed = False
                label = r["label"]
            if focused:
                _addstr(stdscr, y, 2, (g["sel"] + label).ljust(bar_w),
                        _cattr("select"))
                if kind == "check":
                    _addstr(stdscr, y, 2 + len(g["sel"]) + len(label),
                            r["gloss"], _cattr("select"))
            else:
                attr = _cattr("ok") if committed else (
                    _cattr("dim") if kind in ("more", "info") else
                    _cattr("primary"))
                _addstr(stdscr, y, 2, "  " + label, attr)
                if kind == "check":
                    _addstr(stdscr, y, 4 + len(label), r["gloss"],
                            _cattr("dim"))
        y += 1
    _addstr(stdscr, h - 1, 1, _COCKPIT_FOOTERS[screen], _cattr("dim"))
    stdscr.refresh()


def _cockpit_get(state: dict, group: tuple):
    if group[0] == "model":
        return state["models"].get(group[1], "")
    return state[group[0]]


def _cockpit_set(state: dict, group: tuple, value) -> None:
    if group[0] == "model":
        state["models"][group[1]] = value
    else:
        state[group[0]] = value
    state["dirty"] = True


def _edit_custom_model(stdscr, state: dict, prov: str) -> None:
    txt = _curses_prompt(stdscr, f"custom model id for {prov}:")
    state["models"][prov] = txt          # empty = provider default (spec §6.3)
    state["dirty"] = True


def _run_cockpit():
    """Drive the 3-screen cockpit. Returns (state, ready) on write, or one
    of 'abort' | 'cancel' | 'plain', or None when curses cannot run."""
    try:
        import locale
        locale.setlocale(locale.LC_ALL, "")
    except Exception:
        pass
    ready = _usable(_detect_providers())
    discovered = {p: _model_choices(p) for p in ready}
    state = {
        "models": {p: "" for p in ready},
        "effort": "high", "voice": "normal", "lead": "ask",
        "route": sorted(ready),
        "extras": {k: False for k, _l, _g in _EXTRAS_ROWS},
        "dirty": False,
    }

    def run(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        _curses_colors()
        screen = 1 if ready else 2       # nothing to pick without providers
        focus: dict[int, int | None] = {1: None, 2: None, 3: None}
        while True:
            rows = _cockpit_rows(screen, state, ready, discovered)
            focusables = [i for i, r in enumerate(rows)
                          if r["kind"] in _FOCUSABLE]
            if not focusables:
                raise _RichUnusable("nothing to focus")
            if focus[screen] is None:
                if screen == 3:          # fast path: write pre-focused
                    focus[screen] = next(i for i, r in enumerate(rows)
                                         if r.get("act") == "write")
                else:
                    focus[screen] = focusables[0]
            if focus[screen] not in focusables:
                focus[screen] = focusables[0]
            sel = focus[screen]
            _paint_cockpit(stdscr, screen, rows, sel, state)

            ch = stdscr.getch()
            r = rows[sel]
            if ch in (curses.KEY_UP, ord("k")):
                pos = focusables.index(sel)
                focus[screen] = focusables[max(0, pos - 1)]
            elif ch in (curses.KEY_DOWN, ord("j")):
                pos = focusables.index(sel)
                focus[screen] = focusables[min(len(focusables) - 1, pos + 1)]
            elif ch == 9 and screen == 1:        # Tab: next provider block
                headers = [i for i, row in enumerate(rows)
                           if row["kind"] == "header"]
                nxt = next((i for i in headers if i > sel), None)
                if nxt is None and headers:
                    nxt = headers[0]
                if nxt is not None:
                    focus[screen] = next(i for i in focusables if i > nxt)
            elif ch in (10, 13, curses.KEY_ENTER, ord(" ")):
                if r["kind"] == "choice":
                    _cockpit_set(state, r["group"], r["value"])
                elif r["kind"] in ("custom", "more"):
                    _edit_custom_model(stdscr, state, r["prov"])
                elif r["kind"] == "check":
                    state["extras"][r["key"]] = not state["extras"][r["key"]]
                    state["dirty"] = True
                elif r["kind"] == "action" and ch != ord(" "):
                    return r["act"]
            elif ch == ord("e") and r["kind"] in ("custom", "more"):
                _edit_custom_model(stdscr, state, r["prov"])
            elif (ch in (ord("h"), ord("l"), ord("<"), ord(">"))
                  and r["kind"] == "route"):
                order = state["route"]
                idx = order.index(r["prov"])
                delta = -1 if ch in (ord("h"), ord("<")) else 1
                j = idx + delta
                if 0 <= j < len(order):
                    order[idx], order[j] = order[j], order[idx]
                    state["dirty"] = True
                    # follow the moved provider with the focus
                    focus[screen] = sel + delta
            elif ch in (ord("n"), curses.KEY_NPAGE):
                if screen < 3:
                    screen += 1
            elif ch in (ord("b"), curses.KEY_PPAGE):
                if screen > (1 if ready else 2):
                    screen -= 1
            elif ch == 27:                      # Esc: back, or quit from 1st
                if screen > (1 if ready else 2):
                    screen -= 1
                elif _confirm_quit(stdscr, state):
                    return "cancel"
            elif ch == ord("p"):
                return "plain"
            elif ch == ord("q"):
                if _confirm_quit(stdscr, state):
                    return "cancel"
            # anything else (incl. KEY_RESIZE): repaint

    def _confirm_quit(stdscr, st) -> bool:
        if not st["dirty"]:
            return True
        ans = _curses_prompt(stdscr, "quit without writing? [y/N]")
        return ans.lower().startswith("y")

    try:
        outcome = curses.wrapper(run)
    except (_RichUnusable, curses.error):
        return None
    except Exception:
        return None
    if outcome == "write":
        return (state, ready)
    return outcome


def _apply_cockpit(state: dict, ready: list[str]) -> int:
    g = _out_glyphs()
    providers_cfg = {p: {"model": state["models"].get(p, ""),
                         "effort": (state["effort"]
                                    if provider_supports_effort(p) else "")}
                     for p in ready}
    changes: list[tuple[str, str]] = []
    cfg_path, backed_up = _write_wizard_config(
        providers_cfg, state["voice"], list(state["route"]), state["lead"],
        changes)
    ex = state["extras"]
    if ex["tmux"]:
        _install_tmux_block(changes)
    if ex["statusline"]:
        _install_statusline(changes)
    if ex["lead"]:
        _install_lead(changes, want_hook=ex["hook"])
    elif ex["hook"]:
        _lead_install_hook(changes)

    print()
    print("  " + _fg("ok", "wrote the map"))
    print("    " + _fg("dim", _tilde(cfg_path)))
    if backed_up:
        print("    " + _fg("dim",
                           f"prior config {g['arrow']} config.toml.bak-teamctl"))
    print()
    print("  from here")
    spawn_prov = state["route"][0] if state["route"] else "claude"
    for cmd_line in ("teamctl providers",
                     f"teamctl spawn reviewer --provider {spawn_prov}",
                     "teamctl settings"):
        print("    " + _fg("primary", cmd_line))
    installed = [("tmux block", "source: tmux source-file ~/.tmux.conf")
                 if ex["tmux"] else None,
                 ("statusline", "teamctl statusline (Claude Code)")
                 if ex["statusline"] else None,
                 ("lead mode", "teamctl lead status")
                 if ex["lead"] else None]
    installed = [x for x in installed if x]
    if installed:
        print()
        for name, note in installed:
            print(f"  + {name:<14} {note}")
        print("  " + _fg("dim", f"revert notes: teamctl lead off {g['dot']} "
                                "backups *.bak-teamctl"))
    return 0


