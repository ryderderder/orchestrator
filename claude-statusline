#!/usr/bin/env python3
"""claude-statusline - a Claude Code `statusLine` command.

Reads the session JSON Claude Code pipes to stdin and prints:

    model · effort · ctx N%

Field sources (see the Claude Code statusLine documentation):
  - model.display_name             -> model name
  - effort.level                   -> reasoning effort; the whole `effort`
                                      object is absent when the current model
                                      doesn't support the effort parameter,
                                      so "?" is shown instead
  - context_window.used_percentage -> context-window-used %; can be null
                                      early in a session (before the first
                                      API response, or right after /compact),
                                      in which case the ctx segment is
                                      omitted rather than a number invented

Stdlib only (json, sys), so it stays well within the tight time budget
status-line commands need to meet.
"""
import json
import sys


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        print("claude · ? · ?")
        return

    model = (data.get("model") or {}).get("display_name") or "?"
    effort = (data.get("effort") or {}).get("level")

    parts = [model, effort or "?"]

    pct = (data.get("context_window") or {}).get("used_percentage")
    if isinstance(pct, (int, float)):
        parts.append(f"ctx {int(pct)}%")
    # else: genuinely unknown -- do not fabricate a number.

    print(" · ".join(parts))


if __name__ == "__main__":
    main()
